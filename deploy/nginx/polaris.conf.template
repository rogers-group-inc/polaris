# deploy/nginx/polaris.conf.template — source of truth for the rendered
# /etc/nginx/conf.d/polaris.conf. The Polaris nginx renderer (see
# src/services/nginxRenderer.ts) substitutes placeholder tokens below from
# the operator's proxyConfig Setting plus a small set of env-derived values
# (server_name from POLARIS_PUBLIC_URL, upstream port from PORT).
#
# Settings managed by the Polaris UI (Server Settings -> Certificates):
# the HTTPS listen port, HTTP/3 (QUIC) on/off, TLS protocols allow-list,
# HSTS, and the Prometheus IP allow-list. The /api docs allow-block is also
# rendered, but from a DIFFERENT source: the `apiDocsConfig` Setting (Server
# Settings -> API Tokens), not proxyConfig — see src/services/
# apiDocsAccessService.ts.
#
# Not managed by the UI: server_name (derived from POLARIS_PUBLIC_URL),
# cert paths (fixed at /etc/polaris-nginx/cert.pem and key.pem), WebSocket
# and proxy timeouts (fixed at 3600s), and upstream targets.
#
# Hand-edits to the rendered /etc/nginx/conf.d/polaris.conf trigger drift
# detection on the next in-app update: the rendered file is NOT clobbered
# and the GUI surfaces a banner until the operator clicks "Adopt managed
# mode." See polaris-deploy -> deployment-updates.md (In-app nginx GUI) for the full flow.
#
# WebSocket upgrade: RFC 6455 WebSockets work only over HTTP/1.1 and HTTP/2.
# The agent's persistent WebSocket and any browser WebSocket negotiate over
# TCP; the HTTP/3 advertisement header doesn't apply to the Upgrade:
# websocket handshake. The map block produces the canonical
# "upgrade-when-asked, close-otherwise" Connection header so a plain GET
# doesn't end up with a stray "Connection: upgrade".

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  # TCP listener — HTTP/2 (with HTTP/1.1 fallback for old clients)
  listen {{HTTPS_PORT}} ssl;
  http2 on;{{QUIC_LISTENER}}

  server_name {{SERVER_NAME}};

  ssl_certificate     /etc/polaris-nginx/cert.pem;
  ssl_certificate_key /etc/polaris-nginx/key.pem;
  ssl_protocols       {{SSL_PROTOCOLS_LIST}};
  # QUIC mandates TLS 1.3 — nginx enforces this automatically on the quic
  # listener; the ssl_protocols directive above only constrains the TCP side.
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;{{SSL_EARLY_DATA}}

  # Don't advertise the nginx version in the Server header. `off` still sends
  # "Server: nginx" (dropping it entirely needs a third-party module) but stops
  # handing a scanner the exact build to match against a CVE list. Static, not
  # a proxyConfig directive -- there is no reason an operator would want the
  # version advertised.
  server_tokens off;{{HSTS_HEADER}}

  # Default proxy headers shared by all locations. The TRUST_PROXY=1 setting
  # in Polaris's .env makes Express honor these so req.ip / req.secure /
  # session-cookie Secure flag all work correctly.
  proxy_set_header Host              $host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Host  $host;
  proxy_set_header Authorization     $http_authorization;
  proxy_http_version 1.1;
  proxy_set_header Upgrade           $http_upgrade;
  proxy_set_header Connection        $connection_upgrade;

  # Generous timeouts for the agent's long-lived WebSocket. The default 60s
  # would tear down idle WS connections every minute. The agent's own
  # heartbeat fires inside this window.
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;

  # Request-body ceiling. nginx defaults to 1m, which is BELOW what Polaris's
  # own handlers accept and silently rejected them at the edge — a 413 whose
  # HTML error page the browser then failed to parse as JSON. The app is the
  # real enforcement layer (express.json is capped at 1mb; each multer route
  # sets its own fileSize — 256k device icons, 1m MIBs/certs, 5m branding
  # logo), so this is defense-in-depth sized just above the largest of them.
  # Raise only if a route's own limit is raised to match.
  client_max_body_size 8m;

  # Main app
  location / {
    proxy_pass http://127.0.0.1:{{POLARIS_PORT}};
  }

  # ─── Database restore upload ──────────────────────────────────────────
  # The one route with no size ceiling of its own, deliberately: a restore
  # takes a pg_dump of the whole database, which scales with the fleet's
  # sample volume (docs/INSTALL.md sizes the DB volume at 50-100 GB+), and
  # backupService streams it to disk rather than buffering it. Any finite
  # number here would be a guess that silently breaks somebody's restore —
  # which is the bug this block exists to fix — so the limit is lifted.
  #
  # Two reasons that's safe rather than an open door:
  #   * proxy_request_buffering off — nginx streams straight to the app
  #     instead of spooling the whole upload into client_body_temp first, so
  #     an oversized body can't fill nginx's temp volume.
  #   * On that route Polaris runs its rate limiter and the
  #     serverSettingsData=fullwrite permission check BEFORE multer touches
  #     the body, so an unauthenticated POST is refused without a byte
  #     reaching disk.
  location = /api/v1/server-settings/database/restore {
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_pass http://127.0.0.1:{{POLARIS_PORT}};
  }

  # ─── Dash wallboard ───────────────────────────────────────────────────
  # The unauthenticated read-only /dash surface, served by its own process
  # (polaris-dash.service, POLARIS_ROLE=dash). Deliberately NO allow/deny
  # here: the operator-facing gates (enable toggle + RFC1918-only source-IP
  # check) live in the dash process itself, driven by the dashConfig Setting.
  # Exact match + trailing-slash prefix so /dashboard-style paths on the main
  # app never match. URI passes through unchanged — the dash app routes
  # /dash/* natively.
  location = /dash {
    proxy_pass http://127.0.0.1:{{DASH_PORT}};
  }

  location /dash/ {
    proxy_pass http://127.0.0.1:{{DASH_PORT}};
  }

  # ─── Metrics endpoints ────────────────────────────────────────────────
  # IP-allowlisted to Prometheus (managed via Server Settings → Certificates).
  # Bearer auth (METRICS_TOKEN) gates the upstream; nginx adds IP allowlisting
  # as the first defense layer.
  location = /metrics {
{{METRICS_ALLOW_BLOCK}}    proxy_pass http://127.0.0.1:{{POLARIS_PORT}}/metrics;
  }

  location = /metrics-monitor-1 {
{{METRICS_ALLOW_BLOCK}}    proxy_pass http://127.0.0.1:9101/metrics;
  }

  location = /metrics-monitor-2 {
{{METRICS_ALLOW_BLOCK}}    proxy_pass http://127.0.0.1:9102/metrics;
  }

  location = /metrics-discovery {
{{METRICS_ALLOW_BLOCK}}    proxy_pass http://127.0.0.1:9110/metrics;
  }

  # ─── API documentation (/api) ─────────────────────────────────────────
  # The unauthenticated developer-docs page. Source-IP scoped from Server
  # Settings → API Tokens (the `apiDocsConfig` Setting — NOT one of the six
  # proxyConfig directives). The app enforces the same scope itself in
  # src/app.ts, so this block is defense in depth only: it is re-rendered on
  # the next apply/update after the setting changes, and the app gate is
  # authoritative whenever the two disagree. Exact match only — /api/ with a
  # trailing slash and /api.html fall through to `location /` and are gated
  # by the app, and /api/v1 API traffic never matches an exact location.
  location = /api {
{{API_DOCS_ALLOW_BLOCK}}    proxy_pass http://127.0.0.1:{{POLARIS_PORT}};
  }
}
