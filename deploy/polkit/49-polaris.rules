// deploy/polkit/49-polaris.rules
// Installed to /etc/polkit-1/rules.d/49-polaris.rules by the deploy/setup-*.sh
// scripts and deploy/ha/setup-rhel-ha.sh, and refreshed by every update
// (deploy/scripts/polaris-update-sync.sh, deploy/update-linux.sh).
//
// The in-app updater (Server Settings -> Maintenance -> Update) runs as the
// polaris user. Its last step restarts the WHOLE process group rather than
// just itself: the web role has already migrated the database, so the monitor
// and discovery units must not keep running the previous release against the
// new schema. It does that by STARTING polaris-update-sync.service, a fixed
// root oneshot that syncs the shipped units and helpers and restarts
// polaris.target.
//
// Without the rule the updater falls back to exiting so that systemd restarts
// the web process alone — the update appears to succeed while the other roles
// stay on the old code. That failure is quiet, which is why the rule ships as
// a file the setup scripts install rather than as a step in the docs.
//
// Scope (business rule 117): the polaris user may start, stop and restart the
// polaris units, start polaris-update-sync.service, and start the four fixed
// instances of polaris-nginx-apply@.service (the Web Server tab's Save & Apply,
// certificate rotation, reload and the listener check — rule 117(o)). Nothing
// else — no other unit, no other instance, no transient unit (systemd-run), no
// daemon-reload, no package management or shutdown. Before rule 117 this
// granted manage-units for EVERY unit, which is the same as root: `systemd-run`
// alone runs any command as root.
//
// The nginx instances replace a sudo of /usr/local/sbin/polaris-nginx-apply
// that could not work from polaris-web: that unit is ProtectSystem=strict, and
// a sudo inherits its read-only /etc, /run and /var. A started unit runs in
// its own namespace. It grants no more than the sudo did — the same root
// wrapper — and less: the wrapper's argument is fixed by the instance name.
polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.systemd1.manage-units" ||
        subject.user != "polaris") {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (unit == "polaris-update-sync.service" && verb == "start") {
        return polkit.Result.YES;
    }
    if (unit == "polaris-update-sync.service") {
        return polkit.Result.NOT_HANDLED;
    }
    if (/^polaris-nginx-apply@(apply-config|rotate-cert|reload|verify-listening-[0-9]{1,5})\.service$/.test(unit) &&
        verb == "start") {
        return polkit.Result.YES;
    }
    if ((unit == "polaris.target" || /^polaris-(web|monitor@[0-9]+|discovery|dash|migrate)\.service$/.test(unit)) &&
        (verb == "start" || verb == "stop" || verb == "restart")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
