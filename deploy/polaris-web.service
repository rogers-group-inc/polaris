[Unit]
Description=Polaris — web / control plane (HTTP, schedulers, migrations)
Documentation=https://github.com/rogers-group-inc/polaris
# The local PostgreSQL dependency is deliberately NOT named in this file. Its
# unit name is a host fact — postgresql-17.service on RHEL/PGDG,
# postgresql.service on Debian/Ubuntu, and nothing at all when the database is
# external — while this file is overwritten verbatim by every update, in-app or
# scripted. Naming a major here meant an update could hand a host a Requires=
# for a unit it does not have, which fails the start.
# The setup scripts write it as a drop-in instead:
#   /etc/systemd/system/<unit>.d/20-postgres.conf
# Drop-ins survive the sync. See deploy/dropins/20-postgres.conf.example and
# docs/INSTALL.md -> "The PostgreSQL dependency".
After=network.target polaris-migrate.service
Requires=polaris-migrate.service
PartOf=polaris.target

[Service]
Type=simple
User=polaris
Group=polaris
WorkingDirectory=/opt/polaris
ExecStart=/usr/bin/node dist/index.js
# Shared env file for every role; the role itself is injected per-unit so it
# stays OUT of .env (which is identical across processes).
EnvironmentFile=/opt/polaris/.env
Environment=POLARIS_ROLE=web
Restart=on-failure
RestartSec=5

# Only the web role binds a port, so only it needs the bind capability.
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
# /run/polaris-nginx-stage is where this process stages a rendered nginx config
# (the in-app updater's managed render and the Web Server tab's Save & Apply)
# and a certificate pair for root to install. Without it strict mode made the
# stage read-only: every update skipped the nginx render as "no-op" and every
# Save & Apply failed. The "-" tolerates a host with no nginx GUI (tmpfiles
# never created the directory). Root's half runs in polaris-nginx-apply@.service,
# outside this sandbox (business rule 117(o)).
ReadWritePaths=/opt/polaris -/run/polaris-nginx-stage
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=polaris-web

[Install]
WantedBy=polaris.target
