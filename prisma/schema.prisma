model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  roleId       String    @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  // Per-user region scope. Empty = unrestricted (matches pre-cutover default
  // so existing accounts aren't suddenly locked out). Effective regions for
  // a session are `union(role.regionTags, user.regionTags, group-derived)` —
  // see GroupMapping + GET /auth/me. Operator-set; group-derived tags are
  // computed at read time and NEVER written here.
  regionTags   String[]  @default([]) @map("region_tags")
  // Per-user free-form ("other") tag scope — a second dimension parallel to
  // regionTags, same union semantics. Operator-set; group-derived tags are
  // never written here.
  otherTags    String[]  @default([]) @map("other_tags")
  authProvider String    @default("local") @map("auth_provider") // "local" | "azure" | "oidc" | "ldap" | "entra-proxy"
  azureOid     String?   @unique @map("azure_oid") // Entra (Azure AD) Object ID — shared by SAML SSO and Entra App Proxy header auth
  // Stable per-provider external identifiers for SSO re-discovery. Mirror the
  // azureOid pattern (narrow nullable-unique) rather than a generic externalId
  // refactor. oidcSubject = OIDC `sub` claim; ldapUid = LDAP objectGUID (hex).
  oidcSubject  String?   @unique @map("oidc_subject")
  ldapUid      String?   @unique @map("ldap_uid")
  // Last-seen normalized IdP group keys from the most recent SSO login. Lets
  // GET /auth/me re-resolve group→tags dynamically without re-contacting the
  // IdP, so a GroupMapping edit takes effect on the user's next page load.
  // Empty for local accounts.
  ssoGroups    String[]  @default([]) @map("sso_groups")
  displayName  String?   @map("display_name")
  email        String?
  lastLogin    DateTime? @map("last_login")

  // TOTP (second-factor) — local accounts only. An enrollment is in progress
  // when totpSecret is set but totpEnabledAt is null; verification of the
  // first 6-digit code finalizes it. Backup codes are stored as argon2id
  // hashes so they're verified the same way passwords are.
  totpSecret      String?   @map("totp_secret")
  totpEnabledAt   DateTime? @map("totp_enabled_at")
  totpBackupCodes String[]  @default([]) @map("totp_backup_codes")

  // How this account prefers to be alerted. "email" (the default — every
  // account has an address long before it has a push subscription), "push", or
  // "any" (both). Stored on the USER, not per browser, because it has to
  // survive a sign-in on a device that has never seen it: the client reads it
  // at boot and enrolls or unsubscribes this browser to match, which is what
  // makes the choice follow the operator across devices.
  //
  // It only ever REMOVES recipients, and only from a notify action that opted
  // in (`respectUserPreference`) inside an action group that actually offers
  // both methods — see business rule 39. An account that never touches it is
  // "email", which is what the pre-feature behaviour already was for every
  // email action; a push action in a single-method group ignores it entirely.
  notificationPreference String @default("email") @map("notification_preference")

  // IANA zone this account wants its times rendered in ("America/Chicago"), or
  // the literal "auto" — the default — meaning "whatever the browser resolves".
  //
  // Stored on the USER rather than per browser for the same reason
  // notificationPreference is: it has to reach a surface that has NO browser.
  // An alert email is composed server-side and handed to SMTP, so before this
  // column the only zone it could name was the SERVER's — which on a
  // UTC-clocked host reads hours off to every operator reading it.
  //
  // "auto" resolves to the browser in the UI and to the server zone in an
  // email, which is exactly the pre-column behaviour: an account that never
  // touches this sees nothing change.
  //
  // Free-form TEXT, not an enum: the tz database gains and retires zones on
  // its own schedule, and a value this build's ICU cannot resolve must
  // degrade to "auto" at READ time rather than fail a render or a send.
  // Validation is normalizeUserTimezone() in userTimezoneService.
  timezone String @default("auto")

  // The zone this account's BROWSER last reported, reported by the client on
  // boot. Never operator-set and never shown as a choice — it exists so that
  // "auto" can mean something on a surface with no browser.
  //
  // Without it "auto" (the default, and what nearly every account will stay
  // on) resolves to the SERVER's zone in an alert email, which on a
  // UTC-clocked host is the exact reading this whole column set exists to
  // stop. With it, an operator who never opens the setting still gets email
  // on their own wall clock.
  //
  // Explicit preference beats this; this beats the server zone. Null until the
  // account signs in on a browser once — an account that only ever receives
  // email (a service account on a distribution list) keeps the server zone,
  // which is the best answer available for it.
  detectedTimezone String? @map("detected_timezone")


  // Flipped true the first time the user actually logs in (lastLogin transitions
  // null → set). Drives the sidebar "new user — review role" notification for
  // admins; cleared globally by Dismiss.
  needsRoleReview Boolean @default(false) @map("needs_role_review")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dashboard         UserDashboard?
  pushSubscriptions PushSubscription[]
  networkScans      NetworkScan[]
  savedDashboards   SavedDashboard[]
  savedTableFilters SavedTableFilter[]
  tableTabs         UserTableTabs[]

  @@index([roleId])
  @@map("users")
}

// Per-user list-page TABS — the operator's own set of open views on one table
// (Assets page tab strip). One row per (user, scope); absent row = the default
// single "All assets" tab, which is materialized client-side and only persisted
// once the operator actually changes something.
//
// Strictly per-user (no sharing, no admin override) and UI-preference only, so
// this is the UserDashboard pattern, not the SavedTableFilter one: no Event
// audit, cascade-delete with the user. The DURABLE, shareable artifact is a
// SavedTableFilter; a tab is a working view, and a tab opened FROM a preset
// keeps only a reference (savedFilterId/Name) for its label + tooltip — editing
// the tab never writes back to the preset, which may belong to someone else.
model UserTableTabs {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String // which table ("assets"); same vocabulary as SavedTableFilter.scope
  tabs      Json // { version: 1, tabs: [{ id, name, state, savedFilterId?, savedFilterName? }], activeId }
  updatedAt DateTime @updatedAt

  @@id([userId, scope])
  @@map("user_table_tabs")
}

// A named, server-persisted snapshot of one list page's table filter + sort
// state (Assets page → Filters ▾ → Save current filters). Server-side rather
// than localStorage precisely because these are shareable: a `public` row is
// offered to every user who can read the scope, a `private` one only to its
// owner.
//
// `scope` is the table the preset belongs to ("assets" today) and maps to the
// RBAC function key that gates it — see SAVED_FILTER_SCOPES in
// services/savedFilterService.ts. `state` is the TableSF prefs shape
// ({ sfFilters, sortKey, sortDir } — public/js/table-sf.js), validated at the
// route layer; column widths/visibility deliberately stay per-browser in
// localStorage since they describe the operator's screen, not the query.
//
// ownerId is SetNull rather than Cascade so a shared preset outlives the
// account that published it (a deleted user's private rows become
// unreachable — they match no viewer — and are dropped alongside the user by
// the users DELETE handler). ownerName is a display snapshot for the same
// reason.
model SavedTableFilter {
  id         String   @id @default(uuid())
  scope      String // which table the preset applies to ("assets")
  name       String
  ownerId    String?
  owner      User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerName  String // username snapshot; survives owner deletion
  visibility String   @default("private") // "private" | "public"
  state      Json // { sfFilters, sortKey, sortDir }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scope, ownerId, name])
  @@index([scope, visibility])
  @@map("saved_table_filters")
}

// Per-user dashboard layout. One row per user; absent row = "empty
// dashboard" (Use the + Widget button to get started). `layout` is the
// JSON blob shape `{ version: 1, widgets: WidgetInstance[] }` validated
// at the route layer by Zod — see src/api/routes/userDashboard.ts.
// Persists server-side so layouts follow operators across browsers and
// devices; localStorage continues to hold ephemeral UI state (chart
// ranges, theme) per the existing convention.
model UserDashboard {
  userId    String   @id @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  layout    Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_dashboards")
}

// A named, shareable snapshot of ONE dashboard — the SavedTableFilter pattern
// applied to the dashboard canvas. `layout` is a single dashboard's column
// stack ({ columns: [...] } — one entry of UserDashboard.layout.dashboards
// minus its id/name), NOT a whole multi-tab layout: a published dashboard is
// one screen, which is what the Dash wallboard shows and what the Dashboard
// page loads as one new tab.
//
// `visibility` decides reach: "private" is offered to its owner alone, "public"
// to every caller who can read the registry — INCLUDING the unauthenticated
// Dash wallboard, which is why publishing is gated a level higher
// (savedDashboards:write) than keeping one. Dash viewers can only ever read:
// that listener is GET-only app-wide, so their own layout stays in localStorage.
//
// ownerId is SetNull (the SavedTableFilter rule, not UserDashboard's Cascade) —
// a public dashboard outlives the account that published it, and `ownerName` is
// the username snapshot that survives it.
model SavedDashboard {
  id         String   @id @default(uuid())
  name       String
  ownerId    String?
  owner      User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerName  String // username snapshot; survives owner deletion
  visibility String   @default("private") // "private" | "public"
  layout     Json // { columns: [ { id, width, widgets: [ { id, type, height, config } ] } ] }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([ownerId, name])
  @@index([visibility])
  @@map("saved_dashboards")
}

// Shared (server-persisted) Device Map topology layout — the hand-tuned node
// positions for one site's topology graph, one row per (site, view). Written
// by operator drags in the topology modal (debounced full-replace PUT, gated
// deviceMap=write); read by everyone via the savedLayouts embed on
// GET /map/sites/:id/topology. `siteId` is the FortiGate Asset's id (the
// topology root). `view` is "flat" or a floor-view key from computeFloorViews
// ("b|<area>|<building>" / "f|<area>|<building>|<floor>") — renaming a:/b:/f:
// location codes changes view keys and orphans that view's row (harmless;
// cascades away with the site). `positions` is { [nodeId]: {x,y} } in pixel
// model coords — the exact shape the browser previously kept in localStorage
// (which remains a per-browser fallback/cache for non-writers). Stale nodeIds
// inside the blob are ignored at render and dropped on the next save.
// Last-write-wins between concurrent editors; updatedBy/updatedAt make a
// future conditional-write possible. Single writer: topologyLayoutService.
model TopologyLayout {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  site      Asset    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  view      String   @default("flat")
  positions Json
  // Operator-stamped restore point: the positions blob as it stood the last
  // time Save was clicked. NULL = this view has never been saved, which is
  // what greys out "Reset to last save" in the Reset menu.
  savedPositions Json?     @map("saved_positions")
  savedBy        String?   @map("saved_by")
  savedAt        DateTime? @map("saved_at")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([siteId, view])
  @@map("topology_layouts")
}

// SHARED Application Map node positions — the appmap.html counterpart of
// TopologyLayout, minus the per-site FK (the Application Map is one global
// graph, not rooted on a firewall Asset). One row per view key ("global" today;
// the column future-proofs sub-views). `positions` = { [nodeId]: {x,y} } where
// nodeIds are the deterministic applicationMapService ids (asset:<id>,
// proc:<assetId>:<b64url(name)>, ip:<ip>, ipgroup:<cidr>) so saved layouts
// survive refresh. Written full-replace by operator drags (PUT
// /application-map/layout, gated applicationMap=write, last-write-wins);
// embedded as `savedLayout` on GET /application-map for every viewer —
// localStorage stays the per-browser fallback for readers. Single writer:
// applicationMapService.
model ApplicationMapLayout {
  id        String   @id @default(uuid())
  view      String   @unique @default("global")
  positions Json
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("application_map_layouts")
}

// Role: identity + permission matrix consulted by the per-route
// `requirePermission(functionKey, level)` middleware. The five seeded
// rows (admin / readonly / networkadmin / assetsadmin / user) reproduce
// the pre-cutover hardcoded UserRole enum's access. `admin` and
// `readonly` are protected (no edit/delete/rename) and hidden from the
// editable list in the UI; the other built-ins are editable. Custom
// roles are operator-created with isBuiltIn = false. Permission shape:
//   { [functionKey]: "none" | "read" | "write" | "fullwrite" }
// See polaris-api-rbac -> auth-rbac.md for the function-key catalogue + the
// access-level ordering. `updatedAt` doubles as the cache-version
// stamp the session snapshot compares against on each request.
// AssetTypeDef: operator-extensible asset-type registry. Replaces the
// pre-cutover `AssetType` enum. The eight historical values
// (server / switch / router / firewall / workstation / printer /
// access_point / other) are seeded `isBuiltIn=true, isProtected=true`
// so existing installs see no behavior change; admins can add custom
// types from the Assets page → Manage asset types slide-over (CRUD on
// /api/v1/asset-types). `name` is the lowercase machine value stored
// on `Asset.assetType`; `label` is the human-facing display string in
// the UI; `description` is optional operator notes.
//
// Built-in behavioral special-cases (FortiGate / switch / access_point
// in dependency tree, fortinetTopology, polling source defaults,
// topology rendering, inferAssetTypeFromOs) only fire for the eight
// `isBuiltIn=true` rows — custom types fall through to "other"-like
// generic behavior. Documented as a known limitation in polaris-domain-model -> assets-core.md.
//
// Built-in rows are NOT renameable (FK rows on Asset.assetType reference
// `name` literally) and NOT deletable. Custom rows are deletable only
// when no Asset.assetType row references them (the service layer counts
// usage before delete; raw FK isn't used because Asset.assetType is a
// String, not a relation — keeps the historical value preserved if a
// type is later renamed via operator action on a non-built-in).
model AssetTypeDef {
  id          String   @id @default(uuid())
  name        String   @unique // machine value: lowercase, alphanumeric + dash/underscore, 2-32 chars
  label       String // human-facing display label, e.g. "Access Point"
  description String?
  isBuiltIn   Boolean  @default(false) @map("is_built_in")
  isProtected Boolean  @default(false) @map("is_protected") // blocks rename/delete; true for all 8 seeds
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Operator-editable inference rules: which discovery-time facts land a
  // device in THIS bucket. A nested AND/OR condition tree —
  // `{ op: "and"|"or"|"none"|"notAll", children: [leaf | group] }` with
  // leaves `{ field, operator, value }` — i.e. the same grammar the
  // automations device filter stores, so the shared PolarisConditionBuilder
  // edits it unchanged. Validated + evaluated by src/utils/assetTypeMatch.ts.
  // Null / empty = this type is never inferred, only assigned by an
  // authoritative source or by hand.
  //
  // The pre-2026-09 flat shape (`{ clauses: [{ field, op, value, negate? }] }`,
  // an ANY-of) is still in this column on every existing install: there is no
  // migration, and `normalizeMatchRules` folds it forward on every READ.
  //
  // Editable on built-in rows too — `isProtected` locks identity (name +
  // label), which code branches on, not the matching that fills the bucket.
  matchRules    Json?    @map("match_rules")
  // Which inference contexts the rules run in: "directory" (AD / Entra /
  // Intune / Arc / FortiGate endpoint OS inference) and "scan" (Network
  // Discovery). Seeded to reproduce the pre-registry hardcoded behavior
  // exactly, which is why it is per-type rather than global.
  matchContexts String[] @default([]) @map("match_contexts")
  // Evaluation order, ascending. Ties break on `name` so the resolver is
  // deterministic across installs.
  matchPriority Int      @default(100) @map("match_priority")

  @@map("asset_type_defs")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  // Badge color as a `#rrggbb` hex string. Drives the role pill color in the
  // sidebar user-badge, the users-table role column, and the Manage Roles
  // list. Null = fall back to the legacy name-keyed badge classes. Built-ins
  // are seeded with their historical colors by the role_color migration.
  color       String?
  permissions Json     @default("{}")
  // Region scope inherited by every user holding this role. Empty =
  // unrestricted. Effective regions for a session are
  // `union(role.regionTags, user.regionTags, group-derived)`.
  regionTags  String[] @default([]) @map("region_tags")
  // Free-form ("other") tag scope inherited by every user holding this role —
  // a second dimension parallel to regionTags, same union semantics.
  otherTags   String[] @default([]) @map("other_tags")
  isBuiltIn   Boolean  @default(false) @map("is_built_in")
  isProtected Boolean  @default(false) @map("is_protected")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  groupMappings GroupMapping[]
  apiTokens     ApiToken[]

  @@map("roles")
}

// GroupMapping: maps an IdP-provided user group to a Polaris role plus region
// and free-form ("other") tags. Populated at SSO/LDAP login: the user's group
// claims are matched against these rows (scoped by `provider`), the matched
// rows' tags union into the user's effective scope, and the HIGHEST-PRIVILEGE
// matched role wins (see rankRole in permissions.ts). A row with a null roleId
// is a tags-only mapping (contributes scope, no role). See groupMappingService.
//
// `groupKey` is the normalized match key: lowercased DN for LDAP, trimmed
// claim value (case-sensitive) for OIDC/SAML. `groupLabel` preserves the
// as-entered form for the admin UI. CRUD is gated on users=fullwrite.
//
// SECURITY: a mapping targeting an admin-equivalent role makes IdP group
// membership a path to Polaris admin (outside the lastAdminEquivalent guard).
// The service emits a warning-level Event when this happens.
model GroupMapping {
  id          String   @id @default(uuid())
  provider    String // "oidc" | "ldap" | "saml"
  groupKey    String   @map("group_key") // normalized match key
  groupLabel  String?  @map("group_label") // as-entered display form
  roleId      String?  @map("role_id") // nullable → tags-only mapping
  role        Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  regionTags  String[] @default([]) @map("region_tags")
  otherTags   String[] @default([]) @map("other_tags")
  enabled     Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, groupKey])
  @@index([provider, enabled])
  @@index([roleId])
  @@map("group_mappings")
}

// One node joining an HA cluster (docs/HA.md).
//
// The Server Settings -> High Availability tab mints a single-use token per
// node and hands the operator a thin bootstrap script carrying it. The node
// runs that script, which REGISTERS here (status pending) and then polls until
// an operator approves it in the UI, at which point it downloads the real
// bundle: the rendered Patroni/etcd config, that member's etcd certificate and
// key, the sync keypair, .env, and the nginx cert+key.
//
// Redeeming the token is therefore not enough to receive anything. That is the
// whole point of the two-step: a leaked token produces a PENDING row naming the
// source address and the host keys it presented, which an operator can look at
// and reject, instead of silently handing over every secret the install has.
model HaEnrollment {
  id   String @id @default(uuid())
  // "primary" | "standby" | "witness". The witness bundle carries etcd material
  // only — no .env, no application secrets, no database credentials.
  role String

  // What the operator TYPED in the tab when minting (the intended member name
  // and cluster address) — kept so the pending row can be compared against what
  // actually connected.
  nodeName String
  nodeAddr String

  // Single-use token, same wire format and argon2id hashing as ManagedAgent's
  // enrollment token (`polaris_<32-char-base62>`, prefix-indexed for lookup).
  // Consumed at REGISTRATION, before approval — so a second attempt with the
  // same token is refused and is itself visible as a rejected registration.
  tokenHash   String
  tokenPrefix String
  expiresAt   DateTime

  // Opaque 32-byte handle the bootstrap script polls with. Separate from the
  // token because the token is spent by then, and a poll must not carry a
  // credential that is still worth stealing.
  requestId String? @unique

  // Lifecycle:
  //   issued    — token minted, nothing has connected yet
  //   pending   — a node registered and is waiting for an operator
  //   approved  — operator said yes; the bundle may be downloaded ONCE
  //   delivered — the bundle was downloaded (terminal, and the audit trail)
  //   rejected  — operator said no (terminal)
  //   expired   — the token aged out before anything registered (terminal)
  status String @default("issued")

  // Recorded at registration so the operator approves against evidence rather
  // than a name the requester chose. The SSH host key fingerprints are also
  // what later lets the reconciler connect with StrictHostKeyChecking=yes
  // instead of trusting on first use.
  registeredFromIp       String?
  registeredNodeName     String?
  sshHostKeyFingerprints String[] @default([])
  registeredAt           DateTime?

  approvedBy  String?
  approvedAt  DateTime?
  rejectedBy  String?
  rejectedAt  DateTime?
  deliveredAt DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tokenPrefix])
  @@index([status])
  @@map("ha_enrollments")
}

model Setting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Tag {
  id       String @id @default(uuid())
  name     String @unique
  category String @default("General")
  color    String @default("#4fc3f7")

  // Optional auto-assignment device filter — the SAME nested AND/OR condition
  // tree the automations device filter and the address book store, so "which
  // devices?" is asked in one language everywhere. NULL = ordinary manual tag.
  // When set, the tag is auto-applied to / removed from matching assets by
  // tagAssignmentService (managed sync, provenance in TagAutoAssignment).
  //
  // An EMPTY tree is "no filter", never "all devices" — unlike Contact, where
  // and([]) is the stored form of an explicit All-devices checkbox. A tag has
  // no such control (just an Auto-assign toggle), so an empty tree could only
  // arrive from a half-built form, and reading it as "every asset" would tag
  // the whole fleet on save. normalizeTagCondition collapses it to NULL.
  assetCondition Json?

  // LEGACY flat criteria, superseded by assetCondition. Still READ — a row
  // written before the cutover keeps matching through the flat predicate until
  // it folds forward — but only one of the two is ever live on a row: a write
  // of the condition nulls this. Readers normalize through `tagFilterOf`, and
  // `criteriaToCondition` is the fold-forward (persisted by the
  // migrateTagFilterShape one-shot, the migrateContactFilterShape precedent).
  // Shape: { version, match: "all", rules: [{ field, op, values[] } |
  // { field:"subnet", op:"inCidr", cidrs[] }] }.
  criteria Json?

  createdAt DateTime @default(now())

  @@index([category])
  @@map("tags")
}

// Provenance for criteria-based tag auto-assignment. One row per (tag, asset)
// pair that tagAssignmentService itself applied. Lets the managed-sync engine
// strip an auto-applied tag when an asset stops matching WITHOUT touching the
// same tag name when an operator added it by hand (no provenance row). No FK to
// Tag/Asset (matches the denormalized tags-by-name design); rows are cleaned by
// the engine on tag delete / criteria clear / asset drift.
model TagAutoAssignment {
  tagId     String
  assetId   String
  createdAt DateTime @default(now())

  @@id([tagId, assetId])
  @@index([assetId])
  @@index([tagId])
  @@map("tag_auto_assignments")
}

// Provenance for map-region tag propagation — the TagAutoAssignment pattern,
// applied to `region:<name>` tags. One row per (region, target) pair that
// mapRegionService itself tagged, so a reconcile can strip a region tag off a
// device that has MOVED out of the polygon without destroying the same tag name
// where an operator attached it by hand (no provenance row = operator-owned,
// left alone forever). Two target kinds because a region propagates to both
// halves: `asset` (in-polygon firewalls, their managed switches/APs, and
// anything addressed out of a subnet an enclosed gate serves) and `subnet`
// (rows whose fortigateDevice is an enclosed gate) — which is also why this
// can't reuse tag_auto_assignments, whose PK is (tagId, assetId).
//
// Keyed by `regionId`, NOT by tag name: a rename changes the tag string but not
// membership, so provenance survives it untouched. Regions live in a Setting
// JSON blob rather than a table, so there is no FK to hang here (and none to
// Asset/Subnet either — same denormalized-tags rationale as TagAutoAssignment).
// Rows are cleaned on region delete and on drift; a row whose target was
// deleted outright is inert and self-heals on the next reconcile.
model RegionTagAssignment {
  regionId   String
  /// "asset" | "subnet"
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@id([regionId, targetType, targetId])
  @@index([regionId])
  @@index([targetId])
  @@map("region_tag_assignments")
}

// Manufacturer alias map. Normalizes inbound manufacturer strings (from OUI
// lookups, discovery, manual entry, MIB upload) to a single canonical form so
// "Fortinet, Inc." and "Fortinet" don't split into two entries everywhere.
// `alias` is stored lowercased+trimmed for case-insensitive match; `canonical`
// is stored as-typed and is what gets written into Asset.manufacturer /
// MibFile.manufacturer at every write site (via the Prisma extension in db.ts).
// Admin-editable from Server Settings → Identification → Manufacturer Aliases.
model ManufacturerAlias {
  id        String   @id @default(uuid())
  alias     String   @unique // lowercased + trimmed input string
  canonical String // canonical manufacturer name (as-typed)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([canonical])
  @@map("manufacturer_aliases")
}

// SNMP MIB modules uploaded by an admin from Server Settings → Identification.
// Used to resolve vendor-specific OIDs during monitoring. MIB text is stored
// inline (MIBs are small — typically <100 KB) and validated on upload by a
// minimal SMI parser that extracts the module name + IMPORTS dependencies.
// Anything that doesn't match the SMI grammar is rejected, which also rules
// out arbitrary text or binary uploads.
//
// scope = "generic" when manufacturer is null (loaded for every probe);
// scope = "device"  when manufacturer is set (loaded only for matching assets).
// model = null means "applies to all models from this manufacturer".
model MibFile {
  id           String   @id @default(uuid())
  filename     String // original upload filename, e.g. "CISCO-PROCESS-MIB.txt"
  moduleName   String // parsed from "<NAME> DEFINITIONS ::= BEGIN"
  manufacturer String? // null = generic/shared MIB
  model        String? // null = applies to all models from manufacturer
  // assetId pins this MIB to ONE specific asset — the most-specific scope
  // tier in the per-asset resolution priority (asset → model → manufacturer
  // → generic → seed). Used when one device of a fleet runs a different
  // firmware that exposes a vendor-specific symbol the rest doesn't.
  assetId      String?
  asset        Asset?   @relation("MibFilesOnAsset", fields: [assetId], references: [id], onDelete: SetNull)
  contents     String   @db.Text // raw MIB text
  imports      String[] @default([]) // module names referenced via IMPORTS ... FROM
  size         Int // byte length of contents
  notes        String?  @db.Text
  uploadedBy   String?
  uploadedAt   DateTime @default(now())

  profileMetricDefaults  ManufacturerProfileMetric[]         @relation("ManufacturerProfileMetricDefaultMib")
  profileMetricOverrides ManufacturerProfileMetricOverride[] @relation("ManufacturerProfileMetricOverrideMib")
  customWidgets          ManufacturerCustomWidget[]          @relation("ManufacturerCustomWidgetMib")

  @@unique([manufacturer, model, moduleName])
  @@index([manufacturer, model])
  @@index([moduleName])
  @@index([assetId])
  @@map("mib_files")
}

// Operator-editable per-manufacturer telemetry profile. Replaces the
// hardcoded VENDOR_TELEMETRY_PROFILES constant at runtime — discovery seeds
// these rows from the constant on first boot (idempotent), and the
// monitoring path resolves through the DB rows from then on. The constant
// stays as a fresh-install fallback for hosts whose seeding hasn't run yet.
//
// Match key is the alias-canonicalized manufacturer string; only one row
// per canonical manufacturer. Per-model exceptions (e.g. Fortinet's
// FortiSwitch / FortiAP variants under the Fortinet profile) live as
// `ManufacturerProfileMetricOverride` rows nested under each metric row.
model ManufacturerProfile {
  id           String   @id @default(uuid())
  manufacturer String   @unique // canonical form via ManufacturerAlias map
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  metrics ManufacturerProfileMetric[]
  widgets ManufacturerCustomWidget[]

  @@map("manufacturer_profiles")
}

// One row per System-tab metric the profile owns (cpu / memory / temperature
// / interfaces / lldp / storage / wirelessStations). `defaultSymbol` +
// `defaultMibId` describe the symbol Polaris walks for this metric on every
// asset that resolves through this profile, unless a per-model override row
// (`ManufacturerProfileMetricOverride`) matches `Asset.model` first.
//
// Null defaultSymbol = use the built-in seed for this metric (i.e. the
// hardcoded VENDOR_TELEMETRY_PROFILES entry's value for this manufacturer);
// null defaultMibId = built-in seed scope. `defaultType` is "scalar" or
// "table" and is what `collectTelemetrySnmp` uses to decide between GET .0
// and walk-the-subtree. `defaultTransform` is the optional value-transform
// applied after the SNMP value lands (Celsius↔Fahrenheit, bytes→MB, etc.).
model ManufacturerProfileMetric {
  id               String              @id @default(uuid())
  profileId        String
  profile          ManufacturerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  metricKey        String // "cpu" | "memory" | "temperature" | "interfaces" | "lldp" | "storage" | "wirelessStations"
  defaultSymbol    String?
  defaultMibId     String?
  defaultMib       MibFile?            @relation("ManufacturerProfileMetricDefaultMib", fields: [defaultMibId], references: [id], onDelete: SetNull)
  // Operator-pinned standard MIB key (e.g. "std:lldp", "std:host-resources").
  // Mutually exclusive with defaultMibId in the UI — picking a standard MIB
  // sets this and clears defaultMibId, and vice versa. Display-only at probe
  // time: the resolver still walks asset → model → vendor → generic → seed.
  // Lets the Manufacturer Profile table show a meaningful MIB label for
  // metrics whose symbol comes from a built-in seed instead of "seed".
  defaultMibStdKey String?
  defaultType      String              @default("scalar") // "scalar" | "double_scalar" | "table"
  // Unary transforms (TransformKind, e.g. celsius_to_fahrenheit, bytes_to_gb)
  // when defaultType="scalar"; binary combiners (CombinerKind, e.g.
  // a_over_b_as_percent) when defaultType="double_scalar"; null on
  // defaultType="table". Validated against the registries in
  // src/utils/symbolTransforms.ts at the service layer.
  defaultTransform String?
  // Second OID for the double_scalar shape. Populated when defaultType=
  // "double_scalar"; the combiner in defaultTransform is applied as
  // f(defaultSymbol, defaultSymbolB) at probe time. Null on scalar / table.
  defaultSymbolB   String?
  // DEPRECATED — superseded by the generic double_scalar shape carried in
  // defaultType + defaultTransform + defaultSymbolB. Kept for one release as
  // a rollback safety net for the data migration that copied the legacy
  // memory-only `composition` blob into the new columns. To be dropped in a
  // follow-up migration once production has settled. New writes must NOT
  // populate this column; new reads ignore it.
  composition      Json?

  overrides ManufacturerProfileMetricOverride[]

  @@unique([profileId, metricKey])
  @@index([defaultMibId])
  @@map("manufacturer_profile_metrics")
}

// Per-model exception inside a manufacturer's metric row. Evaluated in
// `order` (lower wins); first override whose `modelPattern` regex matches
// `Asset.model` is the effective symbol/mib/type/transform for that asset's
// SNMP walk. No matches = the parent metric row's default* is used.
model ManufacturerProfileMetricOverride {
  id           String                    @id @default(uuid())
  metricRowId  String
  metricRow    ManufacturerProfileMetric @relation(fields: [metricRowId], references: [id], onDelete: Cascade)
  modelPattern String // regex tested against Asset.model
  symbol       String
  mibId        String?
  mib          MibFile?                  @relation("ManufacturerProfileMetricOverrideMib", fields: [mibId], references: [id], onDelete: SetNull)
  // Same display-only standard-MIB hint as the parent metric row. See
  // ManufacturerProfileMetric.defaultMibStdKey.
  mibStdKey    String?
  type         String                    @default("scalar") // "scalar" | "double_scalar" | "table"
  transform    String? // TransformKind on scalar; CombinerKind on double_scalar; null on table
  // Second OID for the double_scalar shape — mirrors the parent metric row's
  // defaultSymbolB. The combiner in `transform` is applied as
  // f(symbol, symbolB) at probe time. Null on scalar / table.
  symbolB      String?
  order        Int                       @default(0)
  // DEPRECATED — see ManufacturerProfileMetric.composition for the rationale
  // and removal plan. New writes must NOT populate this column.
  composition  Json?

  @@index([metricRowId, order])
  @@index([mibId])
  @@map("manufacturer_profile_metric_overrides")
}

// Operator-defined custom widget that Slice 7's Custom MIB tab on the
// asset details modal will render for every asset whose alias-normalized
// manufacturer matches this profile (and whose model satisfies the
// optional `modelPattern` gate). The widget walks `symbol` against `mibId`
// at the cadence dispatcher's `customWidget` interval and renders the
// result per `widgetType` (gauge / line / table). `displayOptions` is the
// type-specific blob (gauge min/max + thresholds, line aggregate/unit,
// table column list / decode rules).
model ManufacturerCustomWidget {
  id             String              @id @default(uuid())
  profileId      String
  profile        ManufacturerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name           String // operator-set label, e.g. "Connected Wireless Clients"
  // symbol + mibId are SNMP concepts and are NULL on an "http" widget, which
  // names a request rather than an OID. They remain required for every other
  // widgetType — enforced in manufacturerProfileService rather than by the
  // column, because the requirement is per-widgetType and a DB constraint
  // cannot express that.
  symbol         String?
  mibId          String?
  mib            MibFile?            @relation("ManufacturerCustomWidgetMib", fields: [mibId], references: [id])
  type           String              @default("scalar") // "scalar" | "table" (auto-detected; operator can override)
  widgetType     String // "gauge" | "line" | "table" | "state" | "http"
  // -- HTTP checks (widgetType = "http") -----------------------------------
  // The check DEFINITION (useHttps / port / path / expectStatus / expectBody /
  // matchMode / caseSensitive / failOnMismatch / verifyTls), validated by
  // credentialService.validateHttpCheckDefinition -- the same function the Test
  // Connection flow uses, so a check cannot pass a test and then be rejected on
  // save. It lives here rather than on a Credential because a check varies by
  // vendor AND MODEL while a login varies by vendor or site; sharing one row
  // made a second path need a second copy of the same password.
  httpCheck      Json?
  // The `http`-typed Credential supplying authentication. NULL = unauthenticated,
  // which is how an open health endpoint is expressed (the credential type has
  // no "none" mode for exactly this reason). SetNull rather than Cascade: losing
  // a credential must not silently delete the check that used it -- the widget
  // should survive and fail loudly until a new credential is chosen.
  credentialId   String?
  credential     Credential?         @relation("ManufacturerCustomWidgetCredential", fields: [credentialId], references: [id], onDelete: SetNull)
  transform      String?
  displayOptions Json                @default("{}")
  order          Int                 @default(0)
  modelPattern   String? // optional per-model gating
  // ── State probes (widgetType = "state") ───────────────────────────────────
  // A status-shaped OID (alarm bit, PSU present, fan-tray OK) rather than a
  // gauge. `stateMap` declares how a raw reading becomes true/false and what to
  // call each side — see src/utils/stateProbes.ts, which is the single source of
  // truth for the evaluation. The mapping is DECLARED rather than assumed
  // because vendors disagree on polarity (TruthValue's true(1)/false(2) inverts
  // a plain alarm bit) and some publish strings, so "value >= 1" is wrong about
  // as often as it's right. Null on gauge/line/table widgets.
  stateMap       Json?
  // Optional sibling MIB symbol supplying each table row's NAME, joined to the
  // value walk on the shared OID index suffix (fgHwSensorEntName beside
  // fgHwSensorEntAlarm). Without it a table probe's rows are only nameable by
  // bare index, which differs per model — so an alert would read "row .14 is in
  // Alarm". Ignored on scalar probes.
  labelSymbol    String?
  createdBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([profileId, order])
  @@index([mibId])
  @@map("manufacturer_custom_widgets")
}

model Conflict {
  id         String @id @default(uuid())
  entityType String @default("reservation") // "reservation" | "asset" | "subnet"

  // Reservation conflicts (discovery proposes changes to a manually-created reservation)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  // Asset conflicts (discovery proposes an asset that collides by hostname with an existing untagged asset)
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Subnet conflicts. One flavour so far: `chassis-replaced` — the gate
  // serving this subnet answered with a serial that is neither the stored one
  // nor any member of its cluster, i.e. the physical FortiGate was swapped.
  // The row points at the LIVE subnet (now re-pointed at the new chassis); the
  // old chassis's subnet + reservations are in the archive tables, and
  // `proposedSubnetFields` carries the diff payload the resolution UI reads.
  // Business rule 41.
  subnetId String?
  subnet   Subnet? @relation(fields: [subnetId], references: [id], onDelete: Cascade)

  integrationId String?

  // Reservation-conflict proposed values
  proposedHostname   String?
  proposedOwner      String?
  proposedProjectRef String?
  proposedNotes      String? @db.Text
  proposedSourceType String? // Required for reservations, null for assets

  // Asset-conflict proposed values
  proposedDeviceId      String? // Entra deviceId — used to de-dupe conflicts across discovery runs
  proposedAssetFields   Json? // Full Entra/Intune snapshot: hostname, serial, mac, model, manufacturer, os, osVersion, assignedTo, chassisType, complianceState, trustType
  // Snapshot of the existing (collision-target) asset captured when the
  // conflict was raised, so the resolved card shows what the asset looked
  // like at conflict time — not the post-merge live row. Refreshed on each
  // discovery run while the conflict is pending; frozen once resolved.
  // Null for conflicts predating this column (UI falls back to the live asset).
  existingAssetSnapshot Json?

  // Subnet-conflict payload (entityType="subnet"). Shape for `chassis-replaced`:
  //   collisionReason  "chassis-replaced"
  //   cidr, blockId
  //   oldSerial / newSerial, oldDeviceName / newDeviceName
  //   archivedSubnetId — the ArchivedSubnet row holding the old chassis's state
  //   lines[]          — one entry per address across BOTH chassis, each with
  //                      `ip`, `verdict` ("only-old" | "only-new" | "differs" |
  //                      "same"), `old` and `new` reservation snapshots, and
  //                      `migratable` (false for device-owned vip /
  //                      interface_ip rows, which the new gate's own config
  //                      states).
  // A snapshot, not a live join: the old chassis's rows are gone from
  // `reservations` by the time this is read, and the archive is the system of
  // record behind it.
  proposedSubnetFields Json?

  conflictFields String[]

  status     ConflictStatus @default(pending)
  resolvedBy String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId])
  @@index([assetId])
  @@index([subnetId])
  @@index([entityType])
  @@index([status])
  @@index([integrationId])
  @@index([proposedDeviceId])
  @@map("conflicts")
}

// ─── Subnet archive (business rule 41) ────────────────────────────────────────
//
// A retired subnet and the reservations it held, kept for review after the
// live row is gone. Two things make this a separate table rather than a
// `deprecated` status:
//
//   1. `@@unique([blockId, cidr])` — a retired row still occupies its CIDR, so
//      a replacement gate reporting the same address space could never be
//      recorded. Discovery skipped those subnets on every run with a
//      self-overlap message, and every lease, DHCP reservation, VIP and
//      interface IP inside them was dropped with them.
//   2. Locked by construction. An archived reservation is not in `reservations`
//      at all, so no write path can reach it — no guard to add at ~50 call
//      sites, and no future writer to forget one.
//
// Deliberately NOT a retention entity: nothing prunes it. Subnets number in
// the thousands at most, so keeping every retirement forever costs nothing.
model ArchivedSubnet {
  id String @id @default(uuid())

  // The live row this was archived from. Kept as a plain string, not an FK —
  // the live row is deleted as part of archiving, so there is nothing to point
  // at. Events written before the archive still cite this id.
  originalSubnetId String

  // Block identity is DENORMALIZED, with no FK, deliberately. `Subnet.block`
  // is `onDelete: Cascade`, so an FK here would let deleting a block erase the
  // archive — the exact opposite of what it is for. Same reasoning as
  // `DirectoryContactSource.integrationId`.
  blockId   String
  blockCidr String
  blockName String

  cidr    String
  name    String
  purpose String?      @db.Text
  status  SubnetStatus
  vlan    Int?
  tags    String[]     @default([])

  // Provenance as it stood, also FK-free for the reason above.
  discoveredBy    String?
  integrationName String?
  fortigateDevice String?
  fortigateSerial String?
  createdBy       String?

  lastDiscoveredAt  DateTime?
  originalCreatedAt DateTime
  originalUpdatedAt DateTime

  archivedAt    DateTime @default(now())
  archivedBy    String?
  // Why it was retired: "chassis-replaced" (business rule 41's conflict path)
  // or "operator" (the explicit Archive action).
  archiveReason String

  reservations ArchivedReservation[]

  @@index([originalSubnetId])
  @@index([cidr])
  @@index([blockId])
  @@index([archivedAt])
  @@index([fortigateSerial])
  @@map("archived_subnets")
}

// One reservation as it stood when its subnet was archived. Cascades with the
// ArchivedSubnet — a cascade INSIDE the archive is fine; what must never
// cascade is anything from the live tables into it.
model ArchivedReservation {
  id               String         @id @default(uuid())
  archivedSubnetId String
  archivedSubnet   ArchivedSubnet @relation(fields: [archivedSubnetId], references: [id], onDelete: Cascade)

  originalReservationId String

  ipAddress   String?
  hostname    String?
  owner       String?
  projectRef  String?
  expiresAt   DateTime?
  notes       String?               @db.Text
  status      ReservationStatus
  sourceType  ReservationSourceType
  createdBy   String?
  macAddress  String?
  dhcpBinding String?
  vipInfo     Json?

  // Push STATE is recorded; the push POINTERS (pushedScopeId / pushedEntryId /
  // pushedToId) deliberately are NOT. They address a DHCP entry inside a scope
  // on a chassis that no longer exists, and carrying them forward would let a
  // future restore or unpush path aim a delete at whatever now occupies those
  // ids on a different box. The state is what a reviewer needs; the pointers
  // are a loaded gun. Same posture as `AssetPhysicalEntity.ifName`, which is
  // on the model and deliberately never populated.
  pushStatus String?
  pushedAt   DateTime?

  lastSeenLeased DateTime?
  lastSeenArp    DateTime?

  originalCreatedAt DateTime
  originalUpdatedAt DateTime

  @@index([archivedSubnetId])
  @@index([originalReservationId])
  @@index([ipAddress])
  @@map("archived_reservations")
}

// Sighting log: every (asset, FortiGate) pair where the FortiGate has handed
// out a DHCP lease/reservation to the asset, attributed an interface IP, or
// owned a VIP that points at the asset's IP. Populated during the FMG /
// FortiGate discovery sync — only DHCP-level evidence is recorded (transit
// sightings via monitor-system-info are intentionally excluded). Drives the
// quarantine fan-out: pushing a quarantine on an asset writes the asset's
// MACs to every FortiGate in this list whose lastSeen falls within the
// configured `quarantine.sightingMaxAgeDays` setting.
model AssetFortigateSighting {
  id              String       @id @default(uuid())
  assetId         String
  asset           Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  integrationId   String?
  integration     Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  fortigateDevice String // matches Subnet.fortigateDevice / Asset.learnedLocation
  source          String // "dhcp_lease" | "dhcp_reservation" | "interface_ip" | "vip"
  ipAddress       String? // IP last seen on this FortiGate (lease/reservation IP); nullable for rows recorded before this column existed
  firstSeen       DateTime     @default(now())
  lastSeen        DateTime     @default(now())

  @@unique([assetId, fortigateDevice])
  @@index([assetId])
  @@index([assetId, lastSeen])
  @@index([integrationId])
  @@index([fortigateDevice])
  // "which gate has seen THIS address" -- the Add Asset form's IP
  // cross-reference (services/ipContextService.ts). Every other consumer comes
  // in through assetId.
  @@index([ipAddress])
  @@map("asset_fortigate_sightings")
}

// Bearer-token authentication for external callers (e.g. SIEM systems) that
// need to invoke specific Polaris endpoints without a UI session. Each token
// is bound to a Role at mint time (role cutover migration 20260706000000 —
// replaced the prior fixed scope strings). requirePermission resolves the
// token's role matrix exactly like a session role snapshot, so the token can
// reach whatever the chosen role grants and nothing else. Admins pick (or
// purpose-build) a minimal role; binding a token to an admin-equivalent role
// logs a warning Event, since a leaked token would then be a full-control
// credential.
//
// The raw token is only ever shown once at creation; tokenHash is argon2id
// of the raw token, and tokenPrefix stores the first 8 chars for display in
// the management UI ("polaris_xxxxxxxx…"). revokedAt soft-deletes the row
// (preferred over hard-delete so audit history points at a real id even
// after revocation). Optional expiresAt enforces server-side expiry.
model ApiToken {
  id             String    @id @default(uuid())
  name           String    @unique
  tokenHash      String // argon2id hash of the raw token
  tokenPrefix    String // first 8 chars of the raw token for UI display
  // Role whose permission matrix this token acts with. Restrict: a role
  // referenced by any token cannot be deleted (roleService refuses with a
  // friendly 409 before the FK would error).
  roleId         String    @map("role_id")
  role           Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  // Integration ids this token may operate against. Required + non-empty when
  // the bound role grants assetsQuarantine ≥ write; ignored otherwise. Tokens
  // with this set will only quarantine/release/verify against sightings whose
  // originating integration id is in this list — so a token minted for "Site
  // A FortiGate" can never accidentally push to Site B's gateway.
  integrationIds String[]  @default([])
  createdBy      String // username of the admin who minted the token
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  lastUsedIp     String?
  revokedAt      DateTime?
  revokedBy      String?

  @@index([revokedAt])
  @@index([expiresAt])
  @@index([roleId])
  @@map("api_tokens")
}

// Per-discovery-source view of an asset. The unified `Asset` row remains the
// stable id everything else FKs to (monitoring, ip-history, sightings,
// quarantine); AssetSource rows hang off Asset and capture what each source
// independently said about the device. The merged display fields on Asset are
// a projection across these rows — phase 1 just shadow-writes them from the
// existing assetTag / "sid:" / "ad-guid:" tags so the table is populated and
// shaped before discovery cutover (phase 2).
//
// Phase-1 sourceKind values: "entra" | "ad" | "fortigate-firewall" | "manual"
// Future values (phase 2 cutover): "intune" | "fortiswitch" | "fortiap"
//                                  | "fortigate-dhcp-host" | ...
//
// `(sourceKind, externalId)` is the natural dedupe key — entra.deviceId,
// ad.objectGUID, fortigate-firewall.serial. Manual sources use the Asset.id
// itself as externalId so they don't collide.
model AssetSource {
  id      String @id @default(uuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  sourceKind String
  externalId String

  // Originating integration. Null for "manual" rows and for phase-1 inferred
  // rows (e.g. an AD source recovered from an "ad-guid:" tag where the AD
  // integration linkage is no longer reconstructable).
  integrationId String?
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  // Source-shaped raw observation blob — see polaris-monitoring-discovery -> discovery-fortinet.md "Per-source observed
  // shapes." Stays as the source said it; the Asset row is the merged
  // projection across all sources.
  observed Json @default("{}")

  // True when synthesized by the phase-1 backfill from legacy assetTag /
  // "sid:" / "ad-guid:" tags rather than discovered fresh. Cleared when the
  // next real discovery run replaces the row with truth.
  inferred Boolean @default(false)

  // syncedAt  = last successful refresh from this source (drives staleness)
  // lastSeen  = last time this source reported the device as active
  // firstSeen = when Polaris first recorded this source
  syncedAt  DateTime?
  firstSeen DateTime  @default(now())
  lastSeen  DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceKind, externalId])
  @@index([assetId])
  @@index([sourceKind])
  @@index([integrationId])
  @@map("asset_sources")
}

// Persistent parent→child edges of the Fortinet infrastructure dependency
// DAG. Drives dependency-aware monitoring suppression: when ALL of an
// asset's effective parents are confirmed down (or themselves suppressed),
// telemetry / systemInfo / fastFiltered cadences pause and the
// response-time probe slows to 2× the resolved interval. Multi-parent rows
// model MCLAG / dual-homed switches; "all-down" semantics mean a redundant
// uplink keeps an asset polling normally.
//
// Resolution rule: if any source="override" rows exist for an asset, those
// are its effective parents and the computed set is ignored; otherwise the
// source="computed" set is used. Operators get full control (admin-only
// override endpoints) without losing the computed audit trail.
//
// The recomputeDependencyTree helper rebuilds the source="computed" rows
// at end of every FMG/FortiGate discovery cycle (Phase 2d in
// syncDhcpSubnets, plus the standalone FortiGate path). source="override"
// rows are operator-managed and never touched by the recompute.
//
// source="vcenter" rows are written by syncVcenterDevices (delete-replace
// scoped to its own source value per run): VM→ESXi-host edges, vMotion-safe —
// a VM on a clustered host gets one edge per cluster-member host, so the
// all-down multi-parent semantics suppress it only when the entire cluster
// is dark. The Fortinet recompute never touches them (its deleteMany filters
// source="computed"); the read-time resolver buckets any non-"override"
// source as computed, so vcenter edges feed suppression with no special
// handling and still yield to operator overrides.
//
// detectedVia distinguishes the signal that produced a computed row:
//   - "controller" — Asset.fortinetTopology.controllerFortigate / parentSwitch
//   - "interface"  — interfaceTopologyService inferred edge (FortiLink /
//                    MCLAG aggregate naming)
//   - "lldp"       — AssetLldpNeighbor.matchedAssetId fallback
//   - "manual"     — operator override (only present on source="override")
//   - "hypervisor" — vCenter VM→host placement (only on source="vcenter")
model AssetDependencyParent {
  id            String @id @default(uuid())
  assetId       String
  asset         Asset  @relation("AssetDependencyChild", fields: [assetId], references: [id], onDelete: Cascade)
  parentAssetId String
  parent        Asset  @relation("AssetDependencyParent", fields: [parentAssetId], references: [id], onDelete: Cascade)

  source      String // "computed" | "override" | "vcenter"
  detectedVia String // "controller" | "interface" | "lldp" | "manual" | "hypervisor"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Same (child, parent) pair may exist in BOTH "computed" and "override"
  // form simultaneously — a deliberate override that pins the same parent the
  // recompute would have picked anyway should still register on the
  // override-takes-precedence rule. Including source in the unique key lets
  // both rows coexist; the read-time resolver in dependencyTreeService groups
  // by source and applies override-wins.
  @@unique([assetId, parentAssetId, source])
  @@index([assetId])
  @@index([parentAssetId])
  @@index([source])
  @@map("asset_dependency_parents")
}

// Operator-uploaded device icons used by the Device Map's topology graph
// (and potentially other render surfaces in the future) to represent
// specific hardware models or asset types. Resolution priority at render
// time is most-specific-wins:
//   1. scope="model" key="<manufacturer>/<model>" — e.g. "Fortinet/FortiGate-91G"
//   2. scope="model" key="<model>"                — manufacturer-agnostic match
//   3. scope="type"  key=<assetType>              — type-level fallback
//   4. no row → frontend falls back to the default node style.
//
// Image bytes are stored inline (one-request fetch via the dedicated
// /device-icons/:id/image endpoint, which serves the raw bytes with
// proper Content-Type + Cache-Control). Hard cap on size is enforced at
// upload time in deviceIconService — keeps backups bounded.
model DeviceIcon {
  id         String   @id @default(uuid())
  scope      String
  key        String
  filename   String
  mimeType   String
  data       Bytes
  size       Int
  uploadedBy String?
  uploadedAt DateTime @default(now())

  @@unique([scope, key])
  @@index([scope])
  @@map("device_icons")
}

// Polaris Agent installation record. One row per (asset × agent install).
// Independent of AssetSource — installing an agent doesn't change discovery
// identity, it just adds a new polling transport (`responseTimePolling="agent"`
// etc.) that the agent itself satisfies by pushing samples back to Polaris.
//
// Lifecycle (drives `installStatus`):
//   Install:    pending → uploading → enrolling → active
//                                         ↘ failed (install_failed event, row stays for retry)
//   Uninstall:  active → uninstalling → (row hard-deleted on success)
//                              ↘ uninstall_failed (row stays; operator retries or force-removes)
//   Force:      any → (row hard-deleted, force_removed event)
//   Reinstall:  uninstall + install run back-to-back; old row deleted, new row created
//
// Two token columns: `enrollmentToken*` is one-shot (10-min TTL) and NULLed
// the moment the agent POSTs /api/v1/agents/enroll successfully; `bearer*` is
// the long-lived per-agent token issued at that moment, used for every
// subsequent /samples / /config / /heartbeat call and for the outbound
// WebSocket. Both stored as argon2id hashes + a short prefix for indexed
// lookup, matching the ApiToken pattern. The bearer is bound to this asset
// via the @unique([assetId]) constraint — defense against stolen-bearer
// cross-asset reuse (handler stamps the bearer's assetId, ignoring the body).
//
// `serverCertFingerprint` is the SHA-256 of the running Polaris HTTPS leaf
// cert at install time, captured by agentInstallService and baked into the
// host's agent.conf. The agent's TLS client uses this as a pin — it does NOT
// trust system roots. POST /enroll cross-checks: client reports the cert it
// observed, server matches against this column.
model ManagedAgent {
  id      String @id @default(uuid())
  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  osPlatform     String // "linux" | "darwin" | "windows"
  arch           String // "amd64" | "arm64"
  agentVersion   String? // semver reported on enroll; null until first enroll
  // Effective-capability bitmask the agent process actually holds, as the raw
  // CapEff hex from its /proc/self/status, reported on heartbeat (agent
  // ≥0.17.1, Linux only — null for Windows/macOS agents and pre-0.17.1
  // binaries). This is the VERIFIED privilege state; `privilegeTier` is only
  // what the operator requested at install kickoff. Decoded server-side by
  // utils/capEff.decodeCapEff — the ptrace tier is healthy only when BOTH
  // CAP_SYS_PTRACE (bit 19) and CAP_DAC_READ_SEARCH (bit 2) are set; a
  // SYS_PTRACE-only mask means the unit predates the DAC fix and the agent
  // collects no Application Map connections until reinstalled.
  reportedCapEff String?
  installedBy    String // username of operator who clicked Install
  installedAt    DateTime @default(now())

  // Credential used at install time. Stored so the default DELETE path
  // (remote uninstall via the same SSH/WinRM creds) doesn't have to ask
  // the operator to re-pick it. Cleared on credential deletion via
  // SetNull so an orphaned ManagedAgent doesn't block the credential's
  // removal; the operator falls back to ?force=true in that case.
  installCredentialId String?
  installCredential   Credential? @relation("AgentInstallCredential", fields: [installCredentialId], references: [id], onDelete: SetNull)

  // Transport used to run the remote install/upgrade/uninstall scripts.
  // "ssh"   — Linux/macOS hosts (only path), and Windows hosts with OpenSSH
  //           Server enabled. Polaris opens an SSH exec channel and runs
  //           the platform-specific installer (bash on linux/darwin,
  //           powershell.exe -EncodedCommand on windows).
  // "winrm" — Windows hosts using the existing PSRP-over-HTTP(S) path.
  // Persisted so retry / uninstall / upgrade can replay the same transport
  // without asking the operator to re-pick it.
  installTransport String @default("ssh") // "ssh" | "winrm"

  // Curated install-method variant chosen at deploy time (catalog id in
  // src/services/agentInstallScripts.ts, e.g. "linux-systemd"). NULL = the
  // per-OS default (pre-picker installs + auto-deploy). Persisted so
  // retry/uninstall/upgrade replay the same method, and it's auditable.
  // OS-locked at write time by resolveInstallScriptId (a windows-* variant
  // can never land on a linux row).
  installScriptId String?

  // Linux install privilege tier (operator choice at install/reinstall time):
  //   "unprivileged" (default) — hardened DynamicUser unit, no capabilities.
  //   "ptrace"                 — unprivileged + AmbientCapabilities=CAP_SYS_PTRACE,
  //                              which lets the agent read other users'
  //                              /proc/<pid>/fd for Application Map connection→PID
  //                              attribution WITHOUT full root. Credential-theft
  //                              class (can read any process's memory) — granted
  //                              with an explicit operator warning.
  //   "root"                   — LEGACY only. Full root, no sandbox. New installs
  //                              can no longer select this (the full-root tier was
  //                              retired with service control); existing root
  //                              agents keep this value until reinstalled, which
  //                              downgrades them to unprivileged/ptrace.
  // On Windows the agent always runs as LocalSystem, so this is not consulted.
  privilegeTier String @default("unprivileged")

  installStatus String  @default("pending") // see lifecycle comment above
  installError  String? // captured stderr / exception message on failure

  // One-shot enrollment token. NULLed atomically when /enroll succeeds.
  enrollmentTokenHash   String?
  enrollmentTokenPrefix String?
  enrollmentExpiresAt   DateTime?

  // Long-lived bearer (argon2id, prefix-indexed). Wire format same as
  // ApiToken: `polaris_<32-char-base62>`. Bound to assetId at issuance.
  bearerHash      String?
  bearerPrefix    String?
  bearerIssuedAt  DateTime?
  bearerRevokedAt DateTime?

  lastSeenAt       DateTime?
  lastSeenIp       String?
  wsConnectedAt    DateTime?
  wsDisconnectedAt DateTime?

  // SHA-256 of the leaf cert as `sha256:<hex>`. Pinned at install; checked
  // server-side at enrollment, client-side on every subsequent TLS handshake.
  // CANONICAL pin — the one the agent enrolled against most recently. After a
  // successful staged-rotation, the operator "promotes" a staged pin into this
  // column and clears `additionalServerCertFingerprints`.
  serverCertFingerprint String

  // STAGED pins. Empty in steady state. Populated when an operator stages a
  // new cert pin via the Maintenance card before rotating the server cert —
  // /config push then propagates the union to every agent's agent.conf, so
  // when the cert actually rotates, every agent already trusts the new
  // fingerprint and enrollment / heartbeat / WS continue without re-install.
  // After the operator confirms uptake (every agent has heartbeated with the
  // new pin), the rotation finishes by promoting the new pin to
  // serverCertFingerprint and clearing this array. See cross-cutting/polaris-agent
  // "Cert pin rotation" in polaris-agent -> cross-cutting-polaris-agent.md.
  additionalServerCertFingerprints String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([installStatus])
  @@index([bearerPrefix])
  @@index([enrollmentTokenPrefix])
  @@map("managed_agents")
}

// Operator-issued process-control commands (Phase 4). One row per Stop/Start/
// Restart request against a service-backed process on an agent host. The agent
// fetches pending commands (GET /agents/commands), executes via the OS service
// manager (Windows SCM / systemd), and reports the outcome (POST
// /agents/command-result). Operator-initiated only — the agent never self-acts.
// Every transition is audited (asset.process.<action>.requested / .result).
model AgentCommand {
  id             String    @id @default(uuid())
  assetId        String
  managedAgentId String
  action         String // "stop" | "start" | "restart" | "run_script"
  target         String // the resolved service/unit name to act on (script name for run_script)
  // run_script payload: { runId, interpreter, body, sha256, args, timeoutSec }.
  // Body ships inline (≤64KB, bounded by the registry) with a sha256 the
  // agent VERIFIES before executing. NULL for process-control commands.
  payload        Json?
  status         String    @default("pending") // pending | sent | succeeded | failed
  requestedBy    String? // operator username
  requestedAt    DateTime  @default(now())
  sentAt         DateTime?
  completedAt    DateTime?
  error          String? // failure detail reported by the agent
  resultState    String? // post-action service state the agent observed

  @@index([managedAgentId, status])
  @@index([assetId])
  @@map("agent_commands")
}

// Operator-authored script registry for Automation script actions. CRUD (and
// attaching script actions to automations) is gated by the `automationScripts`
// RBAC key — holding it is RCE-EQUIVALENT: server scripts run as the polaris
// service user on the Polaris host, agent scripts as root/LocalSystem on the
// triggering asset. Creation and every body change stamp a warning Event with
// the old/new sha256. A human must review scripts before production use.
model AutomationScript {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  interpreter String // "bash" | "sh" | "powershell" | "cmd" | "python3"
  body        String   @db.Text // ≤ 64 KB, validated at the API layer
  runTarget   String   @default("server") // "server" | "agent" | "either"
  timeoutSec  Int      @default(60) // default; a script action may override (≤600)
  sha256      String // hex digest of body, recomputed on every save (agents verify)
  enabled     Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs AutomationScriptRun[]

  @@map("automation_scripts")
}

// One execution of a registry script (server- or agent-side) — the shared
// results table for both runners. Server runs are claimed + executed by the
// runAutomationScripts job (web/all role); agent runs ride the AgentCommand
// queue (action="run_script") and complete via /agents/command-result.
// notificationId deliberately has NO FK (alerts get cleared/pruned on their
// own lifecycle). Rows older than ~90 days pruned by the runner's sweep.
model AutomationScriptRun {
  id             String            @id @default(uuid())
  scriptId       String?
  script         AutomationScript? @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  scriptName     String // snapshot — survives script deletion
  sha256         String // snapshot of the body that actually ran
  notificationId String? // the triggering alert, when fired by an automation
  ruleId         String?
  assetId        String? // agent runs: the triggering asset
  runOn          String // "server" | "agent"
  agentCommandId String? // agent runs: the AgentCommand carrying the payload
  args           String?           @db.Text // rendered argsTemplate snapshot
  timeoutSec     Int
  status         String            @default("pending") // pending | running | succeeded | failed | timeout
  exitCode       Int?
  stdout         String?           @db.Text // capped at 64 KB
  stderr         String?           @db.Text // capped at 64 KB
  requestedBy    String? // "system:automation" | operator username (test runs)
  requestedAt    DateTime          @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  @@index([status, runOn])
  @@index([scriptId])
  @@index([notificationId])
  @@map("automation_script_runs")
}

// Geocode result cache. Populated by `geocoderService.geocode()` when
// discovery falls back from a malformed CMDB coord to the FortiGate's SNMP
// sysLocation string. Negative results (no geocoder hit) are stored too so
// gibberish location strings don't repeatedly hit the upstream provider.
//
// `query` is the normalized lookup key (trim + collapse whitespace +
// lowercase) and is unique. `displayQuery` preserves the original casing
// for UI display.
//
// `ttlExpiresAt` defaults to fetchedAt + 90 days; expired rows are refetched
// on the next discovery cycle that touches that location string.
model GeocodeCache {
  id           String   @id @default(uuid())
  query        String   @unique
  displayQuery String
  latitude     Float?
  longitude    Float?
  provider     String // "nominatim"
  fetchedAt    DateTime @default(now())
  ttlExpiresAt DateTime

  @@index([ttlExpiresAt])
  @@map("geocode_cache")
}

// ─── Notifications ──────────────────────────────────────────────────────────
//
// Operator-defined notification RULES + the triggered NOTIFICATION instances
// they raise. The rule-evaluation engine (src/services/notificationEngine.ts,
// driven by the evaluateNotificationRules job) reads collected data —
// telemetry/sample tables, current Asset state, host-metrics samples, the
// Event audit log — and inserts Notification rows when a rule's condition is
// met. See NotificationRule in polaris-domain-model -> alerting.md.

// A flexible alert definition. `trigger` is a discriminated JSON union
// (asset_metric | asset_state | host_metric | event | change) validated by Zod
// at the route layer; `scope` selects which assets a metric/state/change rule
// applies to. Kept loose (Json) in the DB so the trigger vocabulary can grow
// without a migration. Delivery `channels` defaults to in-app only; SMTP /
// OAuth / browser push land in a later change.
model NotificationRule {
  id               String   @id @default(uuid())
  name             String
  description      String?  @db.Text
  enabled          Boolean  @default(true)
  severity         String   @default("warning") // info | warning | error
  trigger          Json // discriminated union — see notificationRuleService
  scope            Json     @default("{}") // { allAssets?, assetTypes?, tags?, assetIds?, integrationIds?, manufacturers?, models?, subnetCidrs?, condition? (nested AND/OR rule tree — see notificationTypes.scopeConditionSchema) }
  clearBehavior    String   @default("manual") // manual | auto | timed
  clearAfterSec    Int? // for clearBehavior=timed
  cooldownSec      Int? // suppress re-fire window (re-notify)
  messageTemplate  String?  @db.Text // tokens: {asset} {metric} {value} {threshold}
  // Refuse to acknowledge an alert from this automation without a note.
  // Per-automation because the demand is per-automation: "someone looked at
  // it" is enough for a noisy interface flap, while a critical outage wants
  // the operator to say what the problem was and what they did. Enforced
  // SERVER-side in acknowledgeNotifications (and therefore on the emailed ack
  // link and the web-push action too), not merely in the modal, because every
  // one of those paths can acknowledge without ever rendering the form.
  requireAckNote   Boolean  @default(false)
  channels         String[] @default(["in_app"])
  // Delivery targets — array of { channel, recipientTags?, addresses?,
  // webhookUrl?, webhookKind? }. In-app delivery stays implicit (every fire
  // writes a Notification); `targets` drives outbound email/webhook/web_push.
  // Validated by notificationRuleService; expanded by notificationRecipientService.
  targets          Json     @default("[]")
  // Rule-level outbound-email composition: { subjectTemplate?, bodyTextTemplate?,
  // bodyHtmlTemplate?, cc?: {recipientUserIds?, addresses?}, bcc?: {...} }.
  // NULL = default subject/body + per-address fan-out (pre-feature behavior).
  // When set, each email target sends ONE message (full To list + Cc + Bcc).
  // Validated by emailCompositionSchema in notificationTypes.ts.
  emailComposition Json?
  // Escalation config: { stopOn: "acknowledge"|"clear", tiers: [{ afterMin,
  // channelId, to, cc?, bcc?, subjectTemplate?, bodyTextTemplate?,
  // bodyHtmlTemplate?, repeatEveryMin?, maxRepeats? }] }. Email-only (tier
  // channels must be smtp/oauth_m365). Swept by the escalateNotifications job.
  escalation       Json?
  // ── Automation rule-shape v2 (2026-07) ─────────────────────────────────
  // reset: { mode: "manual"|"auto"|"timed", clearThreshold?, sustainSec?,
  // afterSec? } — supersedes clearBehavior/clearAfterSec (auto gains
  // hysteresis + clear-sustain). actions: v2 unified outcome list —
  // [{ type: "notify"|"api_call"|"script", ... }] — supersedes `targets`.
  // NULL on pre-v2 rows: every reader goes through normalizeRuleToV2()
  // (notificationTypes.ts), and the migrateAutomationRuleShape one-shot
  // persists the converted shape. The legacy columns above are retained as a
  // lossless mirror (rewritten on every save from the v2 shape where
  // representable) so a pre-wizard UI and pre-upgrade backups stay coherent.
  reset            Json?
  actions          Json?
  // ── Severity bands (value-driven escalation, 2026-07) ──────────────────────
  // Optional higher tiers stacked on the base trigger threshold/severity (tier
  // 0 = severity + trigger.threshold + actions/escalation above). Each band:
  // { threshold, severity, actions: AutomationAction[], escalation? }. As the
  // metric climbs the alert's severity escalates and re-notifies with that
  // band's actions. NULL = single-severity (pre-band) behavior. Numeric
  // (asset_metric/host_metric) triggers only. See notificationTypes.severityBandSchema.
  severityBands    Json?
  // Per-automation notify policy for band transitions: { onIncrease, onDecrease,
  // onResolved, resolvedMode: "reuse"|"dedicated", resolvedActions? }. NULL =
  // defaults (increase + resolved via reuse). See notificationTypes.bandNotifySchema.
  bandNotify       Json?

  // Actions that run when the alert ENDS: auto / timed / custom-condition
  // reset, or an operator clearing it by hand. Plain actions (notify |
  // api_call | script | event) — never escalatable, because there is nothing
  // to chase about a recovery. NULL = silent on reset, which is what every
  // pre-feature automation keeps until someone edits and saves it; the wizard
  // seeds this from the trigger's notify actions as they are created, so new
  // automations tell the same people it recovered.
  resetActions Json?
  // Re-send this alert's notifications while it stays unhandled:
  // { everyMin, stopOn: "acknowledge" | "clear", stopAfterHours? }.
  //
  // Only escalation TIERS could repeat before this — the engine's initial fire
  // sent once and never revisited it, so an alert nobody looked at went quiet.
  // Swept by the same escalateNotifications tick, keyed REPEAT_STATE_KEY in
  // Notification.escalationState.
  //
  // Deliberately NO maxRepeats: the operator asked for unbounded, and the
  // optional stopAfterHours is the escape hatch. Repeats re-run NOTIFY actions
  // only (REPEATABLE_ACTION_TYPES) — unbounded re-execution of a
  // ticket-creating webhook or a registry script is not symmetric with an extra
  // email. NULL = never repeats, which is every pre-feature automation.
  repeat       Json?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notifications Notification[]
  states        NotificationRuleState[]

  @@index([enabled])
  @@map("notification_rules")
}

// A single triggered notification (the View tab + asset-details rows). Region
// tags + hostname are snapshotted at trigger time (region names stripped of the
// `region:` prefix so they compare directly to a viewer's regionTags), so the
// row still renders + scopes after the asset is deleted. Soft-clear (`cleared`)
// preserves history; the default list filters cleared out.
model Notification {
  id     String            @id @default(uuid())
  ruleId String?
  rule   NotificationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  assetId       String?
  assetHostname String?
  severity      String   @default("warning")
  message       String   @db.Text
  regionTags    String[] @default([])
  triggeredAt   DateTime @default(now())

  acknowledged    Boolean   @default(false)
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  acknowledgeNote String?   @db.Text

  cleared   Boolean   @default(false)
  clearedBy String? // username, or "system:auto-resolve" / "system:timed"
  clearedAt DateTime?

  // Fire-time token→string template context snapshot (written only when the
  // rule has emailComposition/escalation), so escalation emails render at
  // T+delay with the exact fire-time metric values even if the asset is gone.
  templateCtx     Json?
  // Per-tier escalation progress: { tiers: { "<tierIdx>": { firstSentAt,
  // lastSentAt, count } } }. Written by the escalateNotifications sweep.
  escalationState Json?

  // Raised by the automation wizard's "Test delivery" buttons rather than by a
  // real trigger. Always carries ruleId = null (a real ruleId would put it in
  // the escalation sweep's candidate set and start paging people), so this
  // column is the only way to tell a test alert from a rule-less one.
  testRun Boolean @default(false)

  // The sub-asset dimension this alert is ABOUT, exactly as the engine keyed
  // its state row (NotificationRuleState.dimensionKey): a hardware sensor's
  // name, an interface, a mount, a tunnel. NULL for whole-device alerts,
  // composites (which fire per asset at dimensionKey "") and event/change
  // rules. Persisted because the alert email is rendered at DELIVERY time,
  // long after the reading is gone — without it the sensor chart could not
  // know which of a firewall's dozen sensors the alert was raised for.
  dimension String?

  // The metric that fired ("responseTimeMs", "hwSensorValue", …). Read at
  // DELIVERY time so the chart explaining THIS alert leads the email — the
  // body is rendered long after the rule that produced it was in hand.
  metric String?

  deliveries NotificationDelivery[]

  @@index([assetId])
  @@index([cleared, acknowledged])
  @@index([triggeredAt])
  @@map("notifications")
}

// One row per (notification, channel, concrete recipient) for outbound
// delivery — the deliverNotifications job drains pending rows, dispatches per
// channel, and records sent/failed + retry count. Snapshotted at fire time by
// notificationRecipientService.expandDeliveries so recipients reflect the
// rule's targets when it fired (not when the job runs). In-app delivery is NOT
// represented here (it's the Notification row itself). Cascade-deleted with
// the Notification.
// An operator-configured outbound delivery integration (registry, like
// Integration but for notifications). One row per configured destination;
// operators add as many as they want from the Notifications → Delivery tab.
// `type` selects the transport + config shape; secrets in `config` are masked
// on read and preserved on write (notificationChannelService). web_push is a
// singleton (one server VAPID keypair) — the service enforces a single row.
model NotificationChannel {
  id        String   @id @default(uuid())
  name      String
  type      String // smtp | oauth_m365 | pushbullet | slack | teams | web_push
  enabled   Boolean  @default(true)
  config    Json     @default("{}") // type-specific; secrets masked at the API
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries NotificationDelivery[]

  @@index([type])
  @@map("notification_channels")
}

model NotificationDelivery {
  id             String               @id @default(uuid())
  notificationId String
  notification   Notification         @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  // The configured channel this delivery goes through. Nullable + SetNull so a
  // channel can be deleted without orphaning history; a NULL channelId on a
  // pending row is treated as a permanent failure by the drain (channel gone).
  channelId      String?
  channel        NotificationChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  transport      String // email | webhook | web_push | pushbullet (dispatch routing)
  target         String               @db.Text // email address / push endpoint; "" for fixed-destination channels (URL/token live on the channel)
  // Per-recipient payload snapshot: webhook → { kind }, web_push →
  // { p256dh, auth }. Destination secrets stay on the channel, NOT here.
  meta           Json?
  status         String               @default("pending") // pending | sent | failed
  attempts       Int                  @default(0)
  lastAttemptAt  DateTime?
  error          String?              @db.Text
  createdAt      DateTime             @default(now())

  @@index([status])
  @@index([notificationId])
  @@index([channelId])
  @@map("notification_deliveries")
}

// A browser/PWA Web Push subscription owned by a user. Stored at subscribe
// time from the PushManager subscription; the deliverNotifications web_push
// channel sends to each recipient user's endpoints via the `web-push` lib
// signed with the server VAPID keypair. A 404/410 from the push service prunes
// the row (endpoint gone).
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique @db.Text
  p256dh     String   @db.Text
  auth       String
  userAgent  String?
  // Which Polaris surface enrolled this subscription: "desktop" | "mobile".
  // Web push notifications deep-link per surface — a push enrolled from the
  // mobile SPA opens /mobile.html#more/alerts, a desktop one /automations.html.
  // Recorded at subscribe time because that is the only moment we actually
  // know (on Android the installed PWA and the browser share one subscription,
  // so nothing downstream can tell them apart). Snapshotted into the delivery
  // row's meta by notificationRecipientService.
  surface    String   @default("desktop")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// Per-(rule, asset, dimension) firing state for debounce / sustained-duration /
// auto-clear. Mirrors the capacityWatch lastSeverity transition guard: the
// engine only fires on a clear→firing crossing and clears per the rule's
// clearBehavior. `dimensionKey` distinguishes sub-asset dimensions (ifName /
// mountPath / sensorName); "" for asset-level conditions.
model NotificationRuleState {
  id     String           @id @default(uuid())
  ruleId String
  rule   NotificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // "" for host-level / global rules (not nullable so the compound unique
  // dedupes correctly — Postgres treats NULLs in a unique key as distinct).
  assetId           String    @default("")
  dimensionKey      String    @default("")
  state             String    @default("clear") // clear | pending | firing
  conditionMetSince DateTime? // for forDurationSec
  // Recovery-sustain timer (reset.sustainSec, firing state only): stamped when
  // the condition first reads as recovered, nulled when it re-meets or enters
  // the hysteresis dead band. NOT conditionMetSince reused — that one belongs
  // to the pending-side debounce and is nulled on fire.
  recoveredSince    DateTime?
  firedAt           DateTime?
  lastValue         Float?
  notificationId    String? // active notification, for auto-resolve
  // The severity band the active alert is currently in (severity-bands feature).
  // Set on fire + every band transition; drives increase(re-notify)/decrease/
  // same detection. NULL for pre-band rules / single-severity alerts.
  firingSeverity    String?
  // Per-tier "continuously satisfied since" bookkeeping for per-band sustained
  // durations: { [severity]: epochMs }. Each tier (base + every band) carries
  // its own `forDurationSec`, so a tier applies only once ITS condition has
  // held for ITS duration — one shared conditionMetSince can't express that.
  // Rewritten only when the met-set changes (a tier entered / left), so the
  // hot path still writes on transitions, not per tick. NULL for non-banded
  // rules, which keep using conditionMetSince unchanged.
  bandMetSince      Json?
  // Poll-counted holds (forPolls / reset.sustainPolls) for the sources that
  // have NO sample series to count — the Asset columns, the SD-WAN rule table,
  // and the windowed-ratio metrics that are recomputed per tick. `metRun` is
  // the consecutive qualifying readings behind a pending/firing row, `clearRun`
  // the consecutive recovered ones behind an auto-reset, and `lastReadingAt` is
  // the poll anchor that last advanced either — without it the engine's 60s
  // tick would count five "polls" against a device polled every five minutes.
  // Series-backed triggers ignore all three: their run is computed from the
  // samples themselves, statelessly (see leadingRun / advanceRun).
  metRun            Int       @default(0)
  clearRun          Int       @default(0)
  lastReadingAt     DateTime?
  updatedAt         DateTime  @updatedAt

  @@unique([ruleId, assetId, dimensionKey])
  @@index([ruleId])
  @@map("notification_rule_states")
}

// An address-book entry: a named email address Polaris can route alerts to,
// independent of whether the person holds a Polaris account. Two jobs:
//
//   1. A durable label for an address an operator would otherwise retype into
//      every automation ("noc-oncall@…" → "NOC On-Call rotation").
//   2. Device ownership — `assetCriteria` (tagAssignmentService vocabulary)
//      unioned with the explicit `assetIds` pins says WHICH DEVICES this
//      contact is responsible for, exactly the MaintenanceSchedule target
//      shape. A notify action with `recipientAssetContacts` resolves the
//      contacts covering the TRIGGERING asset at fire time, so "email whoever
//      owns this box" needs no per-rule recipient list.
//
// Matching at fire time runs `assetMatchesCriteria` against the single
// triggering asset (never a fleet scan) — see contactService.
// `createdBy` drives the ownership gate on the `contacts` function key:
// write = manage your own rows, fullwrite = manage anyone's.
model Contact {
  id          String  @id @default(uuid())
  email       String  @unique // normalized: trimmed + lower-cased on write
  name        String?
  description String?

  // Directory sync (business rule 35).
  /// WHO owns this row: "manual" | "entra" | "ad". Denormalized from
  /// DirectoryContactSource so the visibility gate and the fire-time load are
  /// one indexed WHERE rather than a join, and so a row's provenance is visible
  /// in a plain SELECT. Carries the BACKEND NAME rather than a boolean because
  /// AddressBookEntry.source is that same vocabulary, so it maps straight
  /// through to what the picker badges. Single writer: directorySyncService,
  /// plus adoptDirectoryContact, which flips it back to "manual".
  origin         String   @default("manual")
  /// "person" | "group" - a mail-enabled distribution list is not a person,
  /// and the picker says so. Manual rows are people by default.
  kind           String   @default("person")
  /// Directory-sourced identity. Operator-editable on a manual row, overwritten
  /// from the directory on a synced one. jobTitle + department are what let an
  /// operator tell two people with the same name apart in the picker; phone is
  /// on-call context. All of it is employee PII - see the posture note in
  /// directorySyncService.ts. None of it may reach Event.details.
  jobTitle       String?
  department     String?
  phone          String?
  // Device ownership, two shapes, one live at a time. assetCondition is the
  // nested AND/OR tree the automations device filter uses (evaluated by
  // evaluateScopeCondition over the wider DEVICE_FILTER vocabulary);
  // assetCriteria is the original flat tagAssignmentService shape, kept only so
  // pre-cutover rows keep matching until they fold forward (criteriaToCondition
  // + the migrateContactFilterShape one-shot). A write of one clears the other.
  assetCondition Json? // ScopeConditionGroup; null = no filter (see assetCriteria)
  assetCriteria  Json? // LEGACY flat criteria; null once folded forward
  assetIds       String[] @default([]) // explicit pins, unioned with filter matches
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  directorySources DirectoryContactSource[]

  // Substring search on email/name is served by GIN trigram indexes created in
  // migration 20260825050000_contacts_search_indexes -- Prisma cannot express a
  // functional lower(...) gin_trgm_ops index, so they live only in SQL.
  @@index([origin])
  @@map("contacts")
}

/// Provenance for the address-book directory (GAL) sync - the TagAutoAssignment
/// / RegionTagAssignment pattern applied to Contact rows. One row per
/// (integration, directory object) the SYNC created, so a reconcile deletes only
/// what it wrote and a hand-added row (which never has one) survives forever.
///
/// A person present in BOTH AD and Entra owns ONE Contact with TWO provenance
/// rows; the Contact dies only when its LAST provenance row goes. `observed` is
/// the per-source field blob, and the Contact is PROJECTED from the set
/// (projectContactFromSources) rather than last-writer-wins - otherwise two
/// directories that disagree would ping-pong the row on alternating runs. That
/// is the AssetSource / projectAssetFromSources shape, at contact scale.
///
/// NO foreign key on integrationId, deliberately: a cascade would strip the
/// provenance and strand the Contact rows it justified, which is exactly the
/// state in which the sync can no longer tell its own rows from an operator's.
/// Integration delete and the sync-disable toggle call purgeDirectoryContacts
/// explicitly instead.
model DirectoryContactSource {
  integrationId String
  /// Graph object id (user / group / orgContact) or AD objectGUID hex.
  externalId    String
  /// "entra" | "ad"
  sourceKind    String
  contactId     String
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// The DirectoryPerson this source last reported. Employee PII at rest.
  observed      Json
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  @@id([integrationId, externalId])
  @@index([contactId])
  @@index([integrationId])
  @@map("directory_contact_sources")
}

// Operator-defined maintenance window definition. Targets = the union of the
// criteria matches (tagAssignmentService criteria vocabulary — hostname /
// subnet-CIDR / model / manufacturer / os / assetType; `status` rules are
// rejected because the feature itself flips status) and the explicit assetIds
// list (the ad-hoc "enter maintenance until…" pill path), always intersected
// with monitored=true. `schedule` is the recurrence JSON validated by
// src/utils/maintenanceRecurrence.ts (oneshot | recurring daily/weekly/
// monthly/yearly, optional time-of-day range + active date bounds,
// server-local wall-clock). Reconciled by the maintenanceScheduler job every
// 30s and inline on every CRUD mutation.
model MaintenanceSchedule {
  id               String   @id @default(uuid())
  name             String
  enabled          Boolean  @default(true)
  criteria         Json? // tagAssignmentService criteria shape; null = explicit assets only
  assetIds         String[] @default([]) // explicit targets, unioned with criteria matches
  schedule         Json // recurrence shape (see maintenanceRecurrence.ts)
  // Whether an in-window asset counts as DOWN for child dependency
  // suppression (evaluateSuppression). true (default) = dependents behind it
  // suppress like a Dependency Test; false = the maintenance status is
  // ignored by suppression and the parent evaluates by its frozen
  // monitorStatus (dependents keep monitoring/alerting normally — e.g. a
  // clustered/redundant parent whose children stay reachable).
  suppressChildren Boolean  @default(true)
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  windows AssetMaintenanceWindow[]

  @@index([enabled])
  @@map("maintenance_schedules")
}

// One realized maintenance window per (asset, schedule): opened when the
// scheduler puts the asset into maintenance for that schedule, closed
// (endedAt + endReason) when the window ends for any reason. Open rows
// (endedAt IS NULL) are the source of truth for "currently in maintenance" —
// restart-safe by construction. Closed rows power the chart maintenance
// bands (scheduleName is snapshotted so labels survive schedule deletion).
// Plain table — the hypertable no-FK rule does not apply here.
model AssetMaintenanceWindow {
  id           String    @id @default(uuid())
  assetId      String
  scheduleId   String? // SetNull on schedule delete — history survives
  scheduleName String // snapshot for chart-band labels after delete
  startedAt    DateTime  @default(now())
  endedAt      DateTime? // null = window currently open
  // "schedule" | "operator" | "disabled" | "deleted" | "criteria" |
  // "decommissioned" (deleted at its discovery source mid-window)
  endReason    String?

  asset    Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)
  schedule MaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([assetId, startedAt])
  @@index([endedAt])
  @@map("asset_maintenance_windows")
}

// Polaris host CPU / memory / load time-series. Fills the gap where host
// resource usage was read by capacityService but never stored — host_metric
// rules read the latest row. Plain prunable table (not a hypertable); pruned at
// 7 days by the nightly sample-prune pass. Sampled by the hostMetricsCollector
// job (web/all role only).
model HostMetricsSample {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  cpuPct        Float
  memUsedPct    Float
  memUsedBytes  BigInt
  memTotalBytes BigInt
  loadAvg1      Float
  loadAvg5      Float
  loadAvg15     Float
  procRssBytes  BigInt

  @@index([timestamp])
  @@map("host_metrics_samples")
}

// Trust-on-first-use pins for SSH SERVER host keys.
//
// Polaris passed no `hostVerifier` to ssh2 before this, so every SSH
// connection — agent install, agentless process collection, the SSH monitor
// probe — accepted any host key: the server was never authenticated to the
// client. Host keys are per-HOST but a Credential spans a fleet, so the pins
// cannot live on Credential.config and need their own table.
//
// Opt-in per credential via SshConfig.verifyHostKey, mirroring the WinRM
// `verifyTls` precedent (2026-06-03 review, H1): default OFF so no existing
// install breaks, default ON for newly created credentials.
//
// Plain table, no Asset FK — a host is often onboarded before it exists as an
// Asset, and the pin is keyed by the address actually dialed.
model SshHostKey {
  id          String   @id @default(uuid())
  host        String
  port        Int      @default(22)
  keyType     String // "ssh-ed25519", "ecdsa-sha2-nistp256", "ssh-rsa", ...
  fingerprint String // "SHA256:<base64, unpadded>" — same form `ssh-keygen -lf` prints
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  @@unique([host, port])
  @@map("ssh_host_keys")
}

// A CIDR the operator has declared OUT OF SCOPE for the networks list
// (business rule 42).
//
// WHY THIS EXISTS
// Some address space is the same at every site: a management VLAN, an
// out-of-band range, a vendor appliance's fixed subnet. Every site's FortiGate
// reports it, and Polaris' model of a subnet is a SINGLE row per CIDR
// (`@@unique([blockId, cidr])`), so the first site to be discovered creates the
// row and every other site collides with it. Post-rule-41 that collision is
// louder than noise: each site's gate answers with its own serial, so the row's
// chassis identity reads as REPLACED on every run and discovery raises a
// `chassis-replaced` Conflict about a box nobody swapped.
//
// An exclusion says "this CIDR is not one network — do not try to record it."
// Discovery skips it whole: no create, no update, no chassis check, and it is
// left out of the Phase 2 stale sweep, so nothing about an excluded CIDR can
// raise a conflict or move a row.
//
// GLOBAL, NOT PER BLOCK, deliberately. The whole point is that the CIDR is
// shared across sites, and blocks are how Polaris carves ITS space; scoping an
// exclusion to one block would let the same CIDR be recorded through another.
//
// `cidr` is the identity and is FROZEN after create (PUT accepts name/notes
// only) — re-pointing an exclusion at different address space in place would
// silently un-exclude what the operator excluded, so that is a delete plus an
// add. Normalized on write, so 10.1.1.5/24 and 10.1.1.0/24 are one row.
model SubnetExclusion {
  id    String @id @default(uuid())
  cidr  String @unique
  name  String
  notes String? @db.Text

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cidr])
  @@map("subnet_exclusions")
}
