// Prisma Schema — Polaris (Subnet & IP Address Management)
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum IpVersion {
  v4
  v6
}

enum SubnetStatus {
  available
  reserved
  deprecated
}

enum ReservationStatus {
  active
  expired
  released
}

enum ReservationSourceType {
  manual
  dhcp_reservation
  dhcp_lease
  interface_ip
  vip
  fortiswitch
  fortinap
  fortimanager
  fortigate
  dns_resolved
}

enum ConflictStatus {
  pending
  accepted
  rejected
}

// UserRole enum retired — replaced by the Role table below. Role identity
// + permission matrix now live in `Role` and are joined into User via
// `User.roleId`. See polaris-api-rbac -> auth-rbac.md for the access semantics.

// ─── Models ───────────────────────────────────────────────────────────────────

model IpBlock {
  id          String    @id @default(uuid())
  name        String
  cidr        String    @unique
  ipVersion   IpVersion
  description String?   @db.Text
  tags        String[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subnets Subnet[]

  @@index([ipVersion])
  @@map("ip_blocks")
}

model Subnet {
  id      String  @id @default(uuid())
  blockId String
  block   IpBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  cidr    String
  name    String
  purpose String?      @db.Text
  status  SubnetStatus @default(available)
  vlan    Int?
  tags    String[]     @default([])

  discoveredBy    String?
  integration     Integration? @relation(fields: [discoveredBy], references: [id], onDelete: SetNull)
  fortigateDevice String?

  // Chassis identity of the gate that serves this subnet -- the serial, which
  // unlike `fortigateDevice` (FMG's device NAME) is never renamed. TRI-STATE:
  // NULL means unknown (a row predating this column, or a source that
  // published no serial) and applies no constraint; a value is the chassis
  // that last served the subnet. Compared per run by
  // `utils/chassisIdentity.ts:classifyChassis` against the reporting device's
  // whole cluster serial set, so an HA failover reads as the same gate while a
  // genuinely new chassis raises the `chassis-replaced` Conflict flavour.
  // Business rule 41.
  fortigateSerial String?
  createdBy       String?

  // Bumped whenever discovery touches this subnet — both the integration-wide
  // discoverDhcpSubnets pass and the per-subnet Refresh action stamp it.
  // Drives the "Discovered N minutes ago" line in the IP panel slide-in.
  lastDiscoveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]
  conflicts    Conflict[]

  // DB backstop for business rule 1 (no overlapping subnets in a block). The
  // exact guard is the per-block advisory lock every subnet writer takes
  // (lockBlockForSubnetWrites in services/subnetService.ts); this catches the
  // exact-duplicate case even from a path that forgets the lock. Added by
  // migration 20260806000000, which SKIPS creation on an install that already
  // carries duplicates from the pre-lock race — the enforceSubnetUniqueIndex
  // startup job adds it once they are cleaned up, so `prisma migrate diff` can
  // legitimately report this index missing on such an install.
  @@unique([blockId, cidr], map: "subnets_block_cidr_key")
  @@index([blockId])
  @@index([fortigateSerial])
  @@index([blockId, status])
  @@index([cidr])
  @@index([status])
  @@index([discoveredBy])
  @@index([createdBy])
  @@map("subnets")
}

model Reservation {
  id       String @id @default(uuid())
  subnetId String
  subnet   Subnet @relation(fields: [subnetId], references: [id], onDelete: Cascade)

  ipAddress       String?
  hostname        String?
  owner           String?
  projectRef      String?
  expiresAt       DateTime?
  notes           String?               @db.Text
  status          ReservationStatus     @default(active)
  sourceType      ReservationSourceType @default(manual)
  createdBy       String?
  conflictMessage String?
  vipInfo         Json?

  // DHCP reservation push to FortiGate. Populated only when an FMG integration
  // with `pushReservations=true` discovered this subnet AND the reservation is
  // sourceType=manual. macAddress is the MAC sent to the device (DHCP
  // reservations are MAC→IP). pushedScopeId / pushedEntryId pin the row on the
  // FortiGate so unpush hits the exact entry without re-resolving by IP.
  // pushStatus values: "synced" (verified on device), "drift" (was synced,
  // missing on rediscovery), "pending" (transient device-side failure at
  // create or retry time — Polaris row persists, retry job will keep trying
  // until the gate is reachable; sourceType stays "manual" until the push
  // actually lands), "failed_permanent" (terminal — push hit a 4xx/verify
  // mismatch / lost an IP-collision race against discovery; operator must
  // release or retry-now after fixing the cause). Permanent create-time
  // failures still abort + roll back the Polaris row (no stored state for
  // those — the row simply doesn't exist).
  // pushQueuedAt / pushAttempts / pushLastAttemptAt drive the retry tick: a
  // monitored firewall whose Asset.monitorStatus="up" retries on every tick;
  // an unmonitored or down firewall backs off exponentially (60s → 30 min
  // cap) keyed on pushLastAttemptAt + pushAttempts. No TTL — queued rows
  // live forever until success, release, or operator-triggered retry-now.
  macAddress        String?
  pushedToId        String?
  pushedTo          Integration? @relation("ReservationPushedTo", fields: [pushedToId], references: [id], onDelete: SetNull)
  pushedScopeId     Int?
  pushedEntryId     Int?
  pushStatus        String?
  pushedAt          DateTime?
  pushError         String?      @db.Text
  pushQueuedAt      DateTime?
  pushAttempts      Int          @default(0)
  pushLastAttemptAt DateTime?

  // Stale-reservation detection. lastSeenLeased is bumped during DHCP
  // discovery whenever /api/v2/monitor/system/dhcp confirms the reservation's
  // IP is actively held by a client right now. staleNotifiedAt tracks the
  // most recent time the flagStaleReservations job emitted a `reservation.stale`
  // Event for this row, so the next nightly run doesn't re-fire the same
  // alert until the threshold is recrossed (lastSeenLeased advances).
  // staleSnoozedUntil is set by the operator-driven Snooze action on the
  // Alerts panel; while it is in the future, the row is suppressed from the
  // alert list and the job won't re-fire. Cleared when discovery sees the IP
  // active again so a re-snoozed reservation that comes back online
  // re-arms cleanly.
  // staleIgnored is the network-admin/admin-driven "permanently ignore"
  // action — when true, the row is suppressed from the alert list and the
  // job won't re-fire forever, until an admin explicitly un-ignores. Unlike
  // snooze, this flag is NOT cleared by discovery seeing the IP active
  // again; the operator's intent is durable across online/offline cycles.
  // lastSeenArp is bumped by the discovery sync when the FortiGate's ARP
  // table shows this reservation's IP bound to this reservation's MAC —
  // minutes-fresh L2 evidence the device is alive even when it never pulls
  // a lease (statically-configured) and firewalls ICMP. The opt-in
  // `arpPresenceSweep` integration toggle actively primes the gate's ARP
  // cache (fire-and-forget UDP at each reserved IP) right before the table
  // read so quiet devices show up too; without the sweep the stamp still
  // lands whenever ordinary traffic put the binding in the table.
  lastSeenLeased    DateTime?
  lastSeenArp       DateTime?
  staleNotifiedAt   DateTime?
  staleSnoozedUntil DateTime?
  staleIgnored      Boolean   @default(false)

  // How the FortiGate actually hands this address out, kept SEPARATE from
  // sourceType on purpose. sourceType answers "who owns this IP" (a managed
  // FortiSwitch/FortiAP, a VIP, an operator); dhcpBinding answers "does the
  // gate have a MAC→IP binding for it". Conflating the two is what made a
  // FortiLink-leased AP render as an authoritative reservation while the gate
  // reported "Not Reserved" — the row was authoritative about ownership and
  // silent about binding.
  //   null           — unknown / not applicable (nothing observed it in DHCP)
  //   "lease"        — the gate leases it dynamically; no reserved-address entry
  //   "reservation"  — a real MAC→IP reserved-address entry exists on the gate
  // Written by the Phase 5 DHCP pass for fortiswitch/fortinap rows (the only
  // source types whose binding state was previously undiscoverable). A "lease"
  // row is takeover-able by an operator Reserve exactly like a dhcp_lease row;
  // "reservation" and null still 409. Deliberately NOT paired with expiresAt on
  // these rows — that would hand them to expireReservations and churn them.
  dhcpBinding String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conflicts Conflict[]

  @@unique([subnetId, ipAddress, status])
  @@index([subnetId])
  @@index([subnetId, status])
  @@index([owner])
  @@index([projectRef])
  @@index([status])
  @@index([status, expiresAt])
  @@index([expiresAt])
  @@index([createdBy])
  @@index([pushedToId])
  @@index([pushStatus, pushQueuedAt])
  @@map("reservations")
}

model Integration {
  id                      String    @id @default(uuid())
  type                    String // e.g. "fortimanager"
  name                    String // Human-readable label
  config                  Json      @default("{}") // Connection settings (host, port, adom, etc.)
  enabled                 Boolean   @default(true)
  autoDiscover            Boolean   @default(true)
  pollInterval            Int       @default(4) // Auto-discovery interval in hours (1–24)
  lastTestAt              DateTime?
  lastTestOk              Boolean?
  lastDiscoveryAt         DateTime? // Set at the start of each discovery run; used by the scheduler to gate auto-discovery across restarts
  // Precomputed "By name" checklist sources for the Auto-Monitor cards, refreshed
  // at the end of every successful discovery run (computeAndCacheInterfaceAggregate /
  // computeAndCacheStorageAggregate). Shape: { "<class>": { computedAt, rows: [...] } }
  // keyed by AutoMonitorClass / StorageClass. Lets the edit-modal pickers load
  // instantly instead of running a fleet-wide DISTINCT ON over the sample tables
  // on every modal open. Null until the integration's first post-feature discovery
  // (the GET routes fall back to a live compute in that window).
  interfaceAggregateCache Json? // { [class]: { computedAt: ISO, rows: [{ifName, ifType, deviceCount}] } }
  storageAggregateCache   Json? // { [class]: { computedAt: ISO, rows: [{mountPath, deviceCount}] } }
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  subnets               Subnet[]
  discoveredAssets      Asset[] // Assets stamped with this integration's id (back-relation)
  pushedReservations    Reservation[]            @relation("ReservationPushedTo")
  fortigateSightings    AssetFortigateSighting[] // Back-relation: sightings recorded against this integration's discovered FortiGates
  assetSources          AssetSource[] // Back-relation: per-source asset rows attributed to this integration
  monitorClassOverrides MonitorClassOverride[] // Back-relation: (assetType, integration) override rows
  vcenterDatastores     VcenterDatastore[] // Back-relation: current-state datastore rows (vcenter type only)

  @@index([type])
  @@index([enabled])
  @@map("integrations")
}

// Cross-process live state for a discovery run. Replaces the former in-memory
// `activeDiscovery` Map so the web process can render progress + signal cancel
// while the discovery process actually executes the run. One row per
// integration (`integrationId @unique`) is the DB-level "one active run per
// integration" invariant, paired with the pg-boss discovery queue's
// singletonKey. Rows are upserted on enqueue and updated by the discovery
// worker; terminal status + finishedAt mark completion.
model DiscoveryRun {
  id                  String    @id @default(uuid())
  integrationId       String    @unique
  integrationName     String
  type                String // mirrors Integration.type (fortimanager, fortigate, …)
  status              String    @default("queued") // queued | running | completed | aborted | error
  actor               String // who triggered it (username or "auto-discovery")
  startedAt           DateTime? // set by the worker at run start
  updatedAt           DateTime  @updatedAt
  finishedAt          DateTime?
  totalDevices        Int? // FMG/FortiGate: device count once known
  completedCount      Int       @default(0)
  skippedOfflineCount Int       @default(0)
  skippedErrorCount   Int       @default(0)
  activeDevices       Json      @default("[]") // [{ name, startedAt }] — collapses the old Set + start-time Map
  slowAlerted         Boolean   @default(false)
  slowAlertedDevices  Json      @default("[]") // string[] of device names already slow-alerted
  cancelRequested     Boolean   @default(false) // web sets this; the worker polls it and aborts
  workerHeartbeatAt   DateTime? // last write from the worker; drives the stale-run reaper
  scopeDeviceName     String? // set when the run is scoped to one FortiGate (single-device re-discovery); NULL = full run
  createdAt           DateTime  @default(now())

  @@index([status])
  @@map("discovery_runs")
}

// ─── Network Discovery (active scan) ──────────────────────────────────────────
//
// A saved, re-runnable active scan of operator-supplied IP ranges. Operator-
// facing name: a **Discovery**. The models are `NetworkScan*` so nothing here
// collides with the integration-discovery machinery (DiscoveryRun /
// discoveryEngine / discoveryRunState) — the same split polaris-monitoring-discovery documents for
// Automation/NotificationRule.
//
// This is deliberately NOT an 8th Integration type and NOT a DiscoveryRun row.
// DiscoveryRun.integrationId is @unique and NOT NULL, so a scan with no
// Integration behind it cannot get a row there; and inserting a queued/running
// row would trip anyOtherRunActive() (the backup-restore guard) and surface in
// the /integrations/discoveries progress UI as an integration that isn't one.
model NetworkScan {
  id          String  @id @default(uuid())
  // Not globally unique since the private/public cutover: two operators may
  // each keep a private "Plant 3 sweep", and a 409 naming a row the caller
  // cannot see is both a dead end and a disclosure. Unique per OWNER instead.
  name        String
  description String?

  // Who may see and use it. "private" = the owner alone; "public" = every
  // caller holding networkScan:read, which is what lets one operator build a
  // Discovery another one runs. The SavedDashboard / SavedTableFilter model.
  // Editing or deleting someone else's is networkScan:fullwrite housekeeping.
  visibility String @default("private")

  // ScanTarget[] — [{ kind: "cidr" | "range" | "single", value: string }].
  // Expanded to an ordered, deduped host list by expandScanTargets (utils/cidr).
  targets Json @default("[]")

  // ScanMethod[] — [{ type: "icmp"|"snmp"|"restapi"|"ssh"|"winrm",
  //                   credentialIds: string[] }], tried in array order.
  // ICMP carries no credentials (the store has no "icmp" type by design).
  methods Json @default("[]")

  // Per-polling-method auto-monitor selection applied to whatever gets adopted:
  // { [method]: { interfaces?: AutoMonitorSelection, storage?: ... } }.
  // Null = pin nothing. Same byNames/byPatterns/byTypes/byLldp vocabulary as the
  // integration Monitoring tab, so the pure resolvers are reused verbatim.
  autoMonitor Json?

  // ownerId is the identity ownership is decided on; createdBy is the username
  // SNAPSHOT that survives the account (SavedDashboard's `ownerName`, reusing
  // the column that already held exactly that). SetNull, not Cascade: a shared
  // Discovery outlives the account that published it. NULL owner = an orphan,
  // or a row a bearer token created (a token has no user identity), and either
  // way it is manageable only at fullwrite.
  ownerId   String?
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastRunAt DateTime?

  runs NetworkScanRun[]

  @@unique([ownerId, name])
  @@index([visibility])
  @@map("network_scans")
}

// One execution of a NetworkScan. Carries DiscoveryRun's operational columns —
// cancelRequested (polled by the worker, which aborts its own AbortController)
// and workerHeartbeatAt (drives the stale-run reaper) — but NOT its
// one-row-per-integration uniqueness: run history is wanted here, and it is what
// lets the wizard reattach to a scan still in flight instead of losing it when
// the operator closes the modal.
model NetworkScanRun {
  id     String      @id @default(uuid())
  scanId String
  scan   NetworkScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  status String  @default("queued") // queued | running | completed | aborted | error
  actor  String
  error  String?

  totalTargets       Int @default(0) // after expansion + exclusions
  droppedTargetCount Int @default(0) // over the cap, or excluded (loopback/link-local/multicast)
  scannedCount       Int @default(0)
  hitCount           Int @default(0)
  skippedKnownCount  Int @default(0) // responders whose address an Asset already carries

  // ScanHit[] — one per responder: address, which method answered, the
  // identified fields, and the interface/storage inventory the scan collected.
  hits Json @default("[]")

  cancelRequested   Boolean   @default(false)
  workerHeartbeatAt DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([scanId, createdAt])
  @@index([status])
  @@map("network_scan_runs")
}

// Credential store for monitoring probes (SNMP, WinRM, SSH).
// Single discriminator table; type-specific fields live in `config` JSON
// following the same plaintext-at-rest + mask-on-API-read pattern as Integration.
//
// config shapes:
//   snmp (v2c):   { version: "v2c", community: string, port?: number }
//   snmp (v3):    { version: "v3", username, authProtocol: "MD5"|"SHA",
//                   authKey, privProtocol: "DES"|"AES"|"none",
//                   privKey?, securityLevel: "noAuthNoPriv"|"authNoPriv"|"authPriv", port?: number }
//   winrm:        { username, password, port?: number, useHttps?: boolean }
//   ssh:          { username, password?, privateKey?, port?: number }
model Credential {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String // "snmp" | "winrm" | "ssh"
  config    Json     @default("{}")
  // Ownership dimension for the `credentials` function key: a write-level
  // role may edit / delete / test-with only the rows it created, fullwrite
  // reaches any. Nullable, and null means UNOWNED — every row that predates
  // the column, which is deliberately NOT backfilled to anyone: a
  // credential nobody claims is exactly the thing only a fullwrite caller
  // should be able to touch, and inventing an owner for it would hand a
  // write-level operator every secret the install already had. Same shape
  // as Subnet / Reservation / Contact.createdBy (a username string, no FK,
  // so it survives the account being deleted).
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customWidgets                   ManufacturerCustomWidget[] @relation("ManufacturerCustomWidgetCredential")
  assets                          Asset[]                    @relation("AssetMonitorCred") // default credential back-relation
  rtAssets                        Asset[]                    @relation("AssetRTCred")
  cpuMemoryAssets                 Asset[]                    @relation("AssetCpuMemCred")
  temperatureAssets               Asset[]                    @relation("AssetTempCred")
  interfacesAssets                Asset[]                    @relation("AssetInterfacesCred")
  lldpAssets                      Asset[]                    @relation("AssetLldpCred")
  customWidgetAssets              Asset[]                    @relation("AssetCustomWidgetCred")
  processesAssets                 Asset[]                    @relation("AssetProcessesCred")
  eventLogAssets                  Asset[]                    @relation("AssetEventLogCred")
  // Back-relations for per-stream class override credentials
  classOverrideRTAssets           MonitorClassOverride[]     @relation("ClassOverrideRTCred")
  classOverrideCpuMemAssets       MonitorClassOverride[]     @relation("ClassOverrideCpuMemCred")
  classOverrideTempAssets         MonitorClassOverride[]     @relation("ClassOverrideTempCred")
  classOverrideIfAssets           MonitorClassOverride[]     @relation("ClassOverrideIfCred")
  classOverrideLldpAssets         MonitorClassOverride[]     @relation("ClassOverrideLldpCred")
  classOverrideCustomWidgetAssets MonitorClassOverride[]     @relation("ClassOverrideCustomWidgetCred")
  classOverrideProcessesAssets    MonitorClassOverride[]     @relation("ClassOverrideProcessesCred")
  classOverrideEventLogAssets     MonitorClassOverride[]     @relation("ClassOverrideEventLogCred")
  // Back-relation for the Polaris Agent install credential (one per
  // ManagedAgent row). SetNull on credential delete so removing a
  // credential doesn't block a stuck agent install — operator falls
  // back to DELETE /assets/:id/agent?force=true in that case.
  managedAgents                   ManagedAgent[]             @relation("AgentInstallCredential")

  @@index([type])
  @@index([createdBy])
  @@map("credentials")
}

// (class + integration) tier of the monitoring settings hierarchy. Each row
// overrides a subset of fields for assets of `assetType` that are scoped to
// `integrationId`. Null `integrationId` represents an override applied to
// "manual" assets — those whose `discoveredByIntegrationId` is null (e.g.
// hand-created assets, or assets whose origin integration was deleted).
//
// Resolution order at probe time:
//   asset override → MonitorClassOverride → Integration.config.monitorSettings
//                                          OR Setting "manualMonitorSettings"
//
// Every settings field is nullable: null = inherit from the tier below.
// Range / sanity validation lives in the route layer (Zod schemas) so the DB
// only enforces shape and uniqueness.
//
// Uniqueness: Postgres treats NULLs as distinct in unique constraints, so the
// `(integrationId, assetType)` index alone won't prevent two `(null, "switch")`
// rows. The service layer enforces uniqueness for the manual-tier case before
// insert. The DB-side index still prevents duplicates within a single
// integration, which is the common case.
model MonitorClassOverride {
  id                            String       @id @default(uuid())
  integrationId                 String? // null = override applies to manual-tier (orphan) assets
  integration                   Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  assetType                     String // matches Asset.assetType — "firewall" | "switch" | "access_point" | "server" | "workstation" | "router" | "printer" | "other"
  intervalSeconds               Int?
  failureThreshold              Int?
  // Fast-confirm re-probe spacing (seconds) while a failure/recovery run is
  // being confirmed — business rule 30. null = inherit. 5..300; the resolver
  // floors it at the probe timeout and the probe loop's own tick.
  fastConfirmIntervalSec        Int?
  probeTimeoutMs                Int?
  // Per-request timeout (ms) for the CPU+memory collector. 1000..120000;
  // null = inherit from the tier below. Applied to FortiOS REST + SNMP
  // session timeouts in collectCpuMemory.
  cpuMemoryTimeoutMs            Int?
  // Per-request timeout (ms) for the temperature collector. 1000..120000;
  // null = inherit. Applied to FortiOS REST + SNMP session timeouts in
  // collectTemperature (ENTITY-SENSOR-MIB walk + the FortiAP scalar
  // fallback).
  temperatureTimeoutMs          Int?
  // Per-request timeout (ms) for the interface / storage / LLDP collector.
  // 1000..120000; null = inherit. Applied to FortiOS REST + SNMP sessions in
  // collectSystemInfo + collectFastFiltered.
  systemInfoTimeoutMs           Int?
  cpuMemoryIntervalSeconds      Int?
  temperatureIntervalSeconds    Int?
  systemInfoIntervalSeconds     Int?
  // Custom-widget cadence (Slice 7) — drives ManufacturerCustomWidget probes
  // for assets whose manufacturer has at least one widget defined. Default
  // 60s when null at every tier.
  customWidgetIntervalSeconds   Int?
  // Custom-widget per-request timeout (ms). null = inherit.
  customWidgetTimeoutMs         Int?
  // Cross-transport process / event-log cadences + timeouts. null = inherit.
  processesIntervalSeconds      Int?
  eventLogIntervalSeconds       Int?
  processesTimeoutMs            Int?
  eventLogTimeoutMs             Int?
  // ─── Legacy retention columns (single-tier) ─────────────────────────────
  // Phase 1 keeps these alongside the new detail/hourly/daily columns so the
  // resolver + prune layer keep working unchanged until the tier-aware
  // pruning lands. migrateRetentionTiers seeds the corresponding
  // *DetailRetentionDays from these values on first boot. Dropped in a
  // follow-up release once fleet-wide migration is confirmed.
  sampleRetentionDays           Int?
  // Single retention setting shared by AssetTelemetrySample (CPU/memory)
  // AND AssetHardwareSensorSample. The stream split only affects polling
  // method / cadence / credential / MIB / timeout — sample retention is
  // table-level, so one knob covers both.
  telemetryRetentionDays        Int?
  systemInfoRetentionDays       Int?
  // ─── Tiered retention columns (detail / hourly / daily) ─────────────────
  // Three retention windows per stream — detail (raw samples), hourly
  // (sampleRollup hourly aggregates), daily (sampleRollup daily aggregates).
  // null = inherit from the tier below. Defaults at the manual/integration
  // tier are 7 / 30 / 365 (Phase 1 introduces; phases 2+ start consuming).
  sampleDetailRetentionDays     Int?
  sampleHourlyRetentionDays     Int?
  sampleDailyRetentionDays      Int?
  telemetryDetailRetentionDays  Int?
  telemetryHourlyRetentionDays  Int?
  telemetryDailyRetentionDays   Int?
  systemInfoDetailRetentionDays Int?
  systemInfoHourlyRetentionDays Int?
  systemInfoDailyRetentionDays  Int?
  // Per-stream polling-method overrides. null = inherit from the integration
  // tier (or the manual tier when integrationId is null). Accepted values:
  // "rest_api" | "snmp" | "winrm" | "ssh" | "icmp". The compatibility-aware
  // resolver silently falls through when the chosen method isn't valid for
  // the asset's source — see polaris-monitoring-discovery -> polling-methods-streams.md.
  responseTimePolling           String?
  cpuMemoryPolling              String?
  temperaturePolling            String?
  interfacesPolling             String?
  lldpPolling                   String?
  storagePolling                String?
  customWidgetPolling           String?
  // Cross-transport streams (agent / SNMP / SSH / WinRM / REST). See
  // utils/pollingCompatibility STREAM_METHODS for the per-stream method set.
  processesPolling              String?
  eventLogPolling               String?
  // Per-stream credential overrides (FK to Credential, null = inherit)
  responseTimeCredentialId      String?
  responseTimeCredential        Credential?  @relation("ClassOverrideRTCred", fields: [responseTimeCredentialId], references: [id], onDelete: SetNull)
  cpuMemoryCredentialId         String?
  cpuMemoryCredential           Credential?  @relation("ClassOverrideCpuMemCred", fields: [cpuMemoryCredentialId], references: [id], onDelete: SetNull)
  temperatureCredentialId       String?
  temperatureCredential         Credential?  @relation("ClassOverrideTempCred", fields: [temperatureCredentialId], references: [id], onDelete: SetNull)
  interfacesCredentialId        String?
  interfacesCredential          Credential?  @relation("ClassOverrideIfCred", fields: [interfacesCredentialId], references: [id], onDelete: SetNull)
  lldpCredentialId              String?
  lldpCredential                Credential?  @relation("ClassOverrideLldpCred", fields: [lldpCredentialId], references: [id], onDelete: SetNull)
  customWidgetCredentialId      String?
  customWidgetCredential        Credential?  @relation("ClassOverrideCustomWidgetCred", fields: [customWidgetCredentialId], references: [id], onDelete: SetNull)
  processesCredentialId         String?
  processesCredential           Credential?  @relation("ClassOverrideProcessesCred", fields: [processesCredentialId], references: [id], onDelete: SetNull)
  eventLogCredentialId          String?
  eventLogCredential            Credential?  @relation("ClassOverrideEventLogCred", fields: [eventLogCredentialId], references: [id], onDelete: SetNull)
  // Per-stream MIB overrides (String: "std:<key>" or uploaded MIB UUID or null)
  responseTimeMibId             String?
  cpuMemoryMibId                String?
  temperatureMibId              String?
  interfacesMibId               String?
  lldpMibId                     String?
  processesMibId                String?
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt

  @@unique([integrationId, assetType])
  @@index([assetType])
  @@map("monitor_class_overrides")
}

model Event {
  id           String   @id @default(uuid())
  timestamp    DateTime @default(now())
  level        String   @default("info") // info, warning, error
  // Numeric severity, stamped at write time from `level`:
  //   0=info, 1=warning, 2=error (room for -1=debug / 3=critical later).
  // The frontend renders `level`; sortBy=level on the list endpoint
  // dispatches to orderBy: { levelRank } so severity sort matches operator
  // expectations rather than alphabetical (error < info < warning).
  levelRank    Int      @default(0)
  action       String // e.g. "block.created", "integration.discover.started"
  resourceType String? // e.g. "block", "subnet", "integration"
  resourceId   String?
  resourceName String?
  actor        String? // username that triggered the event
  message      String   @db.Text
  details      Json? // Optional extra context (error stack, diff, etc.)

  @@index([timestamp])
  @@index([action])
  @@index([resourceType])
  @@index([level])
  @@index([levelRank, timestamp])
  @@index([actor, timestamp])
  @@index([resourceName, timestamp])
  @@map("events")
}

enum AssetStatus {
  active
  maintenance
  decommissioned
  storage
  disabled
  quarantined
}

// AssetType enum was retired in the asset-type registry cutover
// (migration 20260520000000_asset_types_table_cutover). Asset.assetType
// is now a free-form `String` validated at write time against the
// `AssetTypeDef` registry. The eight historical enum values are seeded
// as `isBuiltIn=true` AssetTypeDef rows so behavior matches pre-cutover
// for installs that never add custom types. Code that branches on
// `assetType === "firewall" | "switch" | "access_point"` (dependency
// tree, fortinetTopology, polling source defaults, topology rendering,
// inferAssetTypeFromOs) only special-cases the eight built-ins —
// custom types fall through to "other"-like generic behavior by design.
// See AssetTypeDef in polaris-domain-model -> assets-core.md.

model Asset {
  id                    String      @id @default(uuid())
  ipAddress             String? // IPv4 or IPv6
  ipSource              String? // Where ipAddress was last set from: "manual", "fortimanager", "fortigate", etc.
  // Operator IP override (pin) — hostnameOverride-style, with one twist:
  // discovery gets a vote. When set, this value IS the effective ipAddress
  // (the assets PUT handler writes both fields, and the Prisma extension in
  // src/db.ts intercepts any later write staging `ipAddress` without touching
  // `ipOverride`). When a discovery write stages an IP EQUAL to the override,
  // the override is released (self-disabling — discovery agrees, the pin is
  // no longer needed); when it stages a DIFFERENT IP, the write is re-asserted
  // back to the override and a pending Conflict (entityType="asset",
  // proposedAssetFields.collisionReason="ip-override") is raised — accept
  // takes the discovered IP and releases the pin, reject keeps the override
  // (the same discovered IP won't re-raise). Cleared by blanking the IP
  // Address field in the edit form — ipAddress then reverts to the
  // discovery-projected value. See src/services/ipOverrideService.ts.
  ipOverride            String?
  macAddress            String? // Most recently seen MAC, e.g. "AA:BB:CC:DD:EE:FF"
  hostname              String?
  // Operator hostname override (pin) — coordSource-style. When set, this value
  // IS the effective hostname: the assets PUT handler writes both fields, and
  // the Prisma extension in src/db.ts re-asserts it over any later write that
  // sets `hostname` without touching `hostnameOverride` (i.e. every discovery
  // projection write). Cleared by saving an empty Hostname in the edit form —
  // hostname then reverts to the discovery-projected value. Overridden assets
  // are excluded from the duplicate-hostname ghost merge and from hostname
  // projection-drift logging.
  hostnameOverride      String?
  dnsName               String? // FQDN from PTR lookup, e.g. "server01.corp.local"
  dnsNameFetchedAt      DateTime? // When the last PTR lookup ran (success or failure)
  dnsNameTtl            Int? // TTL (seconds) from the PTR record; null = unknown (standard mode)
  assetTag              String?     @unique // Internal tracking tag, e.g. "ACME-00421"
  serialNumber          String?
  manufacturer          String?
  model                 String?
  assetType             String      @default("other") // validated against AssetTypeDef registry at write time
  status                AssetStatus @default(active)
  statusChangedAt       DateTime? // When status was last changed
  statusChangedBy       String? // Who/what changed it: username, integration name, or "system"
  location              String? // User-set location (overrides learnedLocation)
  learnedLocation       String? // Auto-discovered from DHCP (FortiGate name)
  department            String? // Owning department or team
  assignedTo            String? // Person or team responsible
  os                    String? // Operating system
  osVersion             String? // OS or firmware version
  lastSeenSwitch        String? // FortiSwitch name/port, e.g. "FS-248E-01/port15"
  lastSeenAp            String? // FortiAP name, e.g. "FAP-431F-01"
  // Last time Polaris had direct evidence the device was alive on the
  // network. Written exclusively through bumpLastSeen() in
  // src/utils/assetInvariants.ts (no-regress: only advances, never moves
  // backward). Evidence sources: live DHCP lease, FortiGate device-inventory
  // sighting (device-reported timestamp, not discovery-run time), connected
  // FortiSwitch/FortiAP, firewall answering discovery, agent heartbeat,
  // successful monitor probe, or the AD/Entra presence-verification ping.
  // Directory activity timestamps (Entra lastSyncDateTime, AD
  // lastLogonTimestamp) do NOT write this field — they live in the
  // AssetSource.observed blobs and are surfaced separately in the UI.
  lastSeen              DateTime? // Most recent verified network-presence evidence
  // Provenance label for the evidence that produced the current lastSeen
  // value — stamped by bumpLastSeen alongside every advance. Values:
  // "dhcp-lease" | "device-inventory" | "discovery" | "agent" | "probe" |
  // "ping" | "conflict-accept" (open set; UI renders verbatim).
  lastSeenSource        String?
  associatedUsers       Json?       @default("[]") // [{user, domain?, lastSeen, source?}] — logged-in / registered users
  latitude              Float? // Geo coordinate (decimal degrees). Discovery-populated on FortiGate firewalls (from `config system global` / metavars / geocoded sysLocation) OR operator-typed via the asset edit form (any asset type).
  longitude             Float? // Geo coordinate (decimal degrees)
  // Provenance of latitude/longitude: "manual" = operator-typed via the asset
  // edit form — discovery must NOT overwrite (syncDhcpSubnets skips the
  // projected coord write, projectionDriftService skips lat/long drift).
  // null = discovery-owned (or unset). Clearing manual coords resets to null
  // so discovery may repopulate on the next cycle.
  coordSource           String?
  // Raw SNMP sysLocation (OID 1.3.6.1.2.1.1.6.0) pulled during FMG/standalone
  // FortiGate discovery when `fortigateMonitor.pullSnmpLocation` is enabled
  // on the originating integration. Captured independently of whether
  // geocoding produced usable coords — operators see what the FortiGate is
  // telling SNMP even when the geocoder couldn't resolve it. Surfaced on the
  // asset details General tab. The geocoded fallback for `latitude`/`longitude`
  // only runs when the CMDB `gui-device-*` values are missing or malformed
  // (null / NaN / (0,0) / out-of-range) — see syncDhcpSubnets Phase 11.5.
  snmpLocation          String?
  snmpLocationFetchedAt DateTime?
  // Auto-discovered street address. Populated on firewall assets from the FMG
  // per-device address metavariable named by the originating integration's
  // `fortigateMonitor.addressMetavar` (FMG-only, opt-in). Distinct from
  // `learnedLocation` (a site/controller label) and `snmpLocation` (raw SNMP
  // sysLocation string). Surfaced as "Address" on the asset details General tab.
  learnedAddress        String?
  fortinetTopology      Json? // { role: "fortigate" | "fortiswitch" | "fortiap", deviceName?, controllerFortigate?, uplinkInterface?, parentSwitch?, parentPort?, parentVlan? } — real connection graph from FMG/FortiGate discovery. deviceName (firewall role) = FMG/dvmdb device name for device-targeted write paths (description sync)
  // Current-state virtualization facts from vCenter discovery (single writer:
  // syncVcenterDevices; fortinetTopology precedent — refreshed in full every
  // discovery cycle). Two role-discriminated shapes:
  //   { role:"vm",   vcenterIntegrationId, vmMoref, instanceUuid?, biosUuid?,
  //     hostMoref, hostAssetId?, hostName?, clusterMoref?, clusterName?,
  //     standaloneHost, powerState, toolsRunState?, toolsVersionStatus?,
  //     guestOsFullName?, cpuCount?, memoryMiB?, cpuUsageMhz?, cpuMaxMhz?,
  //     memUsedBytes?, disks:[{key,label,capacityBytes,datastoreMoref?,datastoreName?}],
  //     guestFilesystems:[{path,capacityBytes,freeBytes}]|null }
  //   { role:"host", vcenterIntegrationId, hostMoref, clusterMoref?, clusterName?,
  //     standalone, connectionState, powerState, datastoreMorefs:[...] }
  // Usage fields on the vm shape are a discovery-time snapshot; live per-minute
  // figures ride the cpuMemory telemetry stream (polling method "vcenter").
  // hostAssetId is re-resolved every cycle so vMotion staleness self-heals.
  virtualization        Json?
  acquiredAt            DateTime? // Acquisition / purchase date
  warrantyExpiry        DateTime? // Warranty end date
  purchaseOrder         String? // PO or invoice reference
  notes                 String?     @db.Text
  // Operator-owned device description. When the originating integration's
  // `syncDescriptions` toggle is on (FMG / standalone FortiGate), this field
  // is description-synced with the device — POLARIS-PRIMARY: a non-empty
  // value here always wins (pushed on save, re-asserted over device-side
  // edits by every reconcile); an empty value adopts the device's. Device-
  // side write target depends on fortinetTopology.role: fortigate →
  // system/global `alias`, fortiswitch → managed-switch `description`,
  // fortiap → wtp `location` (AP Manager's field). See descriptionSyncService.
  description           String?     @db.VarChar(255)
  // Device-level description sync state:
  //   { status: "synced"|"failed", at: ISO timestamp,
  //     value?: string|null,  // last synced value (FMG-mirror bookkeeping)
  //     error?: string,        // failed-push detail
  //   }. Null = never synced / sync not enabled. status="conflict" (+ device/
  // polaris keys) appears only on legacy rows from the retired newest-wins
  // engine and resolves on the next reconcile. JSON-blob precedent:
  // quarantineTargets.
  descriptionSync       Json?
  tags                  String[]    @default([])
  createdBy             String?

  // Stamped during discovery so the Monitoring tab can display the
  // originating integration's name and lock it for FMG/FortiGate-discovered
  // firewalls. Null for manually-created assets.
  discoveredByIntegrationId String?
  discoveredByIntegration   Integration? @relation(fields: [discoveredByIntegrationId], references: [id], onDelete: SetNull)

  // Monitoring. `monitored` toggles whether the monitor job probes this
  // asset. The polling method per stream is resolved through the four-tier
  // hierarchy (per-asset *Polling overrides → MonitorClassOverride →
  // Integration.config.monitorSettings.polling | manualMonitorSettings →
  // source default). `monitorCredentialId` points at a Credential row used
  // by polling methods that need authentication (snmp/winrm/ssh/restapi);
  // FMG/FortiGate-discovered firewalls fall back to the discovering
  // integration's stored API token / SNMP credential when this is null.
  monitored                Boolean     @default(false)
  // True when the operator's current `monitored` choice diverges from the
  // discovering integration's per-class `addAsMonitored` flag. Discovery
  // sweeps `monitored` to match `addAsMonitored` on every cycle EXCEPT when
  // this flag is true — the override is what protects an explicit operator
  // choice from being clobbered. Auto-clears the moment the operator's
  // choice converges back to the integration's flag (either side moving
  // satisfies the equality). Stays false for assets with no
  // `discoveredByIntegrationId` (manually-created assets have nothing to
  // override). Maintained on every operator write to `monitored`
  // (PUT /assets/:id, POST /assets/bulk-monitor, Status pill toggle) and
  // every integration save where `addAsMonitored` changes (transactional
  // sweep across affected assets so the UI pill state is never stale).
  // Replaces the legacy `monitoredOperatorSet` field which was a one-way
  // "operator ever touched this" flag that couldn't model convergence.
  monitorOverride          Boolean     @default(false)
  monitorCredentialId      String?
  monitorCredential        Credential? @relation("AssetMonitorCred", fields: [monitorCredentialId], references: [id], onDelete: SetNull)
  responseTimeCredentialId String?
  responseTimeCredential   Credential? @relation("AssetRTCred", fields: [responseTimeCredentialId], references: [id], onDelete: SetNull)
  cpuMemoryCredentialId    String?
  cpuMemoryCredential      Credential? @relation("AssetCpuMemCred", fields: [cpuMemoryCredentialId], references: [id], onDelete: SetNull)
  temperatureCredentialId  String?
  temperatureCredential    Credential? @relation("AssetTempCred", fields: [temperatureCredentialId], references: [id], onDelete: SetNull)
  interfacesCredentialId   String?
  interfacesCredential     Credential? @relation("AssetInterfacesCred", fields: [interfacesCredentialId], references: [id], onDelete: SetNull)
  lldpCredentialId         String?
  lldpCredential           Credential? @relation("AssetLldpCred", fields: [lldpCredentialId], references: [id], onDelete: SetNull)
  customWidgetCredentialId String?
  customWidgetCredential   Credential? @relation("AssetCustomWidgetCred", fields: [customWidgetCredentialId], references: [id], onDelete: SetNull)
  processesCredentialId    String?
  processesCredential      Credential? @relation("AssetProcessesCred", fields: [processesCredentialId], references: [id], onDelete: SetNull)
  eventLogCredentialId     String?
  eventLogCredential       Credential? @relation("AssetEventLogCred", fields: [eventLogCredentialId], references: [id], onDelete: SetNull)
  // Per-stream MIB overrides (String: "std:<key>" or uploaded MIB UUID or null)
  responseTimeMibId        String?
  cpuMemoryMibId           String?
  temperatureMibId         String?
  interfacesMibId          String?
  lldpMibId                String?
  processesMibId           String?
  monitorIntervalSec       Int? // Per-asset override for response-time probes; falls back to the resolved tier-3 setting
  // Per-asset override for the probe TCP/UDP/HTTP timeout in milliseconds.
  // Range 100..60000; null = inherit from the resolved tier-3 setting (default 5000ms).
  // Below 500ms the UI shows a warning icon — at that range probes start to
  // false-fail on healthy networks under transient latency.
  probeTimeoutMs           Int?
  // Per-asset override for the CPU+memory collector request timeout (ms).
  // Range 1000..120000; null = inherit. Applied to FortiOS REST + SNMP sessions
  // inside collectCpuMemory.
  cpuMemoryTimeoutMs       Int?
  // Per-asset override for the temperature collector request timeout (ms).
  // Range 1000..120000; null = inherit. Applied to FortiOS REST + SNMP sessions
  // inside collectTemperature (ENTITY-SENSOR-MIB walk + FortiAP scalar
  // fallback).
  temperatureTimeoutMs     Int?
  // Per-asset override for the interface / storage / LLDP collector request
  // timeout (ms). Range 1000..120000; null = inherit. Applied to FortiOS REST +
  // SNMP sessions inside collectSystemInfo + collectFastFiltered.
  systemInfoTimeoutMs      Int?
  // Per-asset override for the custom-widget collector request timeout (ms).
  // Range 1000..120000; null = inherit.
  customWidgetTimeoutMs    Int?
  monitorStatus            String? // "up" | "warning" | "recovering" | "down" | "unknown"
  // Bumped whenever monitorStatus changes value (any transition, not just
  // up<->down). Drives the "how long has this been warning/down" duration on
  // the Dashboard's Monitor Alerts card. Null until the first transition.
  monitorStatusChangedAt   DateTime?
  // The first successful probe that ended the last outage — the moment
  // monitorStatus left "down"/"unknown" for "recovering" (or straight to "up"
  // when failureThreshold is 1). NOT stamped on a warning->up recovery, which
  // is the whole point: it is the packet-loss ratio's second anchor (business
  // rule 29b). probeLossQuery measures loss from GREATEST(first success in the
  // window, this stamp), so an outage that ended mid-window leaves the
  // denominator even when the window ALSO holds healthy samples from before it
  // — the case the first-success anchor cannot see, because that first success
  // sits before the outage. Flapping is untouched: a warning->up device never
  // stamps, so its whole window still counts. Written only by
  // recordProbeResult (through probePatchBuffer); never cleared — it ages out
  // of the window on its own and the next outage's recovery overwrites it.
  recoveryStartedAt        DateTime?
  lastMonitorAt            DateTime?
  // Cadence anchor for the ICMP packet-loss sampler (utils/lossSampler.ts) —
  // the 10s side-probe that runs ONLY while monitorStatus is "warning" or
  // "recovering", to give probeLossPct more than a handful of samples to
  // divide. Deliberately its own column rather than reusing lastMonitorAt:
  // the sampler must not disturb the response-time poll's own due-check, and
  // it never calls recordProbeResult (so it cannot move the counters or
  // monitorStatus). Stamped on every attempt, success or failure, so a
  // ping-blocked host can't be re-queued every tick. Null = never sampled.
  lastLossSampleAt         DateTime?
  lastResponseTimeMs       Int?
  // Last device-uptime reading (whole seconds) captured on the probe path,
  // and the timestamp Polaris last detected that reading decrease (a reboot).
  // Captured from SNMP sysUpTime, FortiOS system status, and the Polaris
  // Agent (host.Uptime via the responseTime stream). lastUptimeSec is
  // compared against the next probe's reading in recordProbeResult; a
  // decrease stamps lastRebootAt=now and emits a device.reboot Event. Both
  // null for assets whose probe transport never reports uptime
  // (ICMP/SSH/WinRM). The System-tab Uptime row renders the live value
  // (lastUptimeSec + elapsed since lastMonitorAt) + the lastRebootAt "since".
  lastUptimeSec            Int?
  lastRebootAt             DateTime?
  consecutiveFailures      Int         @default(0)
  // Counts probe successes since the last failure; reset to 0 on any failure.
  // It stopped driving the warning -> up transition when the counter became a
  // leaky bucket (business rule 30) — the bucket's own level decides that now.
  // Its one remaining verdict is the RECOVERY CONFIRMATION RUN: when the
  // covering down automation's reset asks for more answered polls than the
  // drain provides, the asset holds in `recovering` until this reaches that
  // count (business rule 36, `owesRecoveryConfirmation`). Still charted, and
  // still a true fact about the device either way.
  consecutiveSuccesses     Int         @default(0)
  // Does the asset owe its covering automation a confirmation run — i.e. has
  // it read `down` since it last read `up`?
  //
  // The one bit of memory the two counters cannot reconstruct. At cf 0 a
  // success run of N is ambiguous: either a bucket that drained from N, or a
  // healthy device that has simply answered N times — and the confirmation
  // hold must apply to the first and never to the second. Inferring it from
  // `consecutiveSuccesses >= threshold` turns every blip on a healthy device
  // into two amber cells; inferring it from the previous status loses the
  // memory the moment a mid-run miss parks the asset in `warning`.
  //
  // Set when the machine reaches `down`, cleared when it reaches `up`, written
  // in the same probe patch as the counters (no extra query). False on every
  // pre-2026-08-29 row, which is correct: an asset mid-outage at upgrade time
  // recovers on the drain the way it always did, and its next `down` arms it.
  awaitingRecoveryConfirm  Boolean     @default(false)

  // Per-stream polling-method overrides. Each accepts the 5-way enum
  // "rest_api" | "snmp" | "winrm" | "ssh" | "icmp" or null (= inherit from
  // the class override / integration tier / source default). The resolver
  // in monitoringService applies the compatibility matrix from
  // utils/pollingCompatibility — values that don't match the asset's
  // source are silently ignored at resolution time.
  responseTimePolling String?
  cpuMemoryPolling    String?
  temperaturePolling  String?
  interfacesPolling   String?
  lldpPolling         String?
  storagePolling      String?
  // Cross-transport streams (agent / SNMP / SSH / WinRM / REST). null = inherit.
  // Per-stream method set enforced by utils/pollingCompatibility STREAM_METHODS.
  processesPolling    String?
  eventLogPolling     String?
  // Per-asset request path for the "http" response-time method, overriding the
  // `path` on the selected http Credential. The credential carries the SHAPE of
  // the check (scheme, port, expected status, expected body, auth) so one row
  // covers a fleet; this is the escape hatch for the device whose health
  // endpoint lives somewhere else. null / "" = no override (use the
  // credential's path) — NOT "/", so blanking the field returns the device to
  // the credential rather than silently repointing it at the web root. Only
  // read when responseTimePolling resolves to "http"; see utils/httpCheck.ts
  // resolveHttpTarget, the single resolution point.
  httpCheckPath       String?
  // Slice 7 — custom-widget cadence. When the asset's manufacturer has at
  // least one ManufacturerCustomWidget AND this resolves to a non-"disabled"
  // method, collectCustomWidgets fires on the heavy loop. Compatible methods:
  // rest_api | snmp (same set used by telemetry). "disabled" suppresses the
  // probe even when widgets exist for the manufacturer.
  customWidgetPolling String?

  // System tab cadences. CPU/memory and temperature each ride their own
  // cadence — operators can poll CPU/memory every minute via REST while
  // temperature scrapes every five minutes via SNMP, etc. System info = full
  // interface + storage scrape, taken once per ten minutes by default.
  // The per-asset *IntervalSec columns override the global setting when non-null.
  cpuMemoryIntervalSec    Int?
  temperatureIntervalSec  Int?
  systemInfoIntervalSec   Int?
  // Phase 2 carve-out: LLDP + Storage run on independent cadences (their own
  // pg-boss queues — polaris-monitor-lldp / polaris-monitor-storage) rather
  // than riding systemInfo. null = inherit from the resolved tier.
  lldpIntervalSec         Int?
  storageIntervalSec      Int?
  // Slice 7 — per-asset custom-widget probe cadence (seconds). null = inherit.
  customWidgetIntervalSec Int?
  // Cross-transport process / event-log cadences (seconds) + request timeouts
  // (ms). null = inherit. For agent assets these mirror the agent loop intervals;
  // for SNMP/SSH/WinRM/REST they bound the agentless poll cadence.
  processesIntervalSec    Int?
  eventLogIntervalSec     Int?
  processesTimeoutMs      Int?
  eventLogTimeoutMs       Int?
  // What the device calls ITSELF, in the vendor's own words ("Network
  // Camera") — parsed from a documented sysDescr layout and projected from the
  // `snmp-sysdescr` AssetSource. Not a type: it is the FACT a device-type rule
  // matches on (utils/assetTypeMatch.ts MATCH_FIELDS), which is what lets one
  // rule type a camera fleet instead of a regex over the whole sysDescr.
  productType             String?
  lastTelemetryAt         DateTime?
  lastSystemInfoAt        DateTime?
  // Cadence anchor for the sysDescr identity read (the `snmp-sysdescr`
  // AssetSource). Stamped by BOTH readers — the SNMP response-time probe,
  // which carries sysDescr as one extra varbind when this says the reading is
  // due, and the system-info pass, which reads it anyway — so whichever runs
  // first satisfies the other. NULL = never read, i.e. due now.
  lastDescrAt             DateTime?
  // Management-access summary read during discovery for Fortinet devices:
  // { source, interfaceName, profileName, mgmtIp, protocols: string[],
  //   https, ssh, snmp, checkedAt }. Drives the asset slide-over's Open HTTPS /
  //   Open SSH buttons and the FortiAP "SNMP not enabled in profile" warning.
  // Monitor/discovery-owned (like lastSystemInfoAt), never projected from AssetSource.
  managementAccess        Json?
  // Per-cadence last-touched stamps for the LLDP + Storage queues. Bumped by
  // runLldpFor / runStorageFor on every successful pass; publisher reads them
  // to decide when the next job is due.
  lastLldpAt              DateTime?
  lastStorageAt           DateTime?
  // Agentless (ssh/winrm) processes-stream cadence anchors, same model as
  // lastLldpAt/lastStorageAt: lastProcessesAt gates the full inventory pass
  // (processesIntervalSec, default 600s); lastProcessPinsAt gates the 60s
  // pinned/mapped sub-pass (cpu/mem telemetry for monitoredProcesses +
  // connection rows for mappedProcesses). Agent-mode assets never use these —
  // the agent runs its own loops. Stamped even on failure so a bad credential
  // can't retrigger every heavy tick (AD-lockout / fail2ban exposure).
  lastProcessesAt         DateTime?
  lastProcessPinsAt       DateTime?
  // Agentless (ssh/winrm) event-log cadence anchor. Same model and the same
  // stamped-even-on-failure rule as lastProcessesAt — an agentless stream that
  // re-fires on every tick against a bad credential is an AD-lockout risk, and
  // the event log is the one stream where a retry storm also floods the audit
  // table it writes into. Agent-mode assets never use it (the agent runs its
  // own loop and pushes to POST /agents/samples).
  lastEventLogAt          DateTime?
  // Bumped after every successful collectCustomWidgets pass.
  lastCustomWidgetAt      DateTime?

  // ifNames the operator pinned for fast-cadence polling. Each name in this
  // array is also scraped on the response-time interval (default 60s) so that
  // chosen uplinks/critical ports get sub-minute throughput + error history.
  // The full system-info scrape (every ~10 min) still covers all interfaces.
  monitoredInterfaces String[] @default([])

  // Storage mountPaths pinned for fast-cadence polling. Same model as
  // monitoredInterfaces — the response-time tick re-walks just these
  // hrStorage rows so the operator gets sub-minute disk-usage history for
  // chosen volumes without re-walking the full storage table.
  monitoredStorage String[] @default([])

  // Phase-1 tunnel names pinned for fast-cadence IPsec polling. The full
  // /api/v2/monitor/vpn/ipsec endpoint can be slow on busy gateways so it
  // is not re-walked every minute by default; pinning a tunnel here issues
  // a targeted scrape that filters down to just that phase-1.
  monitoredIpsecTunnels String[] @default([])

  // Process names (the AssetProcess.name key — program/exe, aggregated across
  // PIDs) the operator pinned for per-minute CPU/RAM telemetry + log tailing.
  // Drives the Processes-tab "Monitor" checkbox + the processTelemetry/processLog
  // agent streams (Feature C).
  monitoredProcesses String[] @default([])

  // Process names flagged for future alerting/notifications (the Processes-tab
  // "Alert" checkbox). Storage-only for now — the alerting consumer lands with
  // the notifications feature; pinning here just persists operator intent.
  alertWatchedProcesses String[] @default([])

  // Process names toggled for Application Map connection discovery (the
  // Processes-tab "Map" checkbox). Independent of monitoredProcesses — a
  // mapped-only process gets listening-port / connection collection but no
  // cpu/mem telemetry or log tailing, and vice versa. Drives the agent's
  // processConnections stream + the agentless 60s pinned/mapped sub-pass;
  // rows land in AssetProcessConnection (accumulate + age).
  mappedProcesses String[] @default([])

  // Service (systemd unit / Windows service) pins — the Services-tab siblings of
  // monitoredProcesses / mappedProcesses, keyed by UNIT name. monitoredServices
  // drives per-unit journalctl/log tailing (the serviceLog agent stream);
  // mappedServices drives per-unit connection attribution on the Application Map
  // (stamped onto AssetProcessConnection.unit). Both shipped to the agent via
  // GET /agents/config.
  monitoredServices String[] @default([])
  mappedServices    String[] @default([])

  // Quarantine. When non-null the asset is currently quarantined on one or
  // more FortiGates (per quarantineTargets). statusBeforeQuarantine stores
  // the prior AssetStatus so release can pop it back; null pops to active.
  // quarantinedBy records the actor that initiated: "user:<username>" for a
  // session-auth caller, "api:<token-name>" for an API-token caller, or
  // "system:auto-quarantine" when the discovery sync auto-extends an existing
  // quarantine to a newly-sighted FortiGate.
  // quarantineTargets is a JSON array of per-FortiGate push records:
  //   [{ fortigateDevice, integrationId, pushedMacs: string[], pushedAt,
  //      status: "synced"|"failed"|"drift", error? }]
  // The asset's status is set to AssetStatus.quarantined on any successful
  // push (partial-across-fortigates is allowed; per-FortiGate is all-or-
  // nothing). Release best-efforts an unpush from each target before flipping
  // status back; per-target failure does not block the release.
  statusBeforeQuarantine    AssetStatus?
  // Parks `monitored` across the quarantine the same way
  // statusBeforeQuarantine parks the status. Quarantine is one of the statuses
  // that cannot be monitor-enabled (every probe fails by design — see
  // UNMONITORABLE_STATUSES), so the clamp in db.ts turns polling off on the
  // way in; without this column, releasing a quarantine would hand the device
  // back to the network with nobody watching it. null = the asset was not
  // monitored when it was quarantined (or predates this column), which pops
  // back to not-monitored either way.
  monitoredBeforeQuarantine Boolean?
  quarantineReason          String?      @db.Text
  quarantinedAt             DateTime?
  quarantinedBy             String?
  quarantineTargets         Json         @default("[]")

  // Dependency-aware monitoring suppression. dependencyLayer is the BFS
  // shortest-path distance from any FortiGate root (1 = FortiGate, 2 =
  // direct child switch/AP, 3+ = chained). dependencySuppressed is the
  // runtime flag set by the dependencyReconciler job when ALL of the
  // asset's effective parents are confirmed down (or themselves
  // suppressed). While suppressed, telemetry / systemInfo / fastFiltered
  // are skipped and the response-time probe runs at 2× the resolved
  // interval. See dependencyTreeService for the resolution rules.
  dependencyLayer        Int?
  dependencySuppressed   Boolean   @default(false)
  dependencySuppressedAt DateTime?

  // Admin-only "Dependency Test" simulation. When dependencyTestUntil is in
  // the future, the dependency reconciler treats THIS asset as if it were
  // confirmed down for the purposes of suppression — so children with this
  // asset in their effective parent set get marked dependencySuppressed
  // exactly as they would under a real outage. Real probes keep running and
  // updating monitorStatus / lastResponseTimeMs normally; the test is a
  // pure overlay that ends automatically at the timestamp. The reconciler
  // also auto-clears expired rows (sets dependencyTestUntil back to null).
  // Only admins can set or clear this — assets-admin and network-admin do
  // not have the privilege. See routes/assets.ts ":id/dependency-test".
  dependencyTestUntil     DateTime?
  dependencyTestStartedBy String?

  // Scheduler-managed maintenance mode. While one or more open
  // AssetMaintenanceWindow rows exist for the asset, the maintenanceScheduler
  // holds status="maintenance" and remembers the status to restore here
  // (mirrors statusBeforeQuarantine). null = not under scheduler management.
  // status="maintenance" stops all server-driven polling (monitor candidate
  // queries exclude it), makes the asset count as "down" for child dependency
  // suppression, and silences notifications. See maintenanceScheduleService.
  maintenanceReturnStatus AssetStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conflicts              Conflict[]
  ipHistory              AssetIpHistory[]
  fortigateSightings     AssetFortigateSighting[]
  interfaceOverrides     AssetInterfaceOverride[]
  // NOTE: the append-only sample/rollup time-series (AssetMonitorSample,
  // *InterfaceSample, the *Hourly/*Daily rollups, AssetCustomWidgetSample, etc.)
  // intentionally have NO relation to Asset and NO foreign key (dropped in
  // migration 20260615000000). They are TimescaleDB hypertables: a cascade
  // DELETE matching rows in a compressed chunk decompresses the whole chunk into
  // un-truncatable heap bloat (prod incident 2026-06-08). Deleting an Asset
  // leaves its sample rows orphaned (queried only by assetId, never via the
  // gone Asset) to age out via drop_chunks. They keep `assetId String` + an
  // @@index([assetId, ...]) for query perf. DON'T re-add @relation to them.
  lldpNeighbors          AssetLldpNeighbor[]      @relation("AssetLldpNeighbors")
  lldpNeighborMatches    AssetLldpNeighbor[]      @relation("AssetLldpNeighborMatch")
  // Wireless stations connected to this asset (when it's a FortiAP) and
  // back-link for endpoints matched to a station's MAC via the SNMP
  // fapStationTable scrape.
  wirelessStations       AssetWirelessStation[]   @relation("AssetWirelessStationsOnAp")
  wirelessStationMatches AssetWirelessStation[]   @relation("AssetWirelessStationMatch")
  // FortiAP radio + broadcast-SSID inventory (current-state, one row per
  // radio / per VAP). The parents of the wireless stations above.
  apRadios               AssetApRadio[]           @relation("AssetApRadios")
  apVaps                 AssetApVap[]             @relation("AssetApVaps")
  // MCLAG ICL peers (when this asset is a FortiSwitch in an MCLAG pair) and
  // the back-link for the switch on the far end of each ICL leg.
  mclagPeers             AssetMclagPeer[]         @relation("AssetMclagPeers")
  physicalEntities       AssetPhysicalEntity[]    @relation("AssetPhysicalEntities")
  // Current-state interface inventory (one row per ifName), delete-replaced per
  // full system-info scrape. The pinned-only time-series lives in
  // AssetInterfaceSample.
  interfaces             AssetInterface[]         @relation("AssetInterfaces")
  macTableEntries        AssetMacTableEntry[]     @relation("AssetMacTableEntries")
  macTableMatches        AssetMacTableEntry[]     @relation("AssetMacTableMatch")
  // Layer-3 neighbour cache (when this asset is a FortiGate firewall) and the
  // back-link for the endpoint each ARP row's MAC resolved to.
  arpEntries             AssetArpEntry[]          @relation("AssetArpEntries")
  arpMatches             AssetArpEntry[]          @relation("AssetArpMatch")

  trunkMembers       AssetTrunkMember[]       @relation("AssetTrunkMembers")
  trunkMemberMatches AssetTrunkMember[]       @relation("AssetTrunkMemberMatch")
  mclagPeerMatches   AssetMclagPeer[]         @relation("AssetMclagPeerMatch")
  mibFiles           MibFile[]                @relation("MibFilesOnAsset")
  sources            AssetSource[]
  associatedIpRows   AssetAssociatedIp[]
  macAddressRows     AssetMacAddress[]
  dependencyParents  AssetDependencyParent[]  @relation("AssetDependencyChild")
  dependencyChildren AssetDependencyParent[]  @relation("AssetDependencyParent")
  managedAgent       ManagedAgent?
  maintenanceWindows AssetMaintenanceWindow[]
  topologyLayouts    TopologyLayout[]
  processConnections AssetProcessConnection[]

  @@index([ipAddress])
  @@index([macAddress])
  @@index([hostname])
  @@index([assetType])
  @@index([status])
  @@index([department])
  @@index([serialNumber])
  @@index([dnsName])
  @@index([createdBy])
  @@index([discoveredByIntegrationId])
  @@index([monitored])
  @@index([monitored, lastMonitorAt])
  @@index([dependencySuppressed])
  // Server-side list ordering: createdAt is the default sort on every load;
  // lastSeen is a common "what's gone stale" sort. Indexed so the paged
  // ORDER BY ... LIMIT stays cheap as the fleet grows past a few thousand.
  @@index([createdAt])
  @@index([lastSeen])
  @@map("assets")
}

// Rolling time-series of monitoring probe results. One row per probe;
// `responseTimeMs` is null on failure (used as the "packet loss" signal).
model AssetMonitorSample {
  id              String   @default(uuid())
  assetId         String
  timestamp       DateTime @default(now())
  success         Boolean
  responseTimeMs  Int?
  error           String?  @db.Text
  // Which probe produced this row. NULL (and the literal "primary") = the
  // response-time poll on the asset's configured transport — the only rows that
  // may inform response-time figures. "icmp" = the packet-loss sampler
  // (utils/lossSampler.ts), whose RTTs are a DIFFERENT transport's and must
  // never enter the responseTimeMs series: ICMP answers in ~1-5ms where SNMP
  // takes 20-200ms, so mixing them would dent every response-time chart, shift
  // the hourly/daily avgResponseTimeMs rollups, and drag a "slow response time"
  // automation's reading down mid-incident. Loss (failed/total) counts EVERY
  // kind — that is the whole point of the sampler. Nullable rather than
  // defaulted so the add is free on the hypertable (the uptimeSec precedent);
  // readers must treat NULL as primary, never as unknown.
  probeKind       String?
  // PACKET ACCOUNTING for the ICMP burst sweep (utils/burstPing.ts) — the two
  // columns that make packet loss a ratio of PACKETS instead of a ratio of
  // poll OUTCOMES. A sweep row carries sent=N (the burst size) and
  // received=M; `success` stays M > 0 so every existing reader that only
  // knows about success/failure keeps working unchanged.
  //
  // NULL on every row the sweep did not write — the response-time poll's own
  // rows and everything written before this migration — and readers MUST
  // treat NULL as the single-probe equivalent (sent 1, received 1 on success
  // / 0 on failure) rather than as zero. Nullable with no default so the add
  // is catalog-only on the hypertable (the uptimeSec / dependencyDown
  // precedent): no chunk rewrite, no decompression.
  //
  // packetsSent is never 0. A target that could not be attempted at all
  // (unresolvable name, no pinger) writes NO ROW, because "we never asked" and
  // "we asked and heard nothing" are different facts and only the second is
  // loss — collapsing them would report a fleet-wide outage the moment DNS
  // broke.
  packetsSent     Int?
  packetsReceived Int?
  // Device sysUpTime at probe time, in whole seconds (SNMP probes only; null
  // for ICMP/TCP/REST probes that don't read sysUpTime). A decrease between
  // consecutive samples is the reboot signal — see Asset.lastRebootAt and the
  // device.reboot Event emitted by recordProbeResult. Nullable column added
  // post-hoc; safe on the TimescaleDB hypertable (no row rewrite).
  uptimeSec       Int?
  // TRUE on a FAILED probe recorded while the asset was dependency-suppressed
  // (`Asset.dependencySuppressed` — its parent was dark at probe time). The probe
  // still runs while suppressed, at half cadence (resolveProbeIntervalSec),
  // because the device may answer over a redundant path — but a failure here is
  // EXPLAINED: the upstream is down. The charts draw it grey instead of the red
  // dive that means "this device stopped answering and we don't know why".
  // NULL/false = an ordinary probe; never set on a success. Nullable rather than
  // defaulted so the add is free on the hypertable (the uptimeSec precedent);
  // readers must treat NULL as false, never as unknown.
  dependencyDown  Boolean?
  // TRUE on a FAILED probe recorded while the asset ITSELF was `down` — the
  // sibling of `dependencyDown`, and the one marker packet loss is measured
  // AROUND. A miss taken during a declared outage IS that outage; counting it
  // as packet loss raises a second alert about the thing the down automation
  // already owns, which is what trailed a "40 % loss" warning behind every
  // recovery (business rule 29h). Stamped from the status the probe RESULTS in
  // (monitorStatusFor), so the misses drawn amber — below the threshold, not an
  // outage yet — still count as loss and only the ones drawn as Down do not.
  // The ICMP burst sweep stamps it from the asset's CURRENT status instead: it
  // never calls recordProbeResult, so it has no verdict of its own to read.
  // NULL/false = an ordinary probe; never set on a success. Nullable rather than
  // defaulted so the add is free on the hypertable (the uptimeSec precedent);
  // readers must treat NULL as false, never as unknown.
  assetDown       Boolean?

  // Composite PK (id, timestamp) — required by TimescaleDB hypertables to
  // include the partitioning column. Works fine on plain Postgres too;
  // queries don't change.
  @@id([id, timestamp])
  @@index([assetId, timestamp])
  @@map("asset_monitor_samples")
}

// CPU and memory snapshot, written once per `monitor.telemetryIntervalSeconds`
// by the System tab cadence in monitorAssets. Only populated when the asset's
// monitor type can deliver these (FortiOS/SNMP/WinRM); ICMP/SSH yield nothing.
// `cpuPct` is a 0-100 percentage; memory is bytes (BigInt to avoid overflow on
// large servers).
model AssetTelemetrySample {
  id            String   @default(uuid())
  assetId       String
  timestamp     DateTime @default(now())
  cpuPct        Float?
  // memPct is populated when the source reports memory only as a percentage
  // (FortiOS); memUsedBytes / memTotalBytes are populated when the source
  // reports absolute bytes (SNMP HOST-RESOURCES-MIB, WMI). Either pair may
  // be present — the UI prefers bytes when both are available.
  memPct        Float?
  memUsedBytes  BigInt?
  memTotalBytes BigInt?
  // Active session count (FortiGate only — read from the same
  // /api/v2/monitor/system/resource/usage `session` resource the CPU/mem
  // collector already fetches). Null for every other source.
  sessionCount  Float?

  @@id([id, timestamp])
  @@index([assetId, timestamp])
  @@map("asset_telemetry_samples")
}

// Per-interface snapshot, written once per `monitor.systemInfoIntervalSeconds`.
// Many rows per scrape — one per interface returned by the device. inOctets /
// outOctets are cumulative SNMP/FortiOS counters; subtracting consecutive
// samples gives throughput for charting.
model AssetInterfaceSample {
  id             String   @default(uuid())
  assetId        String
  timestamp      DateTime @default(now())
  ifName         String
  adminStatus    String?
  operStatus     String?
  speedBps       BigInt?
  ipAddress      String?
  macAddress     String?
  inOctets       BigInt?
  outOctets      BigInt?
  // Cumulative error counters (IF-MIB ifInErrors / ifOutErrors, FortiOS
  // errors_in / errors_out). Subtract consecutive samples for an error rate.
  inErrors       BigInt?
  outErrors      BigInt?
  // Interface topology — populated by FortiOS REST path; SNMP sets ifType only.
  // ifType: "physical" | "aggregate" | "vlan" | "loopback" | "tunnel"
  // ifParent: aggregate name for member ports; parent interface name for VLANs
  // vlanId: 802.1Q VLAN ID for vlan-type interfaces
  ifType         String?
  ifParent       String?
  vlanId         Int?
  // Switch-port VLAN config — populated only on managed FortiSwitches via a
  // CMDB call to the parent FortiGate's
  // `/api/v2/cmdb/switch-controller/managed-switch?datasource=1`. nativeVlan
  // is the port's untagged PVID; taggedVlans is the resolved tagged-set
  // (allowed-vlans minus untagged-vlans), expanded to integer ids. Other
  // asset types and the SNMP-only path on non-Fortinet switches leave both
  // null/empty.
  nativeVlan     Int?
  taggedVlans    Int[]    @default([])
  // True when the FortiSwitch port has `set allowed-vlans all` — i.e. trunks
  // every VLAN on the switch. Operationally distinct from an access port
  // (taggedVlans=[]) AND from an explicit-list trunk (taggedVlans=[10,20]),
  // so it's a separate flag rather than a sentinel. Detected by reading the
  // CMDB port's `allowed-vlans-all` field (newer FortiOS) and falling back
  // to the string sentinel `"all"` in `allowed-vlans` on older versions.
  trunksAllVlans Boolean  @default(false)
  // Operator-set label that overrides ifName in the UI when present.
  // FortiOS CMDB `alias`; SNMP IF-MIB ifAlias (1.3.6.1.2.1.31.1.1.1.18).
  alias          String?
  // Operator-set free-text comment surfaced on the interface slide-over.
  // FortiOS CMDB `description`; SNMP has no equivalent and leaves this null.
  description    String?
  // L3 addressing mode of the interface: "static" | "dhcp" | "pppoe".
  // FortiOS CMDB `system/interface.mode`; SNMP / Polaris Agent have no
  // equivalent and leave this null (rendered as "—" in the UI, like the
  // FortiSwitch-only VLAN columns). Config metadata — shown only in the live
  // System-tab snapshot, not rolled up.
  addressingMode String?
  // Power over Ethernet, from POWER-ETHERNET-MIB (RFC 3621) via SNMP only.
  // FortiOS REST carries no equivalent in its interface payload, so a managed
  // FortiSwitch polled through its parent FortiGate leaves both null.
  //
  // poeStatus: pethPsePortDetectionStatus, decoded by utils/poePorts.ts —
  //   "disabled" | "searching" | "delivering" | "fault" | "test" | "other-fault".
  //   Also an asset_state automation field (see ASSET_STATE_FIELDS).
  // poeClass: pethPsePortPowerClassifications — "class0".."class4". A negotiated
  //   power BUDGET bracket ("up to 12.95 W at the PD" for class3), NOT a
  //   measurement: RFC 3621 defines no per-port wattage object at all.
  //
  // Both are correlated to ifName by inference (poeIfNameByIndex) because the
  // MIB provides no ifIndex join; unresolvable PoE rows are dropped rather than
  // attached to a best-guess interface.
  poeStatus      String?
  poeClass       String?
  // Cadence discriminator for selection-aware retention. "fast" = this row came
  // from the response-time re-walk of an operator-pinned interface
  // (monitoredInterfaces); "slow" = the full system-info scrape. NULL = legacy
  // rows written before this column existed — treated as "slow" everywhere.
  // Pinned/fast rows keep full retention + rollups; slow rows keep 24h, no rollup.
  cadence        String?

  @@id([id, timestamp])
  @@index([assetId, timestamp])
  @@index([assetId, ifName, timestamp])
  @@map("asset_interface_samples")
}

// CURRENT-STATE interface inventory -- one row per (asset, ifName), full-replaced
// per full system-info scrape by `persistInterfaces` (the AssetPhysicalEntity /
// AssetMacTableEntry delete-replace pattern).
//
// Why this exists rather than reading the newest AssetInterfaceSample rows: every
// all-interface consumer wants CURRENT STATE, not history. The System tab renders
// exactly one timestamp, and topology / auto-monitor / LLDP-name normalization all
// want "latest row per (assetId, ifName)" -- which against a hypertable is a
// DISTINCT ON that had to be time-bounded after it was measured at 13.5 minutes /
// 90M rows / 9 GB of I/O on prod. Against this table each of those is an indexed
// lookup over ~one row per interface.
//
// It is what lets the sample table carry ONLY operator-pinned interfaces: the
// unpinned rows existed solely to answer this current-state question, were never
// compressed (deleted at 24h, compression floors at 2 days) and never rolled up.
//
// Plain table with a real FK -- the no-foreign-key rule applies to the TimescaleDB
// hypertables only, and this is deliberately not one.
//
// SINGLE WRITER CADENCE: only the FULL system-info pass and the Polaris Agent push
// write here, never `recordFastFilteredResult`. The fast pass sees only pinned
// interfaces (collectFastFiltered filters the scrape), so a delete-replace from it
// would wipe every unpinned interface's row every probe tick -- and it writes
// ifType/ifParent/vlanId as NULL, which is exactly the topology-column loss this
// table exists to stop.
model AssetInterface {
  id      String @id @default(uuid())
  assetId String
  asset   Asset  @relation("AssetInterfaces", fields: [assetId], references: [id], onDelete: Cascade)
  ifName  String

  adminStatus String?
  operStatus  String?
  speedBps    BigInt?
  ipAddress   String?
  macAddress  String?

  // Cumulative counters as of the last full scrape. Current values only -- rate
  // math still comes from AssetInterfaceSample, which is why these are a snapshot
  // rather than a series.
  inOctets  BigInt?
  outOctets BigInt?
  inErrors  BigInt?
  outErrors BigInt?

  // Interface topology. Populated ONLY by the full scrape (the fast re-walk nulls
  // them), which is why the fast pass must never write this table.
  ifType   String?
  ifParent String?
  vlanId   Int?

  // Switch-port VLAN config -- FortiSwitch only, null elsewhere.
  nativeVlan     Int?
  taggedVlans    Int[]   @default([])
  trunksAllVlans Boolean @default(false)

  alias          String?
  description    String?
  addressingMode String?

  poeStatus String?
  poeClass  String?

  // firstSeen survives a re-scrape while the interface is still present and resets
  // when it disappears and comes back, matching AssetPhysicalEntity. lastSeen is
  // the full-pass timestamp, so a stale row is identifiable rather than silently
  // presented as current.
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([assetId, ifName])
  @@index([assetId])
  @@map("asset_interfaces")
}

// Per-asset additional IPs ("interface IPs", "secondary IPs", manually-tagged
// IPs). Replaces the legacy `Asset.associatedIps` JSONB column. Populated by:
//   - System-info scrape (one row per interface that returned an IP, with
//     source="monitor-system-info"). Reconciled per scrape: rows owned by
//     a non-manual source are deleted in bulk and re-inserted with the
//     fresh interface set, while source="manual" rows are preserved.
//   - Manual edits via assets.ts (PATCH /assets/:id payload still carries
//     `associatedIps` as a JSON array; the route serializes both directions).
//   - Discovery currently does NOT write this table directly — it relies on
//     the live monitor pull as the single source per the original design.
//
// Read paths: bulk DNS PTR refresh, single-asset DNS lookup, the LLDP
// neighbor match index, and the assets list/get response (which serializes
// rows back into the `associatedIps` JSON shape so the frontend reads the
// same field name as before).
model AssetAssociatedIp {
  id            String    @id @default(uuid())
  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ip            String
  // Free-text source identifier. Stable values used by the codebase:
  //   "manual"                — operator-added via the assets edit panel
  //   "monitor-system-info"   — written by the systemInfo scrape
  //   plus various legacy values from older discovery paths preserved
  //   from the JSON backfill (the column is text not enum to match the
  //   prior open shape).
  source        String
  interfaceName String?
  // Per-IP MAC. May differ from `Asset.macAddress` (which is the asset's
  // primary MAC) — many devices have one MAC per interface.
  mac           String?
  // PTR cache. ptrFetchedAt is the wall-clock of the last reverse-DNS
  // attempt (success or failure); ptrTtl is the TTL the resolver returned
  // when there was a hit. Used by the bulk DNS job to decide which entries
  // are due for re-resolution.
  ptrName       String?
  ptrTtl        Int?
  ptrFetchedAt  DateTime?
  lastSeen      DateTime  @default(now())
  firstSeen     DateTime  @default(now())

  @@unique([assetId, ip])
  @@index([assetId])
  @@index([ip])
  @@map("asset_associated_ips")
}

// All MAC addresses an asset has been seen with. Replaces the legacy
// `Asset.macAddresses` JSONB column. Populated by:
//   - DHCP discovery (FMG / FortiGate, source="fmg-discovery" or "fortigate")
//   - Device-inventory FortiOS sweep (source="device-inventory")
//   - Intune sync (source="intune-ethernet" / "intune-wifi")
//   - AD computer-object sync (source="ad")
//   - Conflict ghost-merge (preserved from the deleted ghost asset)
//   - Manual edits via the asset edit panel (source="manual")
//   - System-info scrape + Polaris Agent interfaces push, for EVERY scraped
//     interface MAC, monitored or not (source="monitor-interface"; contiguous
//     MACs coalesce into [mac, macEnd] RANGE rows via reconcileInterfaceMacs
//     — a full-replace scoped to that source only, so it never touches rows
//     owned by other writers, and reconcileMacAddresses symmetrically never
//     touches interface-fold rows)
//
// `Asset.macAddress` (the scalar column on Asset) remains the asset's
// primary MAC — typically the most recently-seen entry. The relation
// here is the FULL history; quarantine push, LLDP matching, and the
// `mac-collision` conflict pathway all walk this table to find every MAC
// the asset has ever advertised.
//
// Persist semantics: discovery code that builds an in-memory mac list
// (deduped by normalized MAC, sorted by lastSeen desc) calls
// `reconcileMacAddresses(assetId, macs)` from src/utils/macAddresses.ts to
// sync the side table after the asset.update lands. The list/get response
// serializes the relation back into the legacy `macAddresses: [...]` JSON
// shape so existing API consumers (the frontend, external integrations)
// keep reading the same field name.
model AssetMacAddress {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  // Normalized to colon-uppercase form (AA:BB:CC:DD:EE:FF) at write time.
  // Frontends that present MACs format from this canonical form.
  mac        String
  // When set, this row is an INCLUSIVE contiguous range [mac, macEnd] rather
  // than a single MAC — the compact form the interface-scrape fold writes for
  // devices whose ports carry sequentially-allocated MACs (a 48-port switch
  // becomes one row instead of 48). Only source="monitor-interface" writes
  // ranges; every other writer stays single-MAC (macEnd null). Both bounds are
  // canonical colon-uppercase, so lexicographic string comparison equals
  // numeric MAC comparison — range containment is `mac <= X AND macEnd >= X`.
  macEnd     String?
  source     String
  // Optional metadata that some sources include. `device` is the FortiGate
  // hostname when this MAC came from a DHCP scrape; `subnetCidr` /
  // `subnetName` are populated when the MAC's IP at sighting time fell
  // inside a known Polaris subnet on that FortiGate.
  device     String?
  subnetCidr String?
  subnetName String?
  lastSeen   DateTime @default(now())
  firstSeen  DateTime @default(now())

  @@unique([assetId, mac])
  @@index([assetId])
  @@index([mac])
  @@map("asset_mac_addresses")
}

// Operator-typed override for an interface's "Interface Comments" text box.
// Takes priority over the discovered AssetInterfaceSample.description (FortiOS
// CMDB `description`) for display. When the originating integration's
// `syncDescriptions` toggle is off this stays Polaris-local (legacy behavior);
// when on, the override is description-synced to the device (FortiGate
// system/interface `description`, or FortiSwitch port `description` via the
// parent controller) — Polaris is primary, device-side edits are overwritten
// (audited). One row per (assetId, ifName); a null/empty `description` clears
// the override and the discovered comment shows through again (the device-side
// description is NOT deleted on clear). See descriptionSyncService.
model AssetInterfaceOverride {
  id          String    @id @default(uuid())
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ifName      String
  description String?   @db.VarChar(255)
  updatedBy   String?
  // Description-sync state (null on all four = Polaris-local / never synced).
  // syncStatus: "synced" | "failed" | "conflict". Transport/read errors never
  // change these; only an actual push attempt stamps them (quarantine-verify
  // rule). syncedValue is the three-way-merge baseline: the last value both
  // sides agreed on (always the last value pushed/adopted, hence non-empty).
  // NULL syncedValue = no merge base yet → Polaris-primary bootstrap on the
  // next reconcile; non-NULL enables newest-wins (only the side that changed
  // since the baseline wins; both changed → "conflict", touch neither side).
  syncStatus  String?
  lastSyncAt  DateTime?
  syncError   String?
  syncedValue String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([assetId, ifName])
  @@index([assetId])
  @@map("asset_interface_overrides")
}

// Per-pinned-process log configuration (Feature C). One row per (asset, program
// name). `logSource` = "auto" (agent resolves: Linux systemd unit → journald,
// else file-glob) | "journald-unit" | "file-glob". `logPathGlob` is the
// operator-typed wildcard path used when not journald; `detectedUnit` is the
// agent-reported systemd unit when auto-resolution succeeded (shown as a hint).
// No FK to Asset (matches the other process tables); orphans for a deleted
// asset are harmless and rare.
model AssetProcessConfig {
  id           String   @id @default(uuid())
  assetId      String
  name         String
  logSource    String?
  logPathGlob  String?
  detectedUnit String?
  notes        String?  @db.VarChar(255)
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([assetId, name])
  @@index([assetId])
  @@map("asset_process_configs")
}

// Operator-defined rules that FLAG matching log lines (Feature C). Evaluated at
// READ time over the process-log query window (no per-row persisted flag) so a
// new/edited rule retroactively flags history with no backfill. Scope: global
// (all process logs) | asset (one asset) | process (one asset+program). matchType
// substring|regex|glob over the message text. No FK — global rules have no asset.
model LogFlagRule {
  id            String   @id @default(uuid())
  name          String
  enabled       Boolean  @default(true)
  scope         String   @default("global") // "global" | "asset" | "process"
  assetId       String? // set when scope = asset | process
  processName   String? // set when scope = process
  matchType     String   @default("substring") // "substring" | "regex" | "glob"
  pattern       String
  caseSensitive Boolean  @default(false)
  // Optional severity floor — only flag lines at/above this level (when the
  // line's level is known). null = any level.
  minLevel      String?
  // Operator-facing label + optional UI color for the flag badge.
  label         String?
  color         String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enabled])
  @@index([assetId])
  @@map("log_flag_rules")
}

// Per-sensor hardware snapshot, written alongside telemetry. Covers the whole
// hardware-sensor table — temperature, fan, voltage, power/psu, disk, and
// anything else — one row per sensor per scrape. FortiOS exposes these via
// /api/v2/monitor/system/sensor-info; SNMP via FORTINET-FORTIGATE-MIB
// fgHwSensorTable (name/value/alarm) or the standard ENTITY-SENSOR-MIB
// (entPhySensorType=8/celsius → temperature class). `sensorClass` is a
// best-effort classification (temperature | fan | voltage | power | disk |
// other); `unit` is the display unit for `value` (°C, RPM, V, …); `alarmStatus`
// is the per-row device-reported health when available. Hosts that publish
// nothing get no rows and the System tab hides the section.
// NOTE: no FK to Asset — this is a TimescaleDB hypertable; a cascade DELETE
// matching a compressed chunk decompresses it into un-truncatable bloat
// (see migration 20260615000000). Deleting an Asset orphans these rows to age
// out via drop_chunks.
model AssetHardwareSensorSample {
  id          String   @default(uuid())
  assetId     String
  timestamp   DateTime @default(now())
  sensorName  String
  sensorClass String // temperature | fan | voltage | power | disk | other
  value       Float?
  unit        String?
  alarmStatus String?
  // UNUSED — nothing writes or reads this. It was added by migration
  // 20260810130000 for a display-only "which interface is this sensor on?"
  // annotation that inferred the interface from the sensor's entPhysicalIndex.
  // That inference was withdrawn: on FortiSwitchOS the indexes only SOMETIMES
  // line up with ifIndex (`sensor-15` is not reliably the interface at ifIndex
  // 15), so the label was wrong often enough to mislead. The column stays
  // because it is nullable and free, and because DROP COLUMN on a hypertable
  // with compressed chunks is the DDL this file warns about above — keeping it
  // also means a future correct implementation needs no migration. Do not
  // repopulate it without a correlation the device actually guarantees
  // (ENTITY-MIB entPhysicalContainedIn → entAliasMappingIdentifier, or a
  // vendor table that names the interface outright).
  ifName      String?

  @@id([id, timestamp])
  @@index([assetId, timestamp])
  @@index([assetId, sensorName, timestamp])
  @@index([assetId, sensorClass, timestamp])
  @@map("asset_hardware_sensor_samples")
}

// Per-tunnel IPsec snapshot, written on the system-info cadence. FortiOS only
// (read from /api/v2/monitor/vpn/ipsec). One row per phase-1 tunnel; status
// rolls phase-2 selectors up to "up" / "down" / "partial". Bytes are
// cumulative — subtracting consecutive samples gives tunnel throughput.
model AssetIpsecTunnelSample {
  id              String   @default(uuid())
  assetId         String
  timestamp       DateTime @default(now())
  tunnelName      String
  // Parent interface from `config vpn ipsec phase1-interface` (the FortiOS
  // CMDB `interface` field — typically the WAN port the tunnel rides, e.g.
  // "wan1" or a VLAN sub-interface). The System tab uses this to nest tunnel
  // rows under their parent in the Interfaces table. Null when the CMDB
  // endpoint is unreachable or returns no matching phase-1.
  parentInterface String?
  remoteGateway   String?
  // "up" = every phase-2 selector is up; "down" = every selector down; "partial" = mix.
  status          String
  // Sum of incoming/outgoing bytes across every phase-2 selector under this
  // phase-1. FortiOS resets the counter when phase-1 renegotiates, so the UI
  // must treat decreases as a counter reset rather than negative throughput.
  incomingBytes   BigInt?
  outgoingBytes   BigInt?
  proxyIdCount    Int?
  // Cadence discriminator (see AssetInterfaceSample.cadence). "fast" = pinned
  // tunnel re-walk (monitoredIpsecTunnels); "slow"/NULL = full scrape → 24h.
  cadence         String?

  @@id([id, timestamp])
  @@index([assetId, timestamp])
  @@index([assetId, tunnelName, timestamp])
  @@map("asset_ipsec_tunnel_samples")
}

// Per-WAN-link SD-WAN Performance SLA health-check snapshot, written on the
// system-info cadence. FortiOS only (read from
// /api/v2/monitor/virtual-wan/health-check), gated by Integration.config.pullSdwan.
// One row per (health-check, member link). latency/jitter/packetLoss are
// instantaneous gauges (not counters) — averaged, not diffed, in rollups.
model AssetPerfSlaSample {
  id                  String   @default(uuid())
  assetId             String
  timestamp           DateTime @default(now())
  // Health-check name (the SD-WAN performance-SLA object) + the WAN member
  // interface it probed over (e.g. "wan1", "port2").
  healthCheck         String
  link                String
  // SD-WAN zone the member belongs to (from `config system sdwan` members[].zone,
  // e.g. "virtual-wan-link" / "overlay"). Null when the CMDB lookup is unavailable.
  zone                String?
  // "up" = link alive / SLA member reachable; "down" otherwise.
  state               String
  // Instantaneous gauges from the health-check. Null when the member reported
  // no value (e.g. link down, or FortiOS omitted the field).
  latencyMs           Float?
  jitterMs            Float?
  packetLoss          Float?
  // SLA target thresholds for the parent health-check (from CMDB
  // system/sdwan health-check `sla`). Same value across every member of a
  // health-check. Null when that metric has no configured SLA threshold;
  // the chart draws a dashed threshold line only where set.
  latencyThresholdMs  Float?
  jitterThresholdMs   Float?
  packetLossThreshold Float?
  // Cadence discriminator (see AssetIpsecTunnelSample.cadence). Always "fast"
  // for SD-WAN (no pinned-subset concept) so rollups include every row.
  cadence             String?

  @@id([id, timestamp])
  @@index([assetId, timestamp])
  @@index([assetId, healthCheck, link, timestamp])
  @@map("asset_perf_sla_samples")
}

// Per-service-rule SD-WAN selection snapshot — CURRENT-STATE per (asset, rule),
// replaced in full on every system-info pass that successfully collected SD-WAN
// data (mirrors AssetLldpNeighbor / AssetWirelessStation, NOT a time-series).
// FortiOS only (rule definitions from /api/v2/cmdb/system/sdwan, runtime
// selection merged in when resolvable), gated by Integration.config.pullSdwan.
// `selectedMember` is the member currently carrying the rule's traffic;
// `availableMembers` is the configured candidate list in priority order.
// History/timeline was dropped per product decision (2026-06) — only the
// SD-WAN SLA metrics stream (AssetPerfSlaSample) remains a time-series.
// PLAIN Postgres table (NOT a hypertable).
model AssetSdwanRule {
  id               String   @id @default(uuid())
  assetId          String
  ruleName         String
  ruleId           String?
  // 0-based position in the FortiOS `service` array = the rule's evaluation
  // priority. Used to order the rules table to match the FortiGate GUI.
  seq              Int?
  // Admin enable state (CMDB `status` = "enable"/"disable").
  enabled          Boolean?
  // Rule mode from CMDB (e.g. "sla" | "priority" | "load-balance" | "manual").
  mode             String?
  // Operator-facing selection-criteria label derived from mode + link-cost-factor
  // (e.g. "Latency" | "Packet Loss" | "Customized Profile" | "Source IP").
  criteria         String?
  // Performance-SLA health-check name(s) the rule references (the GUI
  // "Performance SLA" column).
  healthChecks     String[] @default([])
  // Destination objects the rule matches (address / ISDB / app names).
  dst              String[] @default([])
  // "up" = rule has a usable selected member; "down" otherwise. Runtime health,
  // distinct from `enabled` (admin state).
  status           String
  // The member currently selected for the rule. Null when FortiOS doesn't
  // expose runtime selection (collector degrades gracefully — see
  // collectSdwanFortinet).
  selectedMember   String?
  // Configured candidate members in priority order.
  availableMembers String[] @default([])
  // SD-WAN zone(s) the rule prefers, in priority order, when configured for
  // zone-based selection (`priority-zone`). Empty for interface-member rules.
  // When set, availableMembers is resolved from these zones' member interfaces.
  priorityZones    String[] @default([])
  updatedAt        DateTime @updatedAt

  @@unique([assetId, ruleName])
  @@index([assetId])
  @@map("asset_sdwan_rules")
}

// CURRENT-STATE vCenter datastore inventory — one row per (integration,
// datastore). Plain table, NOT a hypertable: replaced in full per discovery
// run by syncVcenterDevices Pass D (delete-replace, like AssetSdwanRule /
// AssetLldpNeighbor). Datastores are shared across cluster hosts, so rows
// live per-integration (not per-asset) with `hostMorefs` carrying the
// mounting ESXi hosts; the asset-details endpoint joins on that array.
// No history/time-series — capacity figures are a discovery-time snapshot.
model VcenterDatastore {
  id               String      @id @default(uuid())
  integrationId    String
  integration      Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  moref            String // vCenter MoRef, e.g. "datastore-123" (unique per vCenter, not across)
  name             String
  dsType           String? // VMFS | NFS | NFS41 | vSAN | VVOL | ...
  capacityBytes    BigInt?
  freeBytes        BigInt?
  // Total provisioned across VMs incl. thin overcommit. Nullable — not
  // exposed by the vSphere REST list; populated only when the SOAP
  // datastore-info call yields summary/uncommitted figures.
  provisionedBytes BigInt?
  accessible       Boolean?
  hostMorefs       String[]    @default([]) // ESXi hosts mounting this datastore
  // Backing detail from the SOAP datastore-info call (graceful-null when the
  // call fails or the shape is unrecognized):
  //   { vmfs?: [{ diskName, vendor? }], nas?: { remoteHost, remotePath } }
  // diskName is the canonical device id (e.g. "naa.624a9370…") whose NAA
  // prefix identifies the array vendor (vendorFromNaa in vcenterService).
  backing          Json?
  // Derived display label for the backing storage, e.g. "Pure Storage",
  // "NetApp", "NFS: filer01.corp". Null when backing is unknown.
  backingLabel     String?
  updatedAt        DateTime    @updatedAt

  @@unique([integrationId, moref])
  @@index([integrationId])
  @@map("vcenter_datastores")
}

// CURRENT-STATE process inventory — one row per running program (aggregated by
// name/exe across PIDs) per asset. Plain table, NOT a hypertable: replaced in
// full per scrape by persistAssetProcesses (delete-replace, like
// AssetSdwanRule / AssetLldpNeighbor). Per-program CPU/RAM are a snapshot
// (the time-series for PINNED programs lives in AssetProcessSample, Feature C).
// No FK to Asset — the delete-replace + per-asset queries don't need it, and
// it matches the AssetSdwanRule convention.
model AssetProcess {
  id            String    @id @default(uuid())
  assetId       String
  // Aggregation key: the program name (e.g. "nginx", "sqlservr"). Pinning in
  // Asset.monitoredProcesses / alertWatchedProcesses is by this name.
  name          String
  // Number of live PIDs sharing this name at scrape time.
  instanceCount Int       @default(1)
  // Summed CPU% (0..100×cores possible) + resident memory across instances.
  cpuPct        Float?
  memRssBytes   BigInt?
  // Representative executable path / owning user / earliest start time.
  exePath       String?
  username      String?
  startedAt     DateTime?
  // Resolved Windows service / systemd unit backing this program, when the
  // collector could map it. Drives the Processes-tab control buttons (Phase 4).
  serviceUnit   String?
  // True when serviceUnit resolved → start/stop/restart is possible.
  controllable  Boolean   @default(false)
  updatedAt     DateTime  @updatedAt

  @@unique([assetId, name])
  @@index([assetId])
  @@map("asset_processes")
}

// CURRENT-STATE service inventory — one row per systemd unit (Linux) or Windows
// service (SCM) per asset. Plain table, NOT a hypertable: replaced in full per
// scrape by persistAssetServices (delete-replace, like AssetProcess /
// AssetSdwanRule). Unlike AssetProcess (keyed by program name), this is keyed by
// the UNIT name — so a service backed by a shared runtime (e.g. a Spring Boot
// app running as "java") is visible as itself, and oneshot/exited units with no
// live process still appear. No FK to Asset — matches the AssetProcess
// convention. Agent-only (agentless SSH/WinRM does not resolve units).
model AssetService {
  id           String   @id @default(uuid())
  assetId      String
  // Aggregation key: the unit name ("truckscale-central.service") or Windows
  // service short name ("W32Time"). Pinning in Asset.monitoredServices /
  // mappedServices is by this name.
  unit         String
  // "systemd" | "windows" — selects the state vocabulary + control transport.
  platform     String
  // systemd Description / Windows DisplayName.
  displayName  String?
  // systemd load state (loaded/masked/not-found); "" for Windows.
  loadState    String?
  // systemd active state (active/inactive/failed) / Windows state (running/stopped).
  activeState  String?
  // systemd sub state (running/exited/dead/failed); "" for Windows.
  subState     String?
  // systemd enablement (enabled/disabled/static) / Windows start mode (auto/manual/disabled).
  enabledState String?
  // Main process PID + its program name (cross-links to the Processes tab).
  mainPid      Int?
  mainProcess  String?
  // Current memory of the unit's cgroup (systemd MemoryCurrent); null when unset.
  memBytes     BigInt?
  // True when the unit is start/stop/restartable via the AgentCommand queue.
  controllable Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@unique([assetId, unit])
  @@index([assetId])
  @@map("asset_services")
}

// ACCUMULATE + AGE connection map for MAPPED processes (Asset.mappedProcesses).
// One row per observed socket fact for a mapped program; rows are UPSERTED on
// the business key (lastSeen bumped — behind a 5-minute churn gate — firstSeen
// kept) by persistProcessConnections and pruned by pruneProcessConnections when
// lastSeen exceeds POLARIS_PROCESS_CONN_RETENTION_DAYS (default 30). NEVER
// delete-replaced — short-lived/periodic connections (DB pools, cron jobs) must
// stay visible on the Application Map instead of flickering per scrape.
// Plain table, NOT a hypertable, so a real FK to Asset is fine (the no-FK rule
// is hypertables-only; AssetMaintenanceWindow precedent).
// Per kind:
//   listen:   localAddr = bind addr, localPort = port         (remote* = ""/0)
//   outbound: remoteIp  = dst IP,    remotePort = dst port    (local* = ""/0;
//             the ephemeral source port is intentionally never stored — that's
//             what makes outbound rows naturally dedup)
//   inbound:  remoteIp  = peer IP,   localPort = listening port (localAddr = "",
//             remotePort = 0 — the peer's ephemeral port is dropped too)
// Business-key columns are NOT NULL with sentinel defaults (""/0) so the unique
// index is total — Postgres treats NULLs as distinct in unique indexes, which
// would break the ON CONFLICT upsert.
model AssetProcessConnection {
  id          String   @id @default(uuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  // AssetProcess.name key — same program-name space as the pin arrays.
  processName String
  kind        String // "listen" | "outbound" | "inbound"
  proto       String // "tcp" | "udp"
  localAddr   String   @default("")
  localPort   Int      @default(0)
  remoteIp    String   @default("")
  remotePort  Int      @default(0)
  // Owning systemd unit / Windows service (Phase 3), when the PID's cgroup
  // resolved one — lets the Services detail panel + Application Map attribute a
  // socket to a UNIT, not just a program name. NOT in the business key
  // (deterministic per process). BACKFILL-ONLY on conflict: an empty stored
  // value adopts the incoming unit, a non-empty one is never overwritten — so a
  // tuple first inserted before its unit was mapped can still be attributed,
  // without letting svchost co-hosting or an agentless push churn the column.
  // Empty when unknown or when the row came only via a mappedProcesses pin.
  unit        String   @default("")
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  // Explicit map name: the auto-generated 8-column name would exceed
  // Postgres's 63-char identifier limit and get truncated unpredictably.
  @@unique([assetId, processName, kind, proto, localAddr, localPort, remoteIp, remotePort], map: "asset_process_connections_bizkey")
  @@index([assetId, processName])
  // Global Application Map build joins remoteIp against other assets' IPs.
  @@index([remoteIp])
  // Deliberately NO index on lastSeen: it's the only column updates touch, so
  // leaving it unindexed keeps every bump a HOT update; the daily prune's
  // seq-scan over a ≤~180k-row table is trivial.
  @@map("asset_process_connections")
}

// LLDP neighbor table — current-state per (asset, local interface). Replaced
// in full on every system-info pass that successfully queried LLDP (FortiOS
// /api/v2/monitor/system/interface/lldp-neighbors, or SNMP LLDP-MIB::lldpRemTable).
// `firstSeen` tracks the original sighting across persists so the System tab
// can show "first seen N days ago"; `lastSeen` is bumped on every refresh.
//
// `matchedAssetId` is filled in at persist time when the neighbor's chassis
// MAC, management IP, or system name resolves to another Polaris Asset — that
// powers the Device Map topology graph (LLDP gives us real edges to non-
// Fortinet gear that fortinetTopology can't see). The relation uses SetNull
// so deleting the matched asset doesn't cascade-delete the neighbor row, just
// clears the back-pointer.
//
// `source` is "fortios" (FortiOS REST collector) or "snmp" (LLDP-MIB walk),
// kept around mostly for diagnostics — both transports normalize into the
// same row shape before insert.
model AssetLldpNeighbor {
  id          String @id @default(uuid())
  assetId     String
  asset       Asset  @relation("AssetLldpNeighbors", fields: [assetId], references: [id], onDelete: Cascade)
  localIfName String

  chassisIdSubtype  String?
  chassisId         String?
  portIdSubtype     String?
  portId            String?
  portDescription   String?
  systemName        String?
  systemDescription String?  @db.Text
  managementIp      String?
  capabilities      String[] @default([])

  matchedAssetId String?
  matchedAsset   Asset?  @relation("AssetLldpNeighborMatch", fields: [matchedAssetId], references: [id], onDelete: SetNull)

  source String // "fortios" | "snmp"

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([assetId, localIfName, chassisId, portId])
  @@index([assetId])
  @@index([assetId, localIfName])
  @@index([matchedAssetId])
  @@map("asset_lldp_neighbors")
}

// MCLAG (Multi-Chassis LAG) Inter-Chassis-Link peers, one row per local
// physical ICL port on a FortiSwitch (the ICL can be a multi-link aggregate,
// so a switch may have several rows to the same peer). Current-state table,
// full-replaced per scrape by `persistMclagPeers` — same delete-replace
// pattern as AssetLldpNeighbor / AssetSdwanRule, NOT a hypertable, no history.
//
// Populated from the parent FortiGate's switch-controller managed-switch CMDB
// (`/api/v2/cmdb/switch-controller/managed-switch`): a port with
// `mclag-icl-port` set names its peer in `isl-peer-device-sn` (the canonical
// pairing key — port names aren't unique across the two chassis). The peer
// switch's CMDB mirrors the relationship back. `matchedAssetId` resolves
// `peerSn` → the peer's Asset row so the topology renderer can draw a clickable
// sibling edge and the dependency tree can mark MCLAG siblings definitively
// (vs. the prior same-controller/same-layer heuristic).
model AssetMclagPeer {
  id        String @id @default(uuid())
  assetId   String
  asset     Asset  @relation("AssetMclagPeers", fields: [assetId], references: [id], onDelete: Cascade)
  localPort String // local physical ICL port, e.g. "port51"

  iclTrunk String? // isl-local-trunk-name, e.g. "_FlInK1_ICL0_"
  peerSn   String // isl-peer-device-sn — the pairing key
  peerName String? // isl-peer-device-name
  peerPort String? // isl-peer-port-name (peer's port on the far end)

  matchedAssetId String?
  matchedAsset   Asset?  @relation("AssetMclagPeerMatch", fields: [matchedAssetId], references: [id], onDelete: SetNull)

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([assetId, localPort])
  @@index([assetId])
  @@index([peerSn])
  @@index([matchedAssetId])
  @@map("asset_mclag_peers")
}

// Field-replaceable hardware inventory from ENTITY-MIB (RFC 4133)
// entPhysicalTable -- transceivers, power supplies and fan trays, with the
// vendor / model / serial an operator needs to raise an RMA or find the spare.
//
// CURRENT-STATE table, full-replaced per scrape by `persistPhysicalEntities`
// (the AssetLldpNeighbor / AssetMclagPeer delete-replace pattern). Deliberately
// NOT a hypertable and NOT a retention entity: inventory is not a time series,
// it changes on a maintenance window rather than a cadence, and "when did this
// SFP's serial change" is answered by the audit Event, not by 90 days of
// identical rows. Plain table with a real FK to Asset -- the no-FK rule applies
// to hypertables only.
//
// Scoped to FRUs (entPhysicalIsFRU, else class module/powerSupply/fan) so the
// container and port scaffolding a chassis publishes -- often hundreds of rows
// naming nothing replaceable -- stays out.
//
// `ifName` is the correlated interface for a transceiver, resolved the same way
// hardware sensors are (entPhysicalIndex == ifIndex is a FortiSwitchOS property,
// not an RFC 4133 guarantee, so it is vendor-gated and display-only).
model AssetPhysicalEntity {
  id       String @id @default(uuid())
  assetId  String
  asset    Asset  @relation("AssetPhysicalEntities", fields: [assetId], references: [id], onDelete: Cascade)
  // entPhysicalIndex -- stable within a device between reboots, and the join
  // key back to ENTITY-SENSOR-MIB rows for the same module.
  entIndex Int

  entClass    String // "module" | "powerSupply" | "fan" | "container" | ...
  descr       String? @db.Text
  name        String?
  hardwareRev String?
  firmwareRev String?
  serialNum   String?
  mfgName     String?
  modelName   String?
  isFru       Boolean @default(false)
  // Display-only correlated interface for a transceiver. Never used as an
  // identity or join key -- a failed IF-MIB walk must not fork a module's row.
  ifName      String?

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([assetId, entIndex])
  @@index([assetId])
  @@index([assetId, entClass])
  @@map("asset_physical_entities")
}

// Layer-2 MAC forwarding database (the switch's CAM table), from Q-BRIDGE-MIB
// dot1qTpFdbTable (RFC 4363, VLAN-aware) with a BRIDGE-MIB dot1dTpFdbTable
// fallback (RFC 4188) for switches that only answer the older table.
//
// CURRENT-STATE, delete-replaced per scrape -- the AssetLldpNeighbor pattern.
// An FDB entry ages out on the switch in minutes; storing history would be a
// firehose answering a question ("which port was this MAC on an hour ago")
// that the switch itself cannot answer either.
//
// Both source tables report a **dot1dBasePort**, NOT an ifIndex. The join runs
// through dot1dBasePortIfIndex and then the scrape's own ifIndex->ifName map;
// unlike the PoE correlation this join is defined by the MIB and reliable.
// `basePort` is kept alongside `ifName` so an unresolved row is still visible
// rather than silently dropped.
//
// Rows are capped per asset (a single access switch can hold thousands) with a
// loud truncation warning -- a partial table that looks complete would make the
// per-port MAC counts, and therefore any uplink inference drawn from them, wrong.
model AssetMacTableEntry {
  id      String @id @default(uuid())
  assetId String
  asset   Asset  @relation("AssetMacTableEntries", fields: [assetId], references: [id], onDelete: Cascade)

  /// Normalized colon-uppercase (AA:BB:CC:DD:EE:FF), matching AssetWirelessStation.
  macAddress String
  /// dot1qFdbId / VLAN the entry was learned in. NULL on the BRIDGE-MIB fallback,
  /// which has no VLAN dimension at all.
  vlanId     Int?
  /// dot1dBasePort as reported. Retained so a row whose ifIndex join failed is
  /// still identifiable instead of appearing to belong to no port.
  basePort   Int?
  /// Resolved interface name. NULL when the basePort->ifIndex->ifName join failed.
  ifName     String?
  /// dot1dTpFdbStatus: "learned" | "self" | "mgmt" | "invalid" | "other".
  /// The distinction matters: only `learned` is a real endpoint sighting, and
  /// `self` is the switch's own address, which is what identifies a peer switch.
  status     String

  /// Resolved from the MAC against the asset inventory, via the same cached
  /// index LLDP matching uses.
  matchedAssetId String?
  matchedAsset   Asset?  @relation("AssetMacTableMatch", fields: [matchedAssetId], references: [id], onDelete: SetNull)

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([assetId, macAddress, vlanId])
  @@index([assetId])
  @@index([assetId, ifName])
  @@index([macAddress])
  @@index([matchedAssetId])
  @@map("asset_mac_table_entries")
}

// The FortiGate's layer-3 neighbour cache (`/api/v2/monitor/network/arp`), one
// row per (IP, MAC, interface) binding the gate currently holds. The L3 sibling
// of AssetMacTableEntry: that table answers "what is plugged into port 7" from
// a switch's forwarding database, this one answers "what is at 10.4.12.63" from
// the router's own resolution of the address.
//
// ACCUMULATE + AGE, not delete-replace (the AssetProcessConnection pattern): a
// binding still present just has its lastSeen bumped, firstSeen is preserved,
// and rows age out on the flat `arpEntries` retention window. That is what lets
// the tab answer "who was at this address last Tuesday" rather than only "right
// now", at one row per distinct binding instead of one per scrape -- the
// snapshot alternative is ~52M rows/month across a 40-gate fleet at the 600s
// cadence. History is therefore an INTERVAL, not a timeline: a MAC that flips
// away and back between two scrapes is invisible, and a binding recurring after
// a gap collapses into one row spanning it.
//
// TWO WRITERS, which the accumulate model makes safe (a partial view bumps what
// it saw and touches nothing else -- under delete-replace the same pair would
// wipe each other):
//   1. the monitor system-info pass (600s default) for MONITORED firewalls,
//      over FortiOS REST or IP-MIB SNMP per the resolved polling method;
//   2. discovery Phase 7.5b (pollInterval, 12h default), which covers gates
//      that are unmonitored or have system-info off, and costs nothing extra
//      because those rows are already read for the Reservation.lastSeenArp
//      presence stamp and placeholder-MAC adoption.
// Neither can express "the cache is empty" -- nothing here is ever wiped by a
// scrape, only aged out by retention.
//
// `matchedAssetId` resolves by MAC ONLY. Matching on the IP as well would be
// the one join the row itself contradicts: an ARP entry asserting that address
// belongs to that MAC is exactly the evidence that an asset still carrying the
// address under a different MAC is stale.
model AssetArpEntry {
  id      String @id @default(uuid())
  assetId String
  asset   Asset  @relation("AssetArpEntries", fields: [assetId], references: [id], onDelete: Cascade)

  /// IPv4 address as the gate reports it.
  ipAddress  String
  /// Normalized colon-uppercase (AA:BB:CC:DD:EE:FF), matching AssetMacTableEntry.
  macAddress String
  /// Interface the binding was learned on, e.g. "internal3". "" means the
  /// device attributed it to no interface -- NOT nullable, because this is part
  /// of the business key and Postgres treats NULLs as DISTINCT in a unique
  /// index, so a nullable column would let every unattributed binding insert a
  /// duplicate per scrape. The route maps "" back to null on the way out.
  ifName     String @default("")
  /// Entry age in seconds, when FortiOS exposes it. NULL otherwise -- absence
  /// is "the firmware did not say", never zero.
  ageSec     Int?

  /// Resolved from the MAC against the asset inventory (the discovery run's own
  /// AssetIndex). NULL for an address the gate knows and Polaris does not.
  matchedAssetId String?
  matchedAsset   Asset?  @relation("AssetArpMatch", fields: [matchedAssetId], references: [id], onDelete: SetNull)

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([assetId, ipAddress, macAddress, ifName])
  @@index([assetId])
  @@index([assetId, ifName])
  /// Range filter ("seen in the last 12 hours") reads per asset; the retention
  /// prune reads fleet-wide.
  @@index([assetId, lastSeen])
  @@index([lastSeen])
  @@index([macAddress])
  @@index([ipAddress])
  @@index([matchedAssetId])
  @@map("asset_arp_entries")
}

// FortiSwitch trunk -> local physical port, from the vendor OctetString at
// 1.3.6.1.4.1.12356.106.3.1.1.0. The trunk name is built from the PEER's
// serial number, so this is the switch stating its own adjacencies over SNMP
// rather than leaving them to be inferred -- and it covers the FortiLink
// switch<->switch and switch<->FortiGate links that LLDP does not republish in
// managed mode.
//
// CURRENT-STATE, delete-replaced per scrape (the AssetLldpNeighbor /
// AssetMclagPeer pattern). Shape is close to AssetMclagPeer deliberately: both
// are "local port faces peer device, keyed by serial".
//
// Matching is a SUFFIX test, never reconstruction: the name is the peer serial
// left-truncated to 15 chars (with "-0" for a switch eating two of them), so
// rebuilding it would hard-code a cap that a firmware release could change.
// See utils/fortiswitchTrunkMap.ts.
model AssetTrunkMember {
  id      String @id @default(uuid())
  assetId String
  asset   Asset  @relation("AssetTrunkMembers", fields: [assetId], references: [id], onDelete: Cascade)

  /// Trunk name exactly as published, e.g. "8EF5920000001-0".
  trunkName      String
  /// Local physical port the trunk uses, e.g. "port23".
  localPort      String
  /// trunkName minus any trailing -<n>; the fragment suffix-matched to a serial.
  peerSerialTail String

  /// Suffix-matched peer. NULL when nothing matches OR when the tail is
  /// ambiguous across two serials -- an unresolved trunk is better than one
  /// attached to the wrong device.
  matchedAssetId String?
  matchedAsset   Asset?  @relation("AssetTrunkMemberMatch", fields: [matchedAssetId], references: [id], onDelete: SetNull)

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([assetId, trunkName, localPort])
  @@index([assetId])
  @@index([assetId, localPort])
  @@index([matchedAssetId])
  @@map("asset_trunk_members")
}

// Wireless stations connected to a FortiAP. Populated from SNMP
// `fapStationTable` (1.3.6.1.4.1.12356.120.8.1.1) by the system-info pass
// on `assetType="access_point"` assets monitored via SNMP. Mirrors the
// AssetLldpNeighbor shape but **without** the 48h stickiness window —
// wireless clients are transient by design; a station absent from a fresh
// scrape means the client roamed or disconnected, drop it immediately.
//
// `matchedAssetId` is resolved at persist time via a MAC-match against
// the endpoint inventory (same logic as LLDP). When set, the endpoint
// owning that MAC gets its `Asset.lastSeenAp` stamped to the AP's
// hostname so the asset details view shows which AP last saw the
// device.
model AssetWirelessStation {
  id         String @id @default(uuid())
  apAssetId  String
  apAsset    Asset  @relation("AssetWirelessStationsOnAp", fields: [apAssetId], references: [id], onDelete: Cascade)
  staMacAddr String // normalized colon-uppercase (AA:BB:CC:DD:EE:FF)

  staIpAddr      String?
  ssid           String?
  radioId        Int?
  wlanId         Int?
  band           String? // "2.4GHz" | "5GHz" | "6GHz", derived from fapRadioTable via radioId
  vlanId         Int?
  bssid          String?
  signalStrength Int? // dBm — populated from the controller's FortiOS REST /api/v2/monitor/wifi/client
  noise          Int? // dBm — populated from the same REST overlay when present
  bandwidthTx    Int? // kbps
  bandwidthRx    Int? // kbps
  idleSeconds    Int?

  matchedAssetId String?
  matchedAsset   Asset?  @relation("AssetWirelessStationMatch", fields: [matchedAssetId], references: [id], onDelete: SetNull)

  source String // "snmp" (band) + optional REST overlay (signal/noise)

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([apAssetId, staMacAddr])
  @@index([apAssetId])
  @@index([matchedAssetId])
  @@index([staMacAddr])
  @@map("asset_wireless_stations")
}

// One row per radio on a FortiAP — the parent level of the Stations tab's
// radio → SSID → station tree, and the answer to "what channel, how wide, at
// what power". Current-state, plain table with a real FK (NOT a hypertable):
// the same reasoning as AssetInterface, since every consumer wants what the
// radio is doing NOW, not a timeline of it.
//
// TWO WRITERS, and they carry COMPLEMENTARY columns rather than competing:
// the controller's /api/v2/monitor/wifi/managed_ap `radio[]` array (source
// "fortios", written by discovery — reaches every managed AP including the
// ones with SNMP disabled) and the AP's own FORTINET-FORTIAP-MIB
// fapRadioTable (source "snmp"). So the upsert MERGES per column: a NULL from
// a source that doesn't collect that column never erases a value the other
// source established, while any real value wins. The consequence to know
// about is that a column cannot be cleared back to NULL by a scrape — a
// stored tx-power floor survives until some source reports a different one.
// Radio IDENTITY is not merged: both sources enumerate every radio, so a
// radioIndex absent from a scrape is a radio that is genuinely gone.
model AssetApRadio {
  id      String @id @default(uuid())
  assetId String
  asset   Asset  @relation("AssetApRadios", fields: [assetId], references: [id], onDelete: Cascade)

  // fapRadioIndex / the controller's radio-id. The join key the AP's VAPs and
  // its stations (AssetWirelessStation.radioId) both hang off.
  radioIndex Int

  // PHY / mode string as the source words it ("802.11ax-5G", "802.11n,g-only").
  radioType String?
  // "2.4GHz" | "5GHz" | "6GHz" — reported where the source says so, otherwise
  // derived from type + channel by utils/fortiapRadioBand.
  band      String?
  // Operating mode: "ap" | "monitor" | "sniffer" | "disabled".
  mode      String?

  // Operating channel and channel width. `channel` is what the radio is
  // actually on, which on a DFS-capable radio is not what was configured.
  channel      Int?
  bandwidthMhz Int?

  // Transmit power, from two sources that do not agree on a unit and are not
  // made to. FortiOS states `oper_txpower` as a PERCENTAGE of the radio's
  // ceiling, so that one is named for what it is. The AP's own MIB publishes
  // fapRadioTxPowerConfig / Oper / Max as bare Integer32 with NO UNITS clause
  // and no range — the module simply does not say whether they are dBm or a
  // percentage — so those three keep unit-neutral names and are rendered
  // without a unit rather than with a guessed one. Converting between the two
  // would need a per-model ceiling Polaris does not have.
  //
  // `txPowerConfig` is what the profile ASKED for and `txPowerOper` what the
  // radio is actually running: the gap between them is what DARRP did. The
  // MIB publishes no minimum, which is why there is no column for one.
  txPowerPct    Int?
  txPowerConfig Int?
  txPowerOper   Int?
  txPowerMax    Int?
  // "auto" (DARRP / auto-power) vs a fixed level, as the source words it.
  txPowerMode   String?

  // The radio's base BSSID, and the client count the CONTROLLER reports —
  // which is a cross-check on the station table, not a replacement for
  // counting it (the two disagree while a client is roaming).
  baseBssid   String?
  clientCount Int?
  countryCode String?

  source String // "fortios" | "snmp"

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([assetId, radioIndex])
  @@index([assetId])
  @@map("asset_ap_radios")
}

// One row per VAP (broadcast SSID) on a FortiAP radio — the middle level of
// the radio → SSID → station tree, and the inventory behind the "Broadcast
// SSID" device-filter condition field. Current-state, delete-replaced per
// scrape, same merge-on-column contract as AssetApRadio above.
//
// IDENTITY is `vapName` (the FortiOS VAP object name, falling back to the
// SSID when a source reports only that), NOT the SSID and not the BSSID: one
// SSID is commonly broadcast by several VAPs, and a BSSID is absent on
// sources that don't publish it. `bssid` is instead the JOIN KEY down to
// AssetWirelessStation.bssid — the reliable way to say which SSID a station
// is actually on, since a station's wlanId is only as trustworthy as the
// source's VAP numbering.
model AssetApVap {
  id      String @id @default(uuid())
  assetId String
  asset   Asset  @relation("AssetApVaps", fields: [assetId], references: [id], onDelete: Cascade)

  radioIndex Int
  vapName    String

  ssid        String?
  bssid       String?
  vlanId      Int?
  clientCount Int?

  source String // "fortios" | "snmp"

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([assetId, radioIndex, vapName])
  @@index([assetId])
  @@index([assetId, radioIndex])
  // The "Broadcast SSID" filter's option list is one GROUP BY over this
  // column across the monitored fleet.
  @@index([ssid])
  @@map("asset_ap_vaps")
}

// Slice 7 — time-series of custom-widget samples. Each row is one
// ManufacturerCustomWidget probe result against one asset. `kind` is
// "scalar" or "table" (mirrors the widget definition); `value` holds either
// a single number (scalar) or an array of row objects (table).
// Detail-only time-series (no hourly/daily rollups). Managed as a STANDALONE
// TimescaleDB hypertable (timescaleService.STANDALONE_SAMPLE_TABLES) and pruned
// on the system-info umbrella window (interfaces detail retention) by
// pruneSystemInfoSamples — same compression-safe drop_chunks path as the tiered
// tables. Composite PK (id, timestamp) so the partition column is in the PK,
// which create_hypertable requires.
model AssetCustomWidgetSample {
  id        String   @default(uuid())
  assetId   String
  widgetId  String // stable UUID from ManufacturerCustomWidget; NOT an FK so
  // a widget delete doesn't cascade-blow historical samples
  // (the Custom MIB tab still shows the last-known values
  // until retention prunes them out).
  timestamp DateTime @default(now())
  kind      String // "scalar" | "table"
  value     Json // number for scalar; row array for table

  @@id([id, timestamp])
  @@index([assetId, timestamp])
  @@index([assetId, widgetId, timestamp])
  @@index([widgetId])
  @@map("asset_custom_widget_samples")
}

// Time-series for STATE PROBES — the 0/1 sibling of AssetCustomWidgetSample.
// One row per (asset, probe, table row) per scrape, already normalized to a
// boolean by the probe's declared stateMap (src/utils/stateProbes.ts).
//
// Why its own table rather than another `kind` on AssetCustomWidgetSample: the
// interesting dimension here is the table ROW (one sensor, one PSU), each of
// which alerts independently and needs its own firing state. Real columns make
// that an indexed `(assetId, probeId, timestamp)` read for the engine and a
// plain GROUP BY for the builder's row picker, instead of unpacking a JSON array
// per sample on every 60s tick. Values are pre-normalized so the engine only
// ever compares 0 or 1 and cannot be wrong about a vendor's polarity.
//
// `value` is 0 or 1 and NEVER null — an unreadable or absent row is DROPPED by
// the collector, because 0 is a positive claim of health that would clear an
// active alert (see evaluateStateMap's contract). Detail-only, no rollups
// (averaging a boolean is meaningless); managed as a STANDALONE TimescaleDB
// hypertable and pruned on the system-info umbrella window. No FK to Asset —
// the hypertable cascade-DELETE invariant (migration 20260615000000).
model AssetStateSample {
  id        String   @default(uuid())
  assetId   String
  timestamp DateTime @default(now())
  probeId   String // ManufacturerCustomWidget.id; NOT an FK, same rationale as
  // AssetCustomWidgetSample.widgetId
  // OID index suffix the row came from ("" for a scalar probe). The STABLE
  // identity — it's what the engine keys firing state on, so a row keeps its
  // alert across a label change.
  rowKey    String
  // Resolved display name (from the probe's labelSymbol walk), falling back to
  // rowKey. Snapshotted per sample so an alert can name the row.
  rowLabel  String
  value     Int // 0 | 1
  rawValue  String? // what the device actually returned, for the asset tab

  @@id([id, timestamp])
  @@index([assetId, timestamp])
  @@index([assetId, probeId, timestamp])
  @@index([probeId])
  @@map("asset_state_samples")
}

// Per-mountpoint storage snapshot, written alongside interface samples.
model AssetStorageSample {
  id         String   @default(uuid())
  assetId    String
  timestamp  DateTime @default(now())
  mountPath  String
  totalBytes BigInt?
  usedBytes  BigInt?
  // Cadence discriminator (see AssetInterfaceSample.cadence). "fast" = pinned
  // mountPath re-walk (monitoredStorage); "slow"/NULL = full scrape → 24h.
  cadence    String?

  @@id([id, timestamp])
  @@index([assetId, timestamp])
  @@index([assetId, mountPath, timestamp])
  @@map("asset_storage_samples")
}

// Per-pinned-program CPU/RAM time-series (Feature C). Only programs the operator
// pinned via Asset.monitoredProcesses are sampled (~1/min by the agent), so
// every row is effectively cadence="fast" (kept for the selection-aware
// retention machinery's uniformity). Hypertable; NO FK to Asset (cascade-bloat
// rule). cpuPct/memRssBytes are SUMMED across the program's instances at sample
// time (matches the inventory aggregation).
model AssetProcessSample {
  id            String   @default(uuid())
  assetId       String
  timestamp     DateTime @default(now())
  name          String
  cpuPct        Float?
  memRssBytes   BigInt?
  instanceCount Int?
  cadence       String?

  @@id([id, timestamp])
  @@index([assetId, timestamp])
  @@index([assetId, name, timestamp])
  @@map("asset_process_samples")
}

// Per-pinned-program log lines (Feature C). Standalone detail-only hypertable
// (like AssetCustomWidgetSample) — no rollups; pruned on the system-info
// umbrella window. NO FK to Asset. `source` records where the line came from
// (journald unit / file path). `level` is best-effort when the line parses.
model AssetProcessLogSample {
  id        String   @default(uuid())
  assetId   String
  timestamp DateTime @default(now())
  name      String
  level     String?
  message   String   @db.Text
  source    String?

  @@id([id, timestamp])
  @@index([assetId, timestamp])
  @@index([assetId, name, timestamp])
  @@map("asset_process_log_samples")
}

// Per-pinned-UNIT journalctl log lines (Phase 2, service dimension). The
// service-tab counterpart to AssetProcessLogSample: keyed by `unit` instead of
// program `name`. Standalone detail-only hypertable — no rollups; pruned on the
// system-info umbrella window (borrows the "process" retention entity's detail
// window). NO FK to Asset. Only units in Asset.monitoredServices are tailed
// (agent journalctl -u <unit>). Linux-only (journald); Windows service logs
// ride the existing Event Log stream.
model AssetServiceLogSample {
  id        String   @default(uuid())
  assetId   String
  timestamp DateTime @default(now())
  unit      String
  level     String?
  message   String   @db.Text
  source    String?

  @@id([id, timestamp])
  @@index([assetId, timestamp])
  @@index([assetId, unit, timestamp])
  @@map("asset_service_log_samples")
}

// ─── Sample rollups (tiered retention: hourly + daily aggregates) ───────────
//
// Per-source aggregate tables populated by the sampleRollup job (custom
// INSERT...ON CONFLICT). On Timescale-installed instances these become
// hypertables with the same compression policy as the source tables; on
// plain Postgres they stay as regular tables. The schema is uniform across
// both — see the plan at ~/.claude/plans/changed-to-plan-mode-velvet-elephant.md.
//
// Common conventions:
//   - Composite PK (id, bucketStart): id is a synthetic UUID for row identity;
//     bucketStart is the Timescale partitioning column.
//   - Composite UNIQUE on (bucketStart, assetId, [extraKey]): enforces one row
//     per asset (and extraKey when present) per time bucket, so the rollup
//     job's INSERT...ON CONFLICT (bucketStart, assetId[, extraKey]) DO UPDATE
//     works without duplicates.
//   - bucketStart timestamps are always UTC, aligned to the bucket boundary
//     via time_bucket('1 hour', timestamp) / time_bucket('1 day', ...).
//   - Gauge tables carry avg/min/max + sampleCount.
//   - Counter tables carry first/last endpoints of each cumulative counter
//     plus lastBucketSampleAt; rate is derived at query time as
//     (last - first) / (lastBucketSampleAt - bucketStart in seconds).
//     Negative deltas are dropped as counter resets (same convention as
//     the detail-tier client-side rate calc in the chart renderers).
//
// Phase 1 only — these tables exist but no reader or writer consumes them
// yet. The rollup job + tier-routing helper land in phases 2 and 4.

model AssetMonitorSampleHourly {
  id                     String   @default(uuid())
  assetId                String
  bucketStart            DateTime
  sampleCount            Int
  successCount           Int
  failureCount           Int
  // How many of `failureCount` were dependency-suppressed failures
  // (AssetMonitorSample.dependencyDown). A bucket whose failures were ALL
  // dependency ones is drawn grey; a mixed bucket keeps the red outage
  // treatment, because at least one failure was unexplained. Nullable — buckets
  // rolled up before this column existed carry NULL, read as 0.
  dependencyFailureCount Int?
  // Burst-sweep packet totals for the bucket, summed (not averaged) so a long
  // range's loss stays a true packets-lost/packets-sent ratio rather than a
  // mean of per-bucket percentages, which would weight a quiet bucket the same
  // as a busy one. NULL where the bucket held no sweep rows.
  packetsSent            Int?
  packetsReceived        Int?
  // avgResponseTimeMs is computed over successful samples only; null when
  // the bucket had zero successes. min/max likewise restricted to successes.
  avgResponseTimeMs      Float?
  minResponseTimeMs      Int?
  maxResponseTimeMs      Int?

  @@id([id, bucketStart])
  @@unique([bucketStart, assetId])
  @@index([assetId, bucketStart])
  @@map("asset_monitor_samples_hourly")
}

model AssetMonitorSampleDaily {
  id                     String   @default(uuid())
  assetId                String
  bucketStart            DateTime
  sampleCount            Int
  successCount           Int
  failureCount           Int
  // How many of `failureCount` were dependency-suppressed failures
  // (AssetMonitorSample.dependencyDown). A bucket whose failures were ALL
  // dependency ones is drawn grey; a mixed bucket keeps the red outage
  // treatment, because at least one failure was unexplained. Nullable — buckets
  // rolled up before this column existed carry NULL, read as 0.
  dependencyFailureCount Int?
  // Burst-sweep packet totals for the bucket, summed (not averaged) so a long
  // range's loss stays a true packets-lost/packets-sent ratio rather than a
  // mean of per-bucket percentages, which would weight a quiet bucket the same
  // as a busy one. NULL where the bucket held no sweep rows.
  packetsSent            Int?
  packetsReceived        Int?
  avgResponseTimeMs      Float?
  minResponseTimeMs      Int?
  maxResponseTimeMs      Int?

  @@id([id, bucketStart])
  @@unique([bucketStart, assetId])
  @@index([assetId, bucketStart])
  @@map("asset_monitor_samples_daily")
}

model AssetTelemetrySampleHourly {
  id                String   @default(uuid())
  assetId           String
  bucketStart       DateTime
  sampleCount       Int
  avgCpuPct         Float?
  minCpuPct         Float?
  maxCpuPct         Float?
  avgMemPct         Float?
  minMemPct         Float?
  maxMemPct         Float?
  avgMemUsedBytes   BigInt?
  maxMemUsedBytes   BigInt?
  // last-seen total (memory size is effectively a constant per host;
  // tracking last value rather than avg keeps the chart axis stable).
  lastMemTotalBytes BigInt?
  avgSessionCount   Float?
  minSessionCount   Float?
  maxSessionCount   Float?

  @@id([id, bucketStart])
  @@unique([bucketStart, assetId])
  @@index([assetId, bucketStart])
  @@map("asset_telemetry_samples_hourly")
}

model AssetTelemetrySampleDaily {
  id                String   @default(uuid())
