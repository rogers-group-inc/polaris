node_modules/
dist/

# Prisma 7 generated client (regenerated by `postinstall: prisma generate`)
src/generated/

# Environment files with real credentials — never commit these
.env

# Build artifacts
*.js.map

# Database backups
data/backups/

# First-run setup marker — written per-host after setup finalizes
.setup-complete

# Per-developer Claude Code settings (permissions, hook config) and scratch worktrees are
# local; the project SKILLS under .claude/skills/ are tracked project memory and must NOT be
# ignored (git cannot re-include a child of an excluded directory, hence the `/*` + `!` pair).
.claude/*
!.claude/skills/

# Session-workflow lock files (a worktree in use / a dev stack running) — never committed
WORKLOCK
DEVLOCK

# Windows Explorer / OneDrive folder metadata
desktop.ini

# Audit output folder
Audit/

# Audit report output. These are generated, self-contained HTML review
# artifacts — not app code and not shipped. They were being scanned as source
# (4 of the 2026-08-12 CodeQL alerts came from production-readiness.html's
# report renderer), so they are untracked rather than maintained.
audit-reports/
production-readiness.html

# Runtime update-progress state written by the in-app updater (survives restarts
# so the Application Updates card can resume its progress view). Not source.
.update-status.json

# Docker-stack persistent state (POLARIS_STATE_DIR=/app/state in
# docker-compose.yml): holds .env — which carries DATABASE_URL, SESSION_SECRET
# and POLARIS_SECRET_KEY — plus the nginx cert/key, uploaded branding, and
# database backups. Nothing under here is ever source, and committing it would
# publish secrets.
state/

# Temp files the automation-script runner writes before execFile'ing them
# (0600, unlinked after the run; a killed run can leave one behind).
data/automation-scripts-tmp/

# Local audit / review output — never commit (embeds local paths + findings)
findings.json

# Claude Design upload payload — regenerated by `node .design-sync/build.mjs`
# from design/ plus the durable sources in .design-sync/. Never source.
ds-bundle/
.design-sync/.cache/
