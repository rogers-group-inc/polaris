{
  "path": ["src", "public/js", "scripts", "prisma"],
  "format": ["typescript", "javascript"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "src/generated/**",
    "public/js/vendor/**",
    "tests/**",
    "**/*.d.ts"
  ],
  "minTokens": 70,
  "minLines": 8,
  "maxLines": 60000,
  "maxSize": "3mb",
  "mode": "mild",
  "gitignore": true,
  "absolute": false,
  "reporters": ["console", "json"],
  "output": "./audit-reports/jscpd"
}
