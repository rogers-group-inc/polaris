{
  "name": "polaris",
  "version": "0.9.0",
  "description": "Polaris — subnet & IP address management, the fixed reference point for your network",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate && (git config core.hooksPath .githooks || true)",
    "dev": "node --env-file=.env --import tsx/esm --watch src/index.ts",
    "build": "tsc && node scripts/copy-build-assets.mjs",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file=.env --import tsx/esm prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "mock:compare": "node --env-file=.env --import tsx/esm prisma/mock-compare.ts",
    "mock:notifications": "node --env-file=.env --import tsx/esm prisma/mock-notifications.ts",
    "test:fmg": "node scripts/test-fmg.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "audit:deps": "npm outdated || true && npm audit --audit-level=high || true && node -e \"console.log('\\nTriage: .claude/skills/polaris-tech-lifecycle/references/dependency-audit.md')\""
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/ws": "^8.18.1",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.0.0",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "ldapts": "^8.1.7",
    "multer": "^2.2.0",
    "net-snmp": "^3.26.3",
    "netmask": "^2.0.2",
    "nodemailer": "^9.0.1",
    "openid-client": "^6.1.7",
    "otpauth": "^9.5.0",
    "pg": "^8.20.0",
    "pg-boss": "^12.18.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "ssh2": "^1.17.0",
    "undici": "^6.28.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.1.0",
    "@types/net-snmp": "^3.23.0",
    "@types/netmask": "^2.0.6",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/ssh2": "^1.15.5",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^5.0.0",
    "cytoscape": "^3.30.2",
    "cytoscape-dagre": "^2.5.0",
    "dagre": "^0.8.5",
    "eslint": "^9.39.4",
    "happy-dom": "^20.14.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "tsx": "^4.15.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@hono/node-server": "^1.19.14",
    "qs": "^6.16.0",
    "fflate": "^0.8.3",
    "@xmldom/xmldom": "^0.8.15",
    "fast-uri": "^3.1.7"
  }
}
